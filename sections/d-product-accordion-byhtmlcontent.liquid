<section class="sk-product-accordion skpt-lg skpb-lg bg-white">
  <div class="container">
    {% comment %} --- Section Heading --- {% endcomment %}
    <div class="text-center skmb-md">
      <h2 class="fs-h2 skfwb text-blue">{{ section.settings.title }}</h2>
    </div>

    <div class="accordionWrapper">
      {%- for block in section.blocks -%}
        <div class="accordionItem {% if forloop.first and section.settings.open_first %}open{% else %}close{% endif %} skmb-15" {{ block.shopify_attributes }}>
          
          {% comment %} --- Accordion Header --- {% endcomment %}
          <div class="accordionItemHeading d-flex justify-content-between align-items-center bg-white" 
               style="border-top: 1px solid #ddd; border-bottom: 1px solid #ddd; padding: 20px 0; background: transparent !important; color: inherit !important;">
            
            <div class="d-flex align-items-center">
              {%- if block.settings.icon != blank -%}
                <div class="skmr-15 text-black">
                  {{ block.settings.icon }}
                </div>
              {%- endif -%}
              <h3 class="fs-h6 skfwb text-black skm-0" style="text-transform: uppercase; letter-spacing: 1px;">
                {{ block.settings.heading }}
              </h3>
            </div>

            {% comment %} Custom Cross/Plus Icon from skcssl.css logic {% endcomment %}
            <div id="cross"></div>
          </div>

          {% comment %} --- Accordion Body (HTML Content) --- {% endcomment %}
          <div class="accordionItemContent skp-0">
            <div class="skpt-md skpb-md fs-16 sklh-h text-black">
              {{ block.settings.content }}
            </div>
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const accordionItems = document.querySelectorAll('.accordionItemHeading');
    
    accordionItems.forEach(item => {
      item.addEventListener('click', function() {
        const parent = this.parentElement;
        const isOpen = parent.classList.contains('open');
        
        // Close all other items if needed
        // document.querySelectorAll('.accordionItem').forEach(el => el.classList.replace('open', 'close'));

        if (isOpen) {
          parent.classList.replace('open', 'close');
        } else {
          parent.classList.replace('close', 'open');
        }
      });
    });
  });
</script>

<style>
  /* Overriding some default skcssl.css accordion styles to match the provided image exactly */
  .accordionItemHeading { border-radius: 0 !important; transition: var(--transition); }
  .accordionItem.open .accordionItemHeading { border-bottom: none !important; }
  .accordionItemContent { overflow: hidden; transition: var(--transition); border: none !important; }
  
  /* Styling for the HTML content inside (lists) */
  .accordionItemContent ul { list-style: none; padding-left: 0; margin: 0; }
  .accordionItemContent li { position: relative; padding-left: 15px; margin-bottom: 8px; font-size: 14px; color: #444; }
  .accordionItemContent li::before { content: "•"; position: absolute; left: 0; color: var(--gray-color); }
  .accordionItemContent h4 { font-size: 16px; font-weight: 700; margin-top: 25px; margin-bottom: 15px; color: #000; text-transform: uppercase; }
  .accordionItemContent a { color: var(--gray-color); text-decoration: underline; transition: var(--transition); }
  .accordionItemContent a:hover { color: var(--blue-color); }
</style>

{% schema %}
{
  "name": "d-product-accordion-byhtmlcontent",
  "class": "d-product-accordion-byhtmlcontent",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Section Heading",
      "default": "Product Specifications"
    },
    {
      "type": "checkbox",
      "id": "open_first",
      "label": "Open first item by default",
      "default": false
    }
  ],
  "blocks": [
    {
      "type": "accordion_item",
      "name": "Accordion Item",
      "settings": [
        {
          "type": "html",
          "id": "icon",
          "label": "SVG Icon (Optional)",
          "info": "Paste SVG code here"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "RESOURCES"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "HTML Content",
          "default": "<p>User Manual PDF Download</p><h4>WHAT'S IN THE BOX:</h4><ul><li>NA-C50 Housing</li><li>O-ring remover</li></ul>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "d-product-accordion-byhtmlcontent",
      "blocks": [
        { "type": "accordion_item", "settings": { "heading": "INTRODUCING NA-C50" } },
        { "type": "accordion_item", "settings": { "heading": "RESOURCES" } }
      ]
    }
  ]
}
{% endschema %}