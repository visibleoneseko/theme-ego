<style>
  /* Localized section styles to ensure layout integrity */
  .sk-news-detail__image-wrapper {
    width: 100%;
    overflow: hidden;
  }
  .sk-news-detail__image {
    width: 100%;
    height: auto;
    display: block;
    object-fit: cover;
  }
  .sk-share-btn {
    background-color: var(--black-color);
    color: var(--white-color);
    border: none;
    border-radius: 50px;
    padding: 12px 24px;
    cursor: pointer;
    font-family: var(--mainfont);
    display: inline-flex;
    align-items: center;
    gap: 10px;
    transition: var(--transition);
  }
  .sk-share-btn:hover {
    background-color: var(--red-color);
  }
  .article-content-wrapper img {
    max-width: 100%;
    height: auto;
  }
.article-content-wrapper {
        max-width: 1024px;
        margin: auto;
    }
.sk-news-detail__image-wrapper{position: relative;}
.sk-news-detail__image-wrapper .title{
    position: absolute;
    bottom: 56px;
    left: 50%;
    transform: translateX(-50%);
    margin: 0px;
}
</style>

<section class="sk-news-detail">
  <div class="main">
    <div class="d-grid gap-30">
      
      {%- if article.image -%}
        <div class="col-12">
          <div class="sk-news-detail__image-wrapper skbanner">
            <img 
              src="{{ article.image | image_url: width: 1500 }}" 
              alt="{{ article.image.alt | escape }}" 
              class="sk-news-detail__image"
              loading="lazy"
              width="{{ article.image.width }}"
              height="{{ article.image.height }}"
            >
            <h1 class="fs-h2 skfwb text-white skmb-xs title">{{ article.title }}</h1>
          </div>
        </div>
      {%- endif -%}

      <div class="col-12 skmt-xs">        
        {%- if section.settings.show_author or section.settings.show_date -%}
          <div class="fs-14 text-gray skmb-md introbox d-none">
            {%- if section.settings.show_author -%}                
              <span>By {{ article.author }}</span>
            {%- endif -%}
            {%- if section.settings.show_author and section.settings.show_date -%} | {% endif -%}
            {%- if section.settings.show_date -%}
              <span>{{ article.published_at | time_tag: format: 'date' }}</span>
            {%- endif -%}
          </div>
        {%- endif -%}

        <div class="article-content-wrapper fs-16 sklh-h text-black skfwn">
          {{ article.content }}
        </div>
      </div>

      {%- if section.settings.enable_share -%}
        <div class="col-12 text-center skmt-md">
          <button class="sk-share-btn fs-14 skfwb" onclick="SK_ShareArticle()">
            <span>{{ section.settings.share_label | uppercase }}</span>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8"></path>
              <polyline points="16 6 12 2 8 6"></polyline>
              <line x1="12" y1="2" x2="12" y2="15"></line>
            </svg>
          </button>
        </div>
      {%- endif -%}

    </div>
  </div>
</section>

<script>
  function SK_ShareArticle() {
    if (navigator.share) {
      navigator.share({
        title: {{ article.title | json }},
        url: '{{ shop.url }}{{ article.url }}'
      }).catch(console.error);
    } else {
      const el = document.createElement('textarea');
      el.value = '{{ shop.url }}{{ article.url }}';
      document.body.appendChild(el);
      el.select();
      document.execCommand('copy');
      document.body.removeChild(el);
      alert('Article link copied to clipboard!');
    }
  }
</script>

{% schema %}
{
  "name": "d-news-details",
  "tag": "section",
  "class": "d-news-details",
  "settings": [
    {
      "type": "header",
      "content": "Display Settings"
    },
    {
      "type": "checkbox",
      "id": "show_author",
      "label": "Show Author",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_date",
      "label": "Show Published Date",
      "default": true
    },
    {
      "type": "header",
      "content": "Share Settings"
    },
    {
      "type": "checkbox",
      "id": "enable_share",
      "label": "Enable Native Share Button",
      "default": true
    },
    {
      "type": "text",
      "id": "share_label",
      "label": "Share Button Label",
      "default": "Share this post"
    }
  ],
  "presets": [
    {
      "name": "d-news-details"
    }
  ]
}
{% endschema %}