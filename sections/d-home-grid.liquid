{%- style -%}
  .d-home-grid-container {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    grid-template-rows: repeat(2, 1fr);
    gap: 20px;
  }

  .d-home-grid-item {
    position: relative;
    background-color: var(--smoke-color);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    padding: 0px;
    text-decoration: none;
    transition: var(--transition);
  }

  .d-home-grid-item:hover figure.hover01 {
    transform: scale(1.05);
  }

  .d-home-grid-item.center-feature {
    grid-column: 2 / 4;
    grid-row: 1 / 3;
    justify-content: flex-start;
    align-items: center;
    padding-top: 0px;
  }

  .d-home-grid-item.center-feature > .text-wrapper{ padding-top: 60px;}

  .d-home-grid-item img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    transition: var(--transition);
  }

  .d-home-grid-item.center-feature img {
    object-fit: cover;
    position: absolute;
    top: 0;
    left: 0;
    z-index: 1;
  }

  .d-home-grid-item .text-wrapper {
    position: absolute;
    z-index: 2;
    display: flex;
    align-items: center;
    gap: 10px;
    padding:30px;
  }
  .d-home-grid-item .text-wrapper h3{margin:0px;}

  /* Mobile Responsiveness */
  @media (max-width: 991px) {
    .d-home-grid-container {
      display: flex;
      flex-direction: column;
      gap: 15px;
    }
    .d-home-grid-item {
      height: 250px;
    }
  }
{%- endstyle -%}

<section class="d-home-grid-section skpt-lg skpb-lg">
  <div class="container-base container">
    <div class="d-home-grid-container">
      {%- for block in section.blocks -%}
        {%- liquid
          assign is_center = false
          if block.settings.full_height
            assign is_center = true
          endif
        -%}
        
        <a href="{{ block.settings.link }}" class="d-home-grid-item {% if is_center %}center-feature{% endif %}" {{ block.shopify_attributes }}>
          
          <div class="text-wrapper">
            <h3 class="fs-h5 skfwb text-black">{{ block.settings.title }}</h3>
            <span class="fs-h5 text-black">→</span>
          </div>

          <figure class="hover01 h-100 flex-center">
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 1200 | image_tag: 
                loading: 'lazy', 
                class: 'w-100',
                alt: block.settings.image.alt | escape 
              }}
            {%- else -%}
              {{ 'image' | placeholder_svg_tag: 'placeholder-svg w-100 h-100' }}
            {%- endif -%}
          </figure>

        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "d-home-grid",
  "tag": "section",
  "class": "d-home-grid",
  "max_blocks": 5,
  "settings": [
    {
      "type": "header",
      "content": "Section Spacing"
    },
    {
      "type": "paragraph",
      "content": "Spacing is controlled by skcssl.css variables."
    }
  ],
  "blocks": [
    {
      "type": "grid_item",
      "name": "Grid Block",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Block Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Category Name"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "checkbox",
          "id": "full_height",
          "label": "Large Feature Block?",
          "info": "Tick this for the center diving image.",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "d-home-grid",
      "blocks": [
        { "type": "grid_item", "settings": { "title": "Lens" } },
        { "type": "grid_item", "settings": { "title": "Camera Housing", "full_height": true } },
        { "type": "grid_item", "settings": { "title": "Video and Monitor housing" } },
        { "type": "grid_item", "settings": { "title": "Essentials" } },
        { "type": "grid_item", "settings": { "title": "Complete Kits" } }
      ]
    }
  ]
}
{% endschema %}