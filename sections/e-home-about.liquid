{%- comment -%}
  e-home-about — "Four Decades" intro + animated stats (Roctec homepage)
  Stats are blocks: counter (38+), pair (24/7) or text (ISO).
{%- endcomment -%}
<style>
#e-home-about {
  background: var(--color-surface-brand);
  color: var(--color-text-inverse);
}
#e-home-about .about-stacked {
  display: flex;
  flex-direction: column;
  gap: var(--space-16);
}
#e-home-about .about-top {
  display: grid;
  grid-template-columns: 1.1fr 1fr;
  gap: var(--space-16);
  align-items: start;
}
#e-home-about .about-header h2 {
  font-size: var(--text-h2);
  line-height: 1.15;
  letter-spacing: -0.02em;
}
#e-home-about .about-body {
  display: flex;
  flex-direction: column;
  gap: var(--space-8);
}
#e-home-about .about-body p {
  color: var(--color-text-inverse-muted);
  font-size: var(--text-base);
  line-height: 1.6;
}
#e-home-about .about-stats-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: var(--space-8);
  padding-top: var(--space-12);
  border-top: 1px solid rgba(255, 255, 255, 0.5);
}
#e-home-about .about-stat-card {
  padding: 0;
}
#e-home-about .about-stat-card h3 {
  font-size: var(--text-h2);
  font-weight: 700;
  line-height: 1;
  color: var(--color-text-inverse);
  margin-bottom: var(--space-3);
  font-variant-numeric: tabular-nums;
}
#e-home-about .about-stat-card p {
  font-size: var(--text-sm);
  color: var(--color-text-inverse-muted);
}
#e-home-about .about-cta .btn-secondary {
  background: #FFFFFF;
  color: var(--color-text);
  border-color: #FFFFFF;
}
#e-home-about .about-cta .btn-secondary:hover {
  color: #fff;
  border-color: var(--color-primary);
}
@media (max-width: 1024px) {
  #e-home-about .about-stacked {
    padding-inline: var(--space-6);
  }
  #e-home-about .about-top {
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-8);
  }
  #e-home-about .about-stats-grid {
    grid-template-columns: repeat(2, 1fr);
  }
}
@media (max-width: 767px) {
  #e-home-about .about-stacked {
    padding-inline: var(--space-6);
    gap: var(--space-10, 40px);
  }
  #e-home-about .about-top {
    gap: var(--space-6);
  }
  #e-home-about .about-stats-grid {
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-7, 28px) var(--space-5, 20px);
  }
  #e-home-about .about-header h2 {
    line-height: 1.15;
  }
}
@media (max-width: 400px) {
  #e-home-about .about-stacked {
    padding-inline: var(--space-5);
  }
}
</style>

<section
  id="e-home-about"
  class="e-home-about about skpt-{{ section.settings.padding_top }} skpb-{{ section.settings.padding_bottom }}"
>
  <div class="container about-stacked" data-sk-reveal>
    <div class="about-top">
      <div class="about-header">
        {%- if section.settings.heading != blank -%}
          <h2>{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
      </div>
      <div class="about-body">
        {{ section.settings.text }}
        {%- if section.settings.button_label != blank -%}
          <div class="about-cta">
            <a class="btn btn-secondary" href="{{ section.settings.button_link | default: '#' }}">{{ section.settings.button_label | escape }}</a>
          </div>
        {%- endif -%}
      </div>
    </div>

    {%- if section.blocks.size > 0 -%}
      <div class="about-stats-grid">
        {%- for block in section.blocks -%}
          <div class="about-stat-card" {{ block.shopify_attributes }}>
            {%- case block.type -%}
              {%- when 'stat_counter' -%}
                {%- assign num = block.settings.number | default: 0 -%}
                <h3 data-count="{{ num }}" data-suffix="{{ block.settings.suffix | escape }}">{{ num }}{{ block.settings.suffix | escape }}</h3>
              {%- when 'stat_pair' -%}
                {%- assign num_1 = block.settings.number_1 | default: 0 -%}
                {%- assign num_2 = block.settings.number_2 | default: 0 -%}
                <h3><span data-count="{{ num_1 }}">{{ num_1 }}</span>{{ block.settings.separator | escape }}<span data-count="{{ num_2 }}">{{ num_2 }}</span></h3>
              {%- when 'stat_text' -%}
                <h3 data-count-text="{{ block.settings.text | escape }}">{{ block.settings.text | upcase | escape }}</h3>
            {%- endcase -%}
            {%- if block.settings.label != blank -%}
              <p>{{ block.settings.label | escape }}</p>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

<script>
(function () {
  'use strict';

  if (!window.eHomeAbout) {
    window.eHomeAbout = (function () {
      var instances = {};
      var reducedMotion = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      var COUNT_DURATION = 1800;
      var easeOutCubic = function (p) { return 1 - Math.pow(1 - p, 3); };

      function render(el, eased) {
        if (el.hasAttribute('data-count-text')) {
          el.textContent = (el.getAttribute('data-count-text') || '').toUpperCase();
          return;
        }
        var num = parseFloat(el.getAttribute('data-count')) || 0;
        var suffix = el.getAttribute('data-suffix') || '';
        var dp = parseInt(el.getAttribute('data-decimals'), 10) || 0;
        el.textContent = (num * eased).toFixed(dp) + suffix;
      }

      function create(root) {
        var grid = root.querySelector('.about-stats-grid');
        var counters = grid ? [].slice.call(grid.querySelectorAll('[data-count], [data-count-text]')) : [];
        var raf = null;
        var obs = null;
        var designMode = window.Shopify && window.Shopify.designMode;

        function settle() { counters.forEach(function (el) { render(el, 1); }); }

        /* All counters in the grid run on one shared timeline */
        function run() {
          if (reducedMotion) { settle(); return; }
          var start = null;
          var step = function (ts) {
            if (start === null) start = ts;
            var p = Math.min((ts - start) / COUNT_DURATION, 1);
            var eased = easeOutCubic(p);
            counters.forEach(function (el) { render(el, eased); });
            if (p < 1) raf = requestAnimationFrame(step);
            else settle();
          };
          raf = requestAnimationFrame(step);
        }

        if (counters.length) {
          if (reducedMotion || designMode || !('IntersectionObserver' in window)) {
            settle();
          } else {
            counters.forEach(function (el) { render(el, 0); }); /* start state */
            obs = new IntersectionObserver(function (entries) {
              entries.forEach(function (entry) {
                if (!entry.isIntersecting) return;
                run();
                obs.disconnect();
                obs = null;
              });
            }, { threshold: 0.4 });
            obs.observe(grid);
          }
        }

        return {
          destroy: function () {
            if (obs) { obs.disconnect(); obs = null; }
            if (raf) cancelAnimationFrame(raf);
            root.removeAttribute('data-e-init');
          }
        };
      }

      function mount(sectionId) {
        var wrap = document.getElementById('shopify-section-' + sectionId);
        var root = wrap ? wrap.querySelector('.e-home-about') : null;
        if (!root || root.hasAttribute('data-e-init')) return;
        root.setAttribute('data-e-init', '');
        instances[sectionId] = create(root);
      }

      function unmount(sectionId) {
        if (instances[sectionId]) { instances[sectionId].destroy(); delete instances[sectionId]; }
      }

      document.addEventListener('shopify:section:load', function (e) { mount(e.detail.sectionId); });
      document.addEventListener('shopify:section:unload', function (e) { unmount(e.detail.sectionId); });

      return { mount: mount, unmount: unmount };
    })();
  }

  window.eHomeAbout.mount('{{ section.id }}');
})();
</script>

{% schema %}
{
  "name": "Home – About & Stats",
  "settings": [
    {
      "type": "select",
      "id": "padding_top",
      "label": "Padding Top",
      "options": [
        { "value": "0", "label": "0" },
        { "value": "xs", "label": "xs" },
        { "value": "sm", "label": "sm" },
        { "value": "md", "label": "md" },
        { "value": "lg", "label": "lg" },
        { "value": "xl", "label": "xl" }
      ],
      "default": "lg"
    },
    {
      "type": "select",
      "id": "padding_bottom",
      "label": "Padding Bottom",
      "options": [
        { "value": "0", "label": "0" },
        { "value": "xs", "label": "xs" },
        { "value": "sm", "label": "sm" },
        { "value": "md", "label": "md" },
        { "value": "lg", "label": "lg" },
        { "value": "xl", "label": "xl" }
      ],
      "default": "lg"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Four Decades of Engineering Excellence"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Founded in 1987, Roctec Technology Limited (鷹達科技有限公司) is a well-established system integrator and solution developer experienced in large-scale data communications, multimedia display and network integration projects across Hong Kong, Thailand, Singapore and other Asian countries.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Our Full Story"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    }
  ],
  "blocks": [
    {
      "type": "stat_counter",
      "name": "Stat – counter",
      "settings": [
        { "type": "number", "id": "number", "label": "Number", "default": 38 },
        { "type": "text", "id": "suffix", "label": "Suffix", "default": "+" },
        { "type": "text", "id": "label", "label": "Label", "default": "Years of Project Heritage" }
      ]
    },
    {
      "type": "stat_pair",
      "name": "Stat – pair (e.g. 24/7)",
      "settings": [
        { "type": "number", "id": "number_1", "label": "First number", "default": 24 },
        { "type": "text", "id": "separator", "label": "Separator", "default": "/" },
        { "type": "number", "id": "number_2", "label": "Second number", "default": 7 },
        { "type": "text", "id": "label", "label": "Label", "default": "Operations Support" }
      ]
    },
    {
      "type": "stat_text",
      "name": "Stat – text",
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "ISO" },
        { "type": "text", "id": "label", "label": "Label", "default": "Quality Aligned" }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Home – About & Stats",
      "blocks": [
        { "type": "stat_counter", "settings": { "number": 38, "suffix": "+", "label": "Years of Project Heritage" } },
        { "type": "stat_counter", "settings": { "number": 120, "suffix": "+", "label": "Infrastructure Projects" } },
        { "type": "stat_pair", "settings": { "number_1": 24, "separator": "/", "number_2": 7, "label": "Operations Support" } },
        { "type": "stat_text", "settings": { "text": "ISO", "label": "Quality Aligned" } }
      ]
    }
  ]
}
{% endschema %}
