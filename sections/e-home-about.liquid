<script>
(function() {
  var E_HOME_SECTION_ID = 'e-home-about';
  var E_HOME_SECTION_SELECTOR = '#' + E_HOME_SECTION_ID;
  function initEHomeAbout() {
    var root = document.querySelector(E_HOME_SECTION_SELECTOR + '[data-section-id="{{ section.id }}"]');
    if (!root || root.dataset.initialized === 'true') return;
    root.dataset.initialized = 'true';

    var counters = root.querySelectorAll('[data-count]');
    if (!counters.length) return;
    var reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    function runCounter(el) {
      var target = Number(el.dataset.count);
      if (!Number.isFinite(target)) return;
      if (reduced) { el.textContent = String(target) + (el.dataset.suffix || ''); return; }
      var start = 0, duration = 1300, started = null;
      function frame(ts) {
        if (!started) started = ts;
        var p = Math.min((ts-started)/duration,1);
        var eased = 1-Math.pow(1-p,3);
        el.textContent = String(Math.round(start+(target-start)*eased))+(el.dataset.suffix||'');
        if (p<1) window.requestAnimationFrame(frame);
      }
      window.requestAnimationFrame(frame);
    }
    var observer = new IntersectionObserver(function(entries) {
      entries.forEach(function(entry) {
        if(entry.isIntersecting) {
          counters.forEach(runCounter);
          observer.disconnect();
        }
      });
    }, {threshold:0.25});
    observer.observe(root);
    root.__eHomeCleanup = function(){observer.disconnect();};


    var revealTargets = root.querySelectorAll('.about-top, .about-stat-card, .news-head-row, .news-featured-card, .news-side-card, .solutions-head-row, .sol-tile, .rsvc-intro, .rsvc-carousel, .trust-ticker-header, .trust-ticker-logo');
    if ('IntersectionObserver' in window && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      var revealObserver = new IntersectionObserver(function(entries) {
        entries.forEach(function(entry) {
          if (entry.isIntersecting) { entry.target.classList.add('is-shown'); revealObserver.unobserve(entry.target); }
        });
      }, {threshold:0.12});
      revealTargets.forEach(function(el){el.classList.add('reveal-up');revealObserver.observe(el);});
      var oldCleanup = root.__eHomeCleanup;
      root.__eHomeCleanup = function(){revealObserver.disconnect();if(oldCleanup)oldCleanup();};
    } else {
      revealTargets.forEach(function(el){el.classList.add('is-shown');});
    }

  }
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initEHomeAbout, { once: true });
  } else {
    initEHomeAbout();
  }
  document.addEventListener('shopify:section:load', function(event) {
    if (event.target && event.target.querySelector && event.target.querySelector(E_HOME_SECTION_SELECTOR)) {
      var el = event.target.querySelector(E_HOME_SECTION_SELECTOR);
      if (el) el.dataset.initialized = 'false';
      initEHomeAbout();
    }
  });
  document.addEventListener('shopify:section:unload', function(event) {
    if (event.target && event.target.querySelector) {
      var el = event.target.querySelector(E_HOME_SECTION_SELECTOR);
      if (el) {
        el.dataset.initialized = 'false';
        if (el.__eHomeCleanup) el.__eHomeCleanup();
      }
    }
  });
})();
</script>

