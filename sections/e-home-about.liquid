{%- comment -%}
  Roctec homepage — About section
  Source: Claude standalone homepage export.
  CSS and JS are isolated to #e-home-about.
{%- endcomment -%}
<section id="e-home-about" class="about skpt-{{ section.settings.padding_top }} skpb-{{ section.settings.padding_bottom }}" data-section-id="{{ section.id }}">

  <div class="container about-stacked">
    <div class="about-top">
      <div class="about-header"><h2>{{ section.settings.heading | escape }}</h2></div>
      <div class="about-body">
        <p>{{ section.settings.description }}</p>
        {% if section.settings.button_label != blank %}
          <div class="about-cta"><a class="btn btn-secondary" href="{{ section.settings.button_link | default: routes.root_url }}">{{ section.settings.button_label | escape }}</a></div>
        {% endif %}
      </div>
    </div>
    <div class="about-stats-grid">
      {% for block in section.blocks %}
        <div class="about-stat-card" {{ block.shopify_attributes }}>
          <h3>{% if block.settings.prefix != blank %}{{ block.settings.prefix | escape }}{% endif %}<span data-count="{{ block.settings.value | escape }}" data-suffix="{{ block.settings.suffix | escape }}">{{ block.settings.value | escape }}</span></h3>
          <p>{{ block.settings.label | escape }}</p>
        </div>
      {% endfor %}
    </div>
  </div>

</section>

