{%- comment -%}
  Roctec homepage — Services section
  Source: Claude standalone homepage export.
  CSS and JS are isolated to #e-home-services.
{%- endcomment -%}
<section id="e-home-services" class="rsvc skpt-{{ section.settings.padding_top }} skpb-{{ section.settings.padding_bottom }}" data-section-id="{{ section.id }}">

  <div class="rsvc-inner">
    <div class="rsvc-layout">
      <div class="rsvc-intro">
        <span class="rsvc-eyebrow">{{ section.settings.eyebrow | escape }}</span>
        <h2>{{ section.settings.heading | escape }}</h2>
        <p>{{ section.settings.subheading | escape }}</p>
        {% if section.settings.button_label != blank %}<a class="btn btn-secondary rsvc-cta" href="{{ section.settings.button_link | default: routes.root_url }}">{{ section.settings.button_label | escape }}</a>{% endif %}
      </div>
      <div class="rsvc-carousel" data-service-carousel>
        <div class="rsvc-viewport">
          <div class="rsvc-track">
            {% for block in section.blocks %}
              <article class="rsvc-slide" {{ block.shopify_attributes }}>
                <div class="rsvc-media">
                  {% if block.settings.image != blank %}
                    {{ block.settings.image | image_url: width: 1000 | image_tag: loading: 'lazy', alt: block.settings.image_alt, widths: '360, 540, 720, 1000' }}
                  {% else %}
                    <img src="{{ block.settings.fallback_asset | asset_url }}" alt="{{ block.settings.image_alt | escape }}" loading="lazy">
                  {% endif %}
                </div>
                <div class="rsvc-body">
                  <h3>{{ block.settings.title | escape }}</h3>
                  <p>{{ block.settings.description | escape }}</p>
                </div>
              </article>
            {% endfor %}
          </div>
        </div>
        <div class="rsvc-controls">
          <span class="rsvc-count"><span class="rsvc-count-current" data-service-current>01</span> / <span data-service-total>{{ section.blocks.size | prepend: '0' | slice: -2, 2 }}</span></span>
          <div class="rsvc-progress"><span class="rsvc-progress-bar" data-service-progress></span></div>
          <div class="rsvc-nav">
            <button class="rsvc-btn rsvc-prev" type="button" aria-label="Previous service"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 18l-6-6 6-6"/></svg></button>
            <button class="rsvc-btn rsvc-next" type="button" aria-label="Next service"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 18l6-6-6-6"/></svg></button>
          </div>
        </div>
      </div>
    </div>
  </div>

</section>

<style>
