  inset: 0;
  z-index: -1;
  background: currentColor;
  transform: scaleX(0);
  transform-origin: left center;
  transition: transform 300ms ease-out;
}

#e-home-services .btn:hover::before {
transform: scaleX(1);
}

#e-home-services .btn:hover {
color: inherit;
}

#e-home-services .btn:active::before {
transition-duration: 80ms;
}

@media (prefers-reduced-motion: reduce) {
