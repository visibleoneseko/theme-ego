<script>
(function() {
  var E_HOME_SECTION_ID = 'e-home-services';
  var E_HOME_SECTION_SELECTOR = '#' + E_HOME_SECTION_ID;
  function initEHomeServices() {
    var root = document.querySelector(E_HOME_SECTION_SELECTOR + '[data-section-id="{{ section.id }}"]');
    if (!root || root.dataset.initialized === 'true') return;
    root.dataset.initialized = 'true';

    var carousel = root.querySelector('[data-service-carousel]');
    var track = root.querySelector('.rsvc-track');
    var cards = Array.prototype.slice.call(root.querySelectorAll('.rsvc-slide'));
    var prev = root.querySelector('.rsvc-prev'), next = root.querySelector('.rsvc-next');
    var currentLabel = root.querySelector('[data-service-current]');
    var totalLabel = root.querySelector('[data-service-total]');
    var progress = root.querySelector('[data-service-progress]');
    var index = 0;
    if (!carousel || !track || !cards.length) return;
    if (totalLabel) totalLabel.textContent = String(cards.length).padStart(2,'0');
    function update() {
      var max = Math.max(0, cards.length - 1);
      index = Math.max(0, Math.min(index, max));
      var step = cards[index].offsetLeft - cards[0].offsetLeft;
      track.style.transform = 'translate3d(' + (-step) + 'px,0,0)';
      if (currentLabel) currentLabel.textContent = String(index+1).padStart(2,'0');
      if (progress) progress.style.width = ((index+1)/cards.length*100)+'%';
      if (prev) prev.disabled = index===0;
      if (next) next.disabled = index===max;
    }
    function onPrev(){index--;update();}
    function onNext(){index++;update();}
    if(prev) prev.addEventListener('click',onPrev);
    if(next) next.addEventListener('click',onNext);
    var resizeObserver = new ResizeObserver(update);
    resizeObserver.observe(carousel);
    root.__eHomeCleanup = function(){resizeObserver.disconnect();};
    update();


    var revealTargets = root.querySelectorAll('.about-top, .about-stat-card, .news-head-row, .news-featured-card, .news-side-card, .solutions-head-row, .sol-tile, .rsvc-intro, .rsvc-carousel, .trust-ticker-header, .trust-ticker-logo');
    if ('IntersectionObserver' in window && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      var revealObserver = new IntersectionObserver(function(entries) {
        entries.forEach(function(entry) {
          if (entry.isIntersecting) { entry.target.classList.add('is-shown'); revealObserver.unobserve(entry.target); }
        });
      }, {threshold:0.12});
      revealTargets.forEach(function(el){el.classList.add('reveal-up');revealObserver.observe(el);});
      var oldCleanup = root.__eHomeCleanup;
      root.__eHomeCleanup = function(){revealObserver.disconnect();if(oldCleanup)oldCleanup();};
    } else {
      revealTargets.forEach(function(el){el.classList.add('is-shown');});
    }

  }
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initEHomeServices, { once: true });
  } else {
    initEHomeServices();
  }
  document.addEventListener('shopify:section:load', function(event) {
    if (event.target && event.target.querySelector && event.target.querySelector(E_HOME_SECTION_SELECTOR)) {
      var el = event.target.querySelector(E_HOME_SECTION_SELECTOR);
      if (el) el.dataset.initialized = 'false';
      initEHomeServices();
    }
  });
  document.addEventListener('shopify:section:unload', function(event) {
    if (event.target && event.target.querySelector) {
      var el = event.target.querySelector(E_HOME_SECTION_SELECTOR);
      if (el) {
        el.dataset.initialized = 'false';
        if (el.__eHomeCleanup) el.__eHomeCleanup();
      }
    }
  });
})();
</script>

