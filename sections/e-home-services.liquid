        { "value": "xs", "label": "xs" },
        { "value": "sm", "label": "sm" },
        { "value": "md", "label": "md" },
        { "value": "lg", "label": "lg" },
        { "value": "xl", "label": "xl" }
      ],
      "default": "lg"
    },
    {
      "type": "select",
      "id": "padding_bottom",
      "label": "Padding Bottom",
      "options": [
        { "value": "0", "label": "0" },
        { "value": "xs", "label": "xs" },
