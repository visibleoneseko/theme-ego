{%- comment -%}
  e-home-services — "Full-Lifecycle Engineering Services" (Roctec homepage)
  Single-card slider on Owl Carousel 2.3.4 (already loaded by theme.liquid).
  Mockup counter ("1/4"), progress bar and round prev/next buttons are kept
  and driven from Owl events. Block loop sits directly inside .owl-carousel.
{%- endcomment -%}
{%- assign slide_count = section.blocks.size -%}
<style>
#e-home-services {
  background: #FFFFFF;
}
#e-home-services .rsvc-inner {
  max-width: var(--e-container);
  margin-inline: auto;
  padding-inline: var(--space-6);
}
#e-home-services .rsvc-layout {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: var(--space-8);
  align-items: center;
}
#e-home-services .rsvc-intro {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  position: relative;
}
#e-home-services .rsvc-intro > * {
  position: relative;
  z-index: 1;
}
#e-home-services .rsvc-eyebrow {
  letter-spacing: 0.14em;
  display: block;
  font-size: var(--text-base);
  font-weight: 600;
  text-transform: uppercase;
  color: var(--color-primary);
  margin-bottom: 12px;
}
#e-home-services .rsvc-intro h2 {
  font-size: var(--text-h2);
  line-height: 1.15;
  letter-spacing: -0.02em;
  color: var(--color-text);
  margin-bottom: var(--space-2);
}
#e-home-services .rsvc-intro p {
  font-size: var(--text-lg);
  color: var(--color-text);
  line-height: 1.6;
  margin-bottom: var(--head-gap);
}
#e-home-services .rsvc-cta {
  flex: 0 0 auto;
}
#e-home-services .rsvc-carousel {
  width: 100%;
  min-width: 0;
  max-width: 480px;
  margin-left: auto;
}
#e-home-services .rsvc-viewport {
  overflow: hidden;
}
#e-home-services .rsvc-track {
  display: flex;
  transition: transform 650ms var(--ease-standard);
}
#e-home-services .rsvc-slide {
  flex: 0 0 100%;
  min-width: 0;
  background: var(--color-surface);
  border-radius: var(--radius-lg);
  overflow: hidden;
  display: flex;
  flex-direction: column;
  padding: var(--space-2);
  border: 1px solid #E4E6EA;
  box-shadow: var(--shadow-sm);
}
#e-home-services .rsvc-media {
  position: relative;
  aspect-ratio: 16 / 9;
  border-radius: var(--radius-lg);
  overflow: hidden;
  background-color: var(--color-surface-muted);
  background-image: repeating-linear-gradient(
  135deg,
  var(--color-border) 0,
  var(--color-border) 1px,
  transparent 1px,
  transparent 12px
  );
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 0;
}
#e-home-services .rsvc-media img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}
#e-home-services .rsvc-body {
  padding: var(--space-6);
}
#e-home-services .rsvc-slide h3 {
  font-size: var(--text-h4);
  font-weight: 600;
  line-height: 1.2;
  color: var(--color-text);
  margin-bottom: var(--space-3);
}
#e-home-services .rsvc-slide p {
  font-size: var(--text-base);
  color: var(--color-text);
  line-height: 1.6;
  margin-bottom: 0;
}
#e-home-services .rsvc-controls {
  display: flex;
  align-items: center;
  gap: var(--space-6);
  margin-top: var(--space-8);
}
#e-home-services .rsvc-count {
  font-size: var(--text-base);
  font-weight: 700;
  color: var(--color-text);
  font-variant-numeric: tabular-nums;
  flex: 0 0 auto;
}
#e-home-services .rsvc-progress {
  flex: 1;
  height: 3px;
  border-radius: 2px;
  background: var(--color-border);
  overflow: hidden;
}
#e-home-services .rsvc-progress-bar {
  display: block;
  height: 100%;
  width: 25%;
  border-radius: 2px;
  background: var(--color-primary);
  transition: width var(--motion-slow) var(--ease-standard);
}
#e-home-services .rsvc-nav {
  display: flex;
  gap: var(--space-3);
  flex: 0 0 auto;
  margin-left: var(--space-2);
}
#e-home-services .rsvc-btn {
  width: var(--touch-target);
  height: var(--touch-target);
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: transparent;
  border: 1px solid var(--color-border);
  color: var(--color-text);
  transition: border-color var(--motion-base) var(--ease-standard),
  color var(--motion-base) var(--ease-standard),
  opacity var(--motion-base) var(--ease-standard);
}
#e-home-services .rsvc-btn:hover {
  border-color: var(--color-primary);
  color: var(--color-primary);
}
#e-home-services .rsvc-btn svg {
  width: 20px;
  height: 20px;
}
#e-home-services .rsvc-btn[disabled] {
  opacity: 0.3;
  cursor: not-allowed;
  border-color: var(--color-border);
  color: var(--color-text);
}
@media (max-width: 1024px) {
  #e-home-services .rsvc-layout {
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-12);
    align-items: stretch;
  }
  #e-home-services .rsvc-carousel {
    margin-inline: auto;
  }
}
@media (max-width: 767px) {
  #e-home-services .rsvc-intro h2 {
    overflow-wrap: break-word;
  }
  #e-home-services .rsvc-layout {
    gap: var(--space-8);
  }
  #e-home-services .rsvc-intro p {
    margin-bottom: var(--space-6, 24px);
  }
  #e-home-services .rsvc-controls {
    margin-top: var(--space-6);
  }
}
@media (max-width: 400px) {
  #e-home-services .rsvc-inner {
    padding-inline: var(--space-5);
  }
}
/* --- Owl integration (keeps the mockup look on Owl's DOM) --- */
#e-home-services .rsvc-track.owl-carousel {
  display: block;
  transition: none;
  transform: none;
}
#e-home-services .rsvc-track.owl-carousel:not(.owl-loaded) {
  display: flex; /* before Owl starts: first card visible, no layout jump */
}
#e-home-services .rsvc-track .owl-stage {
  display: flex;
}
#e-home-services .rsvc-track .owl-item {
  display: flex;
}
#e-home-services .rsvc-track .owl-item .rsvc-slide {
  width: 100%;
}
#e-home-services .rsvc-media .placeholder-svg {
  width: 100%;
  height: 100%;
  fill: rgba(17, 17, 17, 0.25);
}
#e-home-services .rsvc-controls[hidden] { display: none; }
</style>

<section
  id="e-home-services"
  class="e-home-services rsvc skpt-{{ section.settings.padding_top }} skpb-{{ section.settings.padding_bottom }}"
>
  <div class="rsvc-inner" data-sk-reveal>
    <div class="rsvc-layout">
      <div class="rsvc-intro">
        {%- if section.settings.eyebrow != blank -%}
          <span class="rsvc-eyebrow">{{ section.settings.eyebrow | escape }}</span>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2>{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          <p>{{ section.settings.text | escape }}</p>
        {%- endif -%}
        {%- if section.settings.button_label != blank -%}
          <a class="btn btn-secondary rsvc-cta" href="{{ section.settings.button_link | default: '#' }}">{{ section.settings.button_label | escape }}</a>
        {%- endif -%}
      </div>

      <div class="rsvc-carousel">
        <div class="rsvc-viewport">
          <div class="rsvc-track owl-carousel">{%- for block in section.blocks -%}
            <article class="rsvc-slide" data-index="{{ forloop.index0 }}" {{ block.shopify_attributes }}>
              <div class="rsvc-media">
                {%- if block.settings.image != blank -%}
                  {%- assign img_alt = block.settings.image.alt | default: block.settings.title -%}
                  {{ block.settings.image | image_url: width: 960 | image_tag: widths: '360, 480, 720, 960', sizes: '(max-width: 520px) 92vw, 480px', loading: 'lazy', alt: img_alt }}
                {%- else -%}
                  {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
                {%- endif -%}
              </div>
              <div class="rsvc-body">
                {%- if block.settings.title != blank -%}
                  <h3>{{ block.settings.title | escape }}</h3>
                {%- endif -%}
                {%- if block.settings.text != blank -%}
                  <p>{{ block.settings.text | escape }}</p>
                {%- endif -%}
              </div>
            </article>
          {%- endfor -%}</div>
        </div>
        <div class="rsvc-controls"{% if slide_count < 2 %} hidden{% endif %}>
          <span class="rsvc-count"><span class="rsvc-count-current">1</span>/<span class="rsvc-count-total">{{ slide_count }}</span></span>
          <div class="rsvc-progress"><span class="rsvc-progress-bar"{% if slide_count > 0 %} style="width: {{ 100.0 | divided_by: slide_count }}%;"{% endif %}></span></div>
          <div class="rsvc-nav">
            <button class="rsvc-btn prev" type="button" aria-label="Previous service" disabled>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5M11 5l-7 7 7 7"></path></svg>
            </button>
            <button class="rsvc-btn next" type="button" aria-label="Next service">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 5l7 7-7 7"></path></svg>
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
(function () {
  'use strict';

  if (!window.eHomeServices) {
    window.eHomeServices = (function () {
      var instances = {};
      var NS = '.eHomeServices';

      function owlReady() {
        return !!(window.jQuery && window.jQuery.fn && window.jQuery.fn.owlCarousel);
      }

      function create(root) {
        var $ = window.jQuery;
        var trackEl = root.querySelector('.rsvc-track');
        var $track = $(trackEl);
        var prev = root.querySelector('.rsvc-btn.prev');
        var next = root.querySelector('.rsvc-btn.next');
        var countEl = root.querySelector('.rsvc-count-current');
        var bar = root.querySelector('.rsvc-progress-bar');
        var total = trackEl.querySelectorAll('.rsvc-slide').length;

        function render(index) {
          if (countEl) countEl.textContent = index + 1;
          if (bar) bar.style.width = ((index + 1) / total * 100) + '%';
          if (prev) prev.disabled = index <= 0;
          if (next) next.disabled = index >= total - 1;
        }

        function onPrev() { $track.trigger('prev.owl.carousel'); }
        function onNext() { $track.trigger('next.owl.carousel'); }

        /* bind before init so "initialized" is caught */
        $track.on('initialized.owl.carousel' + NS + ' changed.owl.carousel' + NS, function (e) {
          if (e.type === 'changed' && (!e.property || e.property.name !== 'position')) return;
          var index = (e.type === 'changed') ? e.property.value : (e.item ? e.item.index : 0);
          if (typeof index === 'number' && index >= 0) render(index);
        });

        $track.owlCarousel({
          items: 1,
          margin: 0,
          loop: false,
          nav: false,
          dots: false,
          mouseDrag: true,
          touchDrag: true,
          smartSpeed: 650,
          dragEndSpeed: 650
        });

        if (prev) prev.addEventListener('click', onPrev);
        if (next) next.addEventListener('click', onNext);
        render(0);

        return {
          to: function (i) { $track.trigger('to.owl.carousel', [i, 650]); },
          destroy: function () {
            if (prev) prev.removeEventListener('click', onPrev);
            if (next) next.removeEventListener('click', onNext);
            $track.off(NS);
            $track.trigger('destroy.owl.carousel');
            $track.removeClass('owl-loaded owl-drag owl-grab');
            root.removeAttribute('data-e-init');
          }
        };
      }

      function mount(sectionId) {
        var wrap = document.getElementById('shopify-section-' + sectionId);
        var root = wrap ? wrap.querySelector('.e-home-services') : null;
        if (!root || root.hasAttribute('data-e-init')) return;
        if (!root.querySelector('.rsvc-slide')) return;
        if (!owlReady()) {
          /* theme.liquid loads jQuery + Owl at the end of <body>: wait for them */
          if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', function () { mount(sectionId); }, { once: true });
          } else {
            console.warn('[e-home-services] Owl Carousel is not loaded — check theme.liquid.');
          }
          return;
        }
        root.setAttribute('data-e-init', '');
        instances[sectionId] = create(root);
      }

      function unmount(sectionId) {
        if (instances[sectionId]) { instances[sectionId].destroy(); delete instances[sectionId]; }
      }

      document.addEventListener('shopify:section:load', function (e) { mount(e.detail.sectionId); });
      document.addEventListener('shopify:section:unload', function (e) { unmount(e.detail.sectionId); });
      document.addEventListener('shopify:block:select', function (e) {
        var inst = instances[e.detail.sectionId];
        var slide = e.target.closest ? e.target.closest('.rsvc-slide') : null;
        if (inst && slide) inst.to(parseInt(slide.getAttribute('data-index'), 10) || 0);
      });

      return { mount: mount, unmount: unmount };
    })();
  }

  window.eHomeServices.mount('{{ section.id }}');
})();
</script>

{% schema %}
{
  "name": "Home – Services",
  "settings": [
    {
      "type": "select",
      "id": "padding_top",
      "label": "Padding Top",
      "options": [
