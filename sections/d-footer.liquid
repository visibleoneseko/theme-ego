{%- style -%}
.sk-footer-{{ section.id }} {background-color: {{ section.settings.bg_color }};}

  /* Specific footer link styling */
#d-footer footer ul.list-unstyled {list-style: none;padding: 0;margin: 0;}  
#d-footer footer .col h6 {margin-top: 0px;}
#d-footer footer a {text-decoration: none;transition: var(--transition);}

  /* Back to top button styling */
#d-footer #backToTop {
    position: fixed;bottom: 30px;right: 30px;width: 45px;height: 45px;
    border-radius: 4px;z-index: 1000;transition: var(--transition);opacity: 0.8;
    display: none; /* Hidden by default, shown via JS */
  }
#d-footer #backToTop:hover {
  background-color: var(--blue-color) !important;opacity: 1;
}
  /* Responsive adjustments for the brand col */
@media (max-width: 991px) {
#d-footer .footer-brand {width: 100% !important;margin-bottom: var(--calc-spacing-sm);}
}
{%- endstyle -%}

<footer id="d-footer"  class="sk-footer-{{ section.id }} skpt-lg skpb-lg">
  <div class="container-lg">
    <div class="d-flex justify-content-between align-items-start gap-40 flex-wrap">
      
      {% comment %} Brand Column {% endcomment %}
      <div class="footer-brand col-3">
        <div class="skmb-xs">
          {%- if section.settings.logo != blank -%}
            <img 
              src="{{ section.settings.logo | image_url: width: 400 }}" 
              alt="{{ section.settings.logo.alt | escape }}" 
              class="w-205px"
              style="max-width: {{ section.settings.logo_max_width }}px;"
            >
          {%- else -%}
            <h2 class="fs-h4 skfwb">{{ shop.name }}</h2>
          {%- endif -%}
        </div>
        
        {%- if section.settings.brand_text != blank -%}
          <div class="fs-14 text-gray sklh-h skmb-xs">
            {{ section.settings.brand_text }}
          </div>
        {%- endif -%}

        <div class="d-flex gap-20 align-items-center">
          {%- if section.settings.social_facebook != blank -%}
            <a href="{{ section.settings.social_facebook }}" class="text-black text-blue-hover" aria-label="Facebook">
              <svg width="20" height="20" fill="currentColor" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
            </a>
          {%- endif -%}
          
          {%- if section.settings.social_instagram != blank -%}
            <a href="{{ section.settings.social_instagram }}" class="text-black text-blue-hover" aria-label="Instagram">
              <svg width="20" height="20" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204 013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.791-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.209-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
            </a>
          {%- endif -%}

          {%- if section.settings.social_vimeo != blank -%}
            <a href="{{ section.settings.social_vimeo }}" class="text-black text-blue-hover" aria-label="Vimeo">
              <svg width="20" height="20" fill="currentColor" viewBox="0 0 24 24"><path d="M23.977 6.411c-.11 2.322-1.723 5.482-4.839 9.488-3.235 4.179-5.971 6.267-8.211 6.267-1.39 0-2.566-1.28-3.524-3.841l-1.908-7.005c-.713-2.614-1.485-3.922-2.316-3.922-.183 0-.824.384-1.923 1.152l-1.152-1.48c1.206-1.061 2.404-2.122 3.593-3.184 1.628-1.444 2.854-2.185 3.685-2.222 1.956-.092 3.167 1.261 3.629 4.053.511 3.083.86 5.003 1.042 5.76.438 2.378.911 3.567 1.42 3.567.384 0 1.025-.531 1.923-1.59 1.444-1.701 1.734-2.923 1.734-3.66 0-1.134-.33-1.646-1.354-1.646-.475 0-1.005.11-1.591.33 1.042-3.411 3.029-5.04 5.961-4.884 2.158.11 3.235 1.464 3.235 4.053z"/></svg>
            </a>
          {%- endif -%}
        </div>
      </div>

      {% comment %} Dynamic Menu Blocks {% endcomment %}
      {%- for block in section.blocks -%}
        <div class="col" {{ block.shopify_attributes }}>
          {%- if block.settings.heading != blank -%}
            <h6 class="fs-h6 skfwb text-black skmb-15">{{ block.settings.heading | uppercase }}</h6>
          {%- endif -%}
          
          {%- if block.settings.menu != blank -%}
            <ul class="list-unstyled">
              {%- for link in linklists[block.settings.menu].links -%}
                <li class="{% unless forloop.last %}skmb-15{% endunless %}">
                  <a href="{{ link.url }}" class="fs-14 text-gray text-blue-hover">
                    {{ link.title }}
                  </a>
                </li>
              {%- endfor -%}
            </ul>
          {%- endif -%}
        </div>
      {%- endfor -%}

    </div>
  </div>
</footer>

{%- if section.settings.show_back_to_top -%}
  <a href="#" id="backToTop" class="bg-black text-white flex-center" aria-label="Back to top">
    <svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
      <path d="M5 15l7-7 7 7"/>
    </svg>
  </a>
{%- endif -%}

<script>
try {
  document.addEventListener('DOMContentLoaded', function() {
    const backToTop = document.getElementById('backToTop');
    
    if (backToTop) {
      backToTop.addEventListener('click', function(e) {
        e.preventDefault();
        window.scrollTo({
          top: 0,
          behavior: 'smooth'
        });
      });

      window.addEventListener('scroll', function() {
        if (window.pageYOffset > 300) {
          backToTop.style.display = 'flex';
        } else {
          backToTop.style.display = 'none';
        }
      });
    }
  });    
} catch (error) {}
</script>
{% schema %}
{
  "name": "d-footer",
  "tag": "section",
  "class": "shopify-section-footer",
  "max_blocks": 4,
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Brand Identity"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Footer Logo"
    },
    {
      "type": "range",
      "id": "logo_max_width",
      "min": 50,
      "max": 300,
      "step": 5,
      "unit": "px",
      "label": "Logo Width",
      "default": 205
    },
    {
      "type": "richtext",
      "id": "brand_text",
      "label": "Brand Description",
      "default": "<p>Capture those magic moments with the world’s finest and widest range of rugged underwater camera housings.</p>"
    },
    {
      "type": "header",
      "content": "Social Media Links"
    },
    {
      "type": "url",
      "id": "social_facebook",
      "label": "Facebook URL"
    },
    {
      "type": "url",
      "id": "social_instagram",
      "label": "Instagram URL"
    },
    {
      "type": "url",
      "id": "social_vimeo",
      "label": "Vimeo URL"
    },
    {
      "type": "header",
      "content": "Functionality"
    },
    {
      "type": "checkbox",
      "id": "show_back_to_top",
      "label": "Enable Back to Top Button",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "menu_column",
      "name": "Menu Column",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Menu Heading",
          "default": "Quick Links"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Select Menu",
          "default": "footer"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "d-footer",
      "blocks": [
        { "type": "menu_column", "settings": { "heading": "Products" } },
        { "type": "menu_column", "settings": { "heading": "My Account" } },
        { "type": "menu_column", "settings": { "heading": "About Us" } },
        { "type": "menu_column", "settings": { "heading": "Help" } }
      ]
    }
  ]
}
{% endschema %}