<section id="b-richtext-combo">
  <div class="container">
    {% if section.settings.title %}
        <h2 class="fs-{{ section.settings.heading_size }} title text-{{ section.settings.align }}" style="color: {{ section.settings.titletextcolor }};">{{ section.settings.title }}</h2>
    {% endif %}
    {% for block in section.blocks %}
      {% case block.type %}
        {%- when 'subtitlebybgcolor' -%}
          <h3 class="fs-{{ block.settings.heading_size }} subtitlebybgcolor subtitlebybgcolor{{ forloop.index }}" style="background-color: {{ block.settings.subtitlebgcolor }};color: {{ block.settings.textcolor }};">{{ block.settings.subtitle }}</h3> 
        {%- when 'subtitle' -%}
          <p class="fs-{{ block.settings.text_size }} subtitle subtitle{{ forloop.index }}" style="color: {{ block.settings.subtitletextcolor }};">{{ block.settings.subtitle }}</p>
        {%- when 'description' -%}
          <div class="fs-{{ block.settings.text_size }} text-{{ block.settings.align }} description description{{ forloop.index }} {% if block.settings.nospacingonchilds %}nospacingonchilds{% endif %}">
            {{ block.settings.description }}
          </div>
          {%- when 'pagecontent' -%}
            <div class="pagecontent  pagecontent{{ forloop.index }}">
              {{ page.content }}
            </div>
          {%- when 'html' -%} 
            <div class="html html{{ forloop.index }}">
              {{ block.settings.html }}
            </div>
          {%- when 'spacing' -%} 
            <div class="spacing{{ forloop.index }}" style="height: {{ block.settings.spacingh }}px;">
                {{ block.settings.spacingh }}
            </div>
      {% endcase %}
    {% endfor %}

  </div>
</section>
<style>
#b-richtext-combo .subtitlebybgcolor{padding: 8px 10px;font-weight: 500;}
#b-richtext-combo .subtitle{font-weight: 500;}
#b-richtext-combo ul{
list-style-type: disc;
padding-inline-start: 20px;
}
#b-richtext-combo ol{
list-style-type: decimal;
padding-inline-start: 20px;
}
</style>
