<style>
#e-products-listing{
  --hl-deep-orange: #bd2c00;
  --hl-orange: #db3c0c;
  --hl-cream: #fdf5f3;
  --hl-pink-hairline: #ffebe8;
  --hl-pink-hover: #fdd8d2;
  --hl-green: #3e7a4e;
  --hl-light-green: #e3efe6;
  --hl-success-bg: #e8f2e9;
  --hl-ink: #1a1a1a;
  --hl-grey: #606060;
  --hl-warm-grey: #81756f;
  --hl-muted: #a09890;
  --hl-dark-label: #333333;
  --hl-blush: #fff6f3;
  --hl-blush-light: #fff9f7;
  --hl-salmon: #ffad9e;
  --hl-bright-orange: #ff5421;
  --hl-sage-tag-bg: #d8e7dd;
  --hl-sage-tag-text: #4e6854;
  --hl-pick-badge: #ffbf6a;
  --hl-pick-badge-stroke: #9c6a00;
  --hl-pick-badge-dark: #5f3600;
  --hl-warm-rose: #e2a18c;
  --hl-rose-light: #f0c9bd;
  --hl-soft-ring: #ffd0c6;
  --hl-taupe: #d9cdc8;
  --hl-taupe-dark: #c3b4ae;
  --hl-sand: #f3eae5;
  --hl-hero-bg: #f7e8df;
  --hl-peach: #fdf4ee;
  --hl-cart-grey: #959595;
  --hl-disabled: #f3f0ee;
  --hl-line: #f3e7e1;
  --hl-facebook: #1877f2;
  --hl-whatsapp: #25d366;
  --hl-pending-bg: #fdeeda;
  --hl-pending-text: #8a5a19;
  --hl-member-grad-start: #e8501f;
  --hl-member-grad-end: #9c2400;
}
#e-products-listing .hl-pill{ padding: 14px 26px; border-radius: 1000px; line-height: 1; font-family: "Source Han Serif SC", "Noto Serif SC", serif; font-weight: 700; }
#e-products-listing .hl-page-btn{ height: 48px; min-width: 48px; border-radius: 30px; }
#e-products-listing .hl-tab{ height: 44px; padding: 0 22px; border-radius: 20px; }
#e-products-listing .hl-arrow{ width: 48px; height: 48px; background: var(--hl-orange); box-shadow: 0 4px 10px rgba(141,133,133,.1); }
#e-products-listing .hl-card-action{ width: 40px; height: 40px; background: var(--hl-deep-orange); }
#e-products-listing .hl-price-now{ font-family: "Source Han Serif SC", "Noto Serif SC", serif; font-weight: 700; color: var(--hl-orange); }
#e-products-listing .hl-price-was{ color: var(--hl-grey); }
#e-products-listing .hl-sort-select{ height: 44px; padding: 0 42px 0 16px; border: 0; box-shadow: inset 0 0 0 1px var(--hl-pink-hairline); border-radius: 20px; }
#e-products-listing .hl-search{ height: 44px; padding: 0 46px 0 20px; border: 1px solid var(--hl-pink-hairline); border-radius: 1000px; }
#e-products-listing .hl-arrow-sortbar{ width: 40px; height: 40px; display: grid; place-items: center; padding: 0; overflow: hidden; border: 0; border-radius: 1000px; cursor: pointer; transition: background .2s, opacity .2s; }
#e-products-listing .hl-arrow-sortbar[data-navi]{ background: var(--hl-cream) !important; box-shadow: inset 0 0 0 1px var(--hl-pink-hairline) !important; }
#e-products-listing .hl-arrow-sortbar[data-navi] svg{ color: var(--hl-warm-rose) !important; }
#e-products-listing .hl-arrow-sortbar[data-navi][disabled]{ opacity: 1; cursor: default; }
#e-products-listing .hl-arrow-sortbar[data-navi][disabled] svg{ color: var(--hl-rose-light) !important; }
#e-products-listing .hl-arrow-sortbar[data-navi]:not([disabled]):hover{ background: var(--hl-pink-hairline) !important; }
@keyframes e-products-listing-hl-tag-shine{ 0% { transform: translateX(-120%); } 60%, 100% { transform: translateX(220%); } }
#e-products-listing .hl-tag-upcoming{ padding: 12px 20px; border-radius: 100px; color: rgb(255, 255, 255); background: var(--hl-ink); font-size: 19.08px; letter-spacing: 0.12em; }
#e-products-listing .hl-pick{ padding: 8px 16px; border-radius: 100px; background: var(--hl-pick-badge); color: var(--hl-pick-badge-dark); text-transform: uppercase; }
#e-products-listing .strip-svg-ur0s{ display: block; flex: 0 0 auto; }
#e-products-listing .header-svg-1xlt{ flex: 0 0 auto; display: block; }
#e-products-listing .hl-tel-wrap > input[type="tel"]{ width: 100%; padding-left: 70px !important; }
@layer  base {
@media  (max-width: 429.98px) {
#e-products-listing body input.st-font-size-16px,
#e-products-listing body select.st-font-size-16px,
#e-products-listing body textarea.st-font-size-16px{ font-size: 16px !important; }
}
}
@layer  base {
@media  (max-width: 767px) {
#e-products-listing body [data-cat-list]{ left: var(--vvl, 0px) !important; right: auto !important; width: var(--vvw, 100%) !important; max-width: var(--vvw, 100%) !important; box-sizing: border-box !important; }
#e-products-listing body [data-cat-list]{ top: var(--vvt, 0px) !important; bottom: auto !important; height: var(--vvh, 100dvh) !important; max-height: var(--vvh, 100dvh) !important; }
}
}
@layer  base {
#e-products-listing body [data-reveal]:has([data-fbar-sheet]),
#e-products-listing body [data-reveal]:has([data-cat-list]){ transform: none !important; }
}
@layer  base {
#e-products-listing [role="status"]:not([data-cookie]):not([data-om-toast]){ box-sizing: border-box; align-items: center !important; gap: 16px; padding: 12px 16px !important; border-radius: 12px !important; line-height: 1.6; }
#e-products-listing [role="status"]:not([data-cookie]):not([data-om-toast]) button{ flex: 0 0 auto; width: 22px !important; height: 22px !important; min-width: 0 !important; min-height: 0 !important; }
#e-products-listing [role="status"]:not([data-cookie]):not([data-om-toast]) > *{ margin: 0 !important; }
}
@layer  base {
#e-products-listing [data-pick-shine] svg{ overflow: visible; transform: translateY(1.5px); filter: drop-shadow(0 1px 1px rgba(80, 50, 0, 0.2)); }
#e-products-listing [data-pick-shine] svg path:first-child{ stroke: var(--hl-pick-badge-stroke); stroke-width: 4px; stroke-linejoin: round; }
#e-products-listing [data-pick-shine]{ overflow: hidden; }
@keyframes hero-rise{ from { opacity: 0; transform: translateY(24px); } to { opacity: 1; transform: none; } }
@keyframes stamp-in{ from { opacity: 0; transform: rotate(-8deg) scale(.72); } to { opacity: 1; transform: rotate(12deg) scale(1); } }
@keyframes media-marquee{ to { transform: translateX(calc(-50% - 16px)); } }
@keyframes about-marquee{ to { transform: translateX(calc(-50% - 24px)); } }
@keyframes stat-pop{ 0% { transform: translateY(0) scale(1); } 45% { transform: translateY(-8px) scale(1.06); } 100% { transform: translateY(0) scale(1); } }
@keyframes marquee{ to { transform: translateX(calc(-50% - 12px)); } }
#e-products-listing [data-pbtn] img{ transition: filter .2s ease; }
#e-products-listing [data-pbtn]:hover img{ filter: brightness(0) opacity(.8) !important; }
#e-products-listing [data-navi] svg{ transition: transform .25s ease; }
#e-products-listing [data-navi] svg[data-dir="prev"]{ transform: rotate(180deg) !important; }
#e-products-listing [data-navi] svg[data-dir="next"]{ transform: none !important; }
#e-products-listing [data-navi]:not([disabled]):hover svg[data-dir="prev"]{ transform: rotate(180deg) translateX(8px) !important; }
#e-products-listing [data-navi]:not([disabled]):hover svg[data-dir="next"]{ transform: translateX(8px) !important; }
#e-products-listing [data-navi]:not([disabled]):hover{ background: var(--hl-deep-orange) !important; }
#e-products-listing [data-navi][disabled]{ opacity: .35; cursor: default; }
#e-products-listing [data-price-sort]:focus,
#e-products-listing [data-price-sort]:focus-visible{ outline: 2px solid var(--hl-orange); outline-offset: -1px; }
#e-products-listing input[type="search"]{ caret-color: var(--hl-orange); }
#e-products-listing input[type="search"]:focus,
#e-products-listing input[type="search"]:focus-visible{ outline: 2px solid var(--hl-orange); outline-offset: -1px; border-color: var(--hl-orange) !important; }
#e-products-listing input[type="search"]::-webkit-search-cancel-button{
    -webkit-appearance: none; appearance: none; width: 15px; height: 15px; cursor: pointer;
