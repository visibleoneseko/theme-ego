<script>
(() => {
  const root = document.getElementById('e-products-listing');
  if (!root || root.dataset.initialized === 'true') return;
  root.dataset.initialized = 'true';

  const $ = (selector, scope = root) => scope.querySelector(selector);
  const $$ = (selector, scope = root) => Array.from(scope.querySelectorAll(selector));
  const grid = $('[data-course-grid]');
  const searchInput = $('[data-product-search]');
  const countNode = $('[data-course-count]');
  const pageCurrent = $('[data-page-cur]');
  const pageTotal = $('[data-page-total]');
  const pager = $('[data-pager]');
  const pageNumbers = $('[data-page-numbers]');
  const loadingStatus = $('[data-loading-status]');
  const emptyPanel = $('[data-empty-products]');
  const endOfList = $('[data-end-of-list]');
  const categoryButtons = $$('[data-catnav]');
  const sortButtons = $$('[data-sort]');
  const pageSize = Math.max(1, Number(root.dataset.pageSize) || 9);
  const currency = (root.dataset.currency || 'MYR').toUpperCase();
  const rootUrl = root.dataset.rootUrl || '/';

  const collectionHandles = {
    daily: root.dataset.dailyCollection || '',
    kitchen: root.dataset.kitchenCollection || '',
    book: root.dataset.bookCollection || ''
  };
  const categoryNames = {
    daily: '日常食材',
    kitchen: '厨房与生活用品',
    book: '精选书本'
  };
  const state = {
    productsByCategory: { daily: [], kitchen: [], book: [] },
    activeCategory: 'all',
    search: '',
    sort: 'popular',
    price: '',
    page: 1,
    productsLoaded: false
  };
  let abortController = null;

  const eProductsListingSafeText = (value) => String(value == null ? '' : value);
  const eProductsListingTagsOf = (product) => {
    if (Array.isArray(product.tags)) return product.tags.map((tag) => String(tag).trim().toLowerCase());
    return String(product.tags || '').split(',').map((tag) => tag.trim().toLowerCase()).filter(Boolean);
  };
  const eProductsListingTagNumber = (tags, expression) => {
    for (const tag of tags) {
      const match = tag.match(expression);
      if (match) return Number(match[1]) || 0;
    }
    return 0;
  };
  const eProductsListingProductMeta = (product) => {
    const tags = eProductsListingTagsOf(product);
    return {
      tags,
      recommended: tags.some((tag) => tag === 'al-recommended' || tag.startsWith('recommended-')),
      recommendationScore: eProductsListingTagNumber(tags, /^(?:al-)?recommended-(\d+)$/),
      salesScore: eProductsListingTagNumber(tags, /^(?:al-)?(?:sales|bought|students)-(\d+)$/),
      upcoming: tags.some((tag) => tag === 'al-upcoming' || tag === 'upcoming')
    };
  };
  const eProductsListingPriceOf = (product) => {
    const variants = Array.isArray(product.variants) ? product.variants : [];
    const variant = variants.find((item) => item.available) || variants[0] || {};
    return Number(variant.price || product.price || 0);
  };
  const eProductsListingVariantOf = (product) => {
    const variants = Array.isArray(product.variants) ? product.variants : [];
    return variants.find((item) => item.available) || variants[0] || null;
  };
  const eProductsListingFormatMoney = (value) => {
    const amount = Number(value || 0);
    try {
      return new Intl.NumberFormat(undefined, {
        style: 'currency',
        currency,
        minimumFractionDigits: 2,
        maximumFractionDigits: 2
      }).format(amount);
    } catch (error) {
      return 'RM ' + amount.toFixed(2);
    }
  };
  const eProductsListingImageFor = (product) => {
    const images = Array.isArray(product.images) ? product.images : [];
    const image = images[0];
    return image && (image.src || image.url) ? (image.src || image.url) : '';
  };
  const eProductsListingUniqueProducts = (products) => {
    const seen = new Set();
    return products.filter((product) => {
      const key = String(product.id);
      if (!product.id || seen.has(key)) return false;
      seen.add(key);
      return true;
    });
  };

  async function eProductsListingFetchCollectionProducts(category, handle) {
    if (!handle) {
      throw new Error('请在主题编辑器中为「' + categoryNames[category] + '」选择对应的 Shopify collection。');
    }
    const url = rootUrl + 'collections/' + encodeURIComponent(handle) + '/products.json?limit=250';
    const response = await fetch(url, {
      credentials: 'same-origin',
      headers: { 'Accept': 'application/json' },
      signal: abortController ? abortController.signal : undefined
    });
    if (!response.ok) throw new Error('Collection "' + handle + '" 请求失败（' + response.status + '）。');
    const data = await response.json();
    return Array.isArray(data.products) ? data.products : [];
  }

  async function eProductsListingLoadProducts() {
    if (abortController) abortController.abort();
    abortController = new AbortController();
    loadingStatus.hidden = false;
    loadingStatus.textContent = '正在载入好品…';
    try {
      const categories = ['daily', 'kitchen', 'book'];
      const results = await Promise.all(categories.map((key) => eProductsListingFetchCollectionProducts(key, collectionHandles[key])));
      categories.forEach((key, index) => {
        state.productsByCategory[key] = results[index].map((product) => ({
          ...product,
          __category: key,
          __meta: eProductsListingProductMeta(product)
        }));
      });
      state.productsLoaded = true;
      loadingStatus.hidden = true;
      eProductsListingRender();
    } catch (error) {
      if (error.name === 'AbortError') return;
      loadingStatus.hidden = false;
      loadingStatus.textContent = error.message || '商品载入失败，请检查 collection 设置或稍后重试。';
      grid.innerHTML = '';
      emptyPanel.hidden = true;
      countNode.textContent = '0 件好品';
      pager.hidden = true;
    }
  }

  function eProductsListingActiveProducts() {
    if (state.activeCategory === 'all') {
      return eProductsListingUniqueProducts([
        ...state.productsByCategory.daily,
        ...state.productsByCategory.kitchen,
        ...state.productsByCategory.book
      ]);
    }
    return state.productsByCategory[state.activeCategory] || [];
  }

  function eProductsListingGetFilteredProducts() {
    const query = state.search.trim().toLocaleLowerCase();
    const filtered = eProductsListingActiveProducts().filter((product) => {
      // Custom search: only product title is searched, within the active category.
      return !query || eProductsListingSafeText(product.title).toLocaleLowerCase().includes(query);
    });
    const meta = (product) => product.__meta || eProductsListingProductMeta(product);
    filtered.sort((a, b) => {
      const am = meta(a), bm = meta(b);
      if (state.price === 'price-asc') return eProductsListingPriceOf(a) - eProductsListingPriceOf(b);
      if (state.price === 'price-desc') return eProductsListingPriceOf(b) - eProductsListingPriceOf(a);
      if (state.sort === 'new') return new Date(b.published_at || 0) - new Date(a.published_at || 0);
      if (state.sort === 'students') return bm.salesScore - am.salesScore;
      if (state.sort === 'upcoming') return Number(bm.upcoming) - Number(am.upcoming) || new Date(b.published_at || 0) - new Date(a.published_at || 0);
      return Number(bm.recommended) - Number(am.recommended) ||
        bm.recommendationScore - am.recommendationScore ||
        bm.salesScore - am.salesScore;
    });
    return filtered;
  }

  function eProductsListingCreateCard(product) {
    const variant = eProductsListingVariantOf(product);
    const meta = product.__meta || eProductsListingProductMeta(product);
    const image = eProductsListingImageFor(product);
    const comparePrice = variant && Number(variant.compare_at_price || 0);
    const price = eProductsListingPriceOf(product);
    const available = !!(variant && variant.available);
    const handle = eProductsListingSafeText(product.handle);
    const title = eProductsListingSafeText(product.title);
    const url = rootUrl + 'products/' + encodeURIComponent(handle);
    const article = document.createElement('article');
    article.className = 'courses-article-4ion st-flex-direction-column';
    article.setAttribute('data-course-card', '');
    article.setAttribute('data-course-item', '');
    article.setAttribute('data-cat', product.__category || 'daily');
    article.setAttribute('data-price', String(price));
    article.setAttribute('data-upcoming', meta.upcoming ? '1' : '0');
    article.setAttribute('data-students', String(meta.salesScore));
    article.setAttribute('data-reveal', 'up');
    article.style.display = 'flex';

    const media = document.createElement('div');
    media.className = 'courses-div-magk';
    media.setAttribute('data-media', '');
    if (image) {
      const img = document.createElement('img');
      img.className = 'courses-img-g9vg';
      img.src = image;
      img.alt = eProductsListingSafeText(product.title);
      img.loading = 'lazy';
      img.decoding = 'async';
      media.appendChild(img);
    } else {
      const placeholder = document.createElement('div');
      placeholder.className = 'e-products-image-placeholder';
      placeholder.textContent = 'Image';
      media.appendChild(placeholder);
    }

    if (meta.recommended) {
      const badge = document.createElement('span');
      badge.className = 'courses-span-1tzg hl-pick st-font-size-16px st-position-absolute';
      badge.setAttribute('data-pick-shine', '');
      badge.textContent = '阿良看过 · 才推荐';
      media.appendChild(badge);
    }
    if (meta.upcoming) {
      const badge = document.createElement('span');
      badge.className = 'courses-span-z9ux hl-tag-upcoming st-font-size-16px st-position-absolute';
      badge.setAttribute('data-upcoming-badge', '');
      badge.textContent = '即将上架';
      media.appendChild(badge);
    }

    const overlay = document.createElement('div');
    overlay.className = 'courses-div-i4m5 st-position-absolute';
    overlay.setAttribute('data-overlay', '');
    media.appendChild(overlay);

    const actions = document.createElement('div');
    actions.className = 'courses-div-z8td st-position-absolute';
    actions.setAttribute('data-actions', '');

    const viewButton = document.createElement('button');
    viewButton.type = 'button';
    viewButton.className = 'courses-button-18a0 hl-card-action st-height-40px st-width-40px';
    viewButton.setAttribute('aria-label', '查看' + title);
    viewButton.setAttribute('data-product-view', '');
    const eye = document.createElement('img');
    eye.className = 'courses-img-8epg';
    eye.src = root.dataset.eyeIcon;
    eye.alt = '';
    eye.loading = 'lazy';
    viewButton.appendChild(eye);
    actions.appendChild(viewButton);

    const wishlistButton = document.createElement('a');
    wishlistButton.href = '#';
    wishlistButton.className = 'courses-button-18a0 hl-card-action st-height-40px st-width-40px icon-wishlist-heart-empty wishlist-btn grid-wishlist-btn heart-wishlist-animation';
    wishlistButton.setAttribute('aria-label', '收藏' + title);
    wishlistButton.setAttribute('data-wishlist', '');
    wishlistButton.setAttribute('data-added', 'false');
    wishlistButton.setAttribute('data-proID', String(product.id));
    wishlistButton.setAttribute('data-varID', variant ? String(variant.id) : '');
    wishlistButton.setAttribute('data-button-layout', root.dataset.wishlistButtonLayout || 'simple_button');
    wishlistButton.setAttribute('data-product-wishlist', '');
    wishlistButton.setAttribute('data-product-id', String(product.id));
    wishlistButton.setAttribute('data-product-handle', handle);
    wishlistButton.setAttribute('data-product-title', title);
    const wishlistIconWrap = document.createElement('span');
    wishlistIconWrap.className = 'hulk_wl_icon-text';
    wishlistIconWrap.setAttribute('hulk-wl-custom-style', '');
    wishlistIconWrap.setAttribute('data-count', root.dataset.wishlistPublicCount || '0');
    const wishlistIcon = document.createElement('span');
    wishlistIcon.className = 'hulk_wl_icon';
    const wishlistHeart = document.createElement('i');
    wishlistHeart.className = 'heart-hulk-animation';
    const wishlistHeartIcon = document.createElement('i');
    wishlistHeartIcon.className = 'icon-wishlist-heart-empty';
    wishlistHeart.appendChild(wishlistHeartIcon);
    wishlistIcon.appendChild(wishlistHeart);
    const heartImage = document.createElement('img');
    heartImage.className = 'courses-img-6p9y';
    heartImage.src = root.dataset.wishlistIcon;
    heartImage.alt = '';
    heartImage.loading = 'lazy';
    wishlistIcon.appendChild(heartImage);
    wishlistIconWrap.appendChild(wishlistIcon);
    wishlistButton.appendChild(wishlistIconWrap);
    const wishlistCount = document.createElement('span');
    wishlistCount.className = 'count';
    wishlistCount.textContent = '(0)';
    wishlistButton.appendChild(wishlistCount);
    actions.appendChild(wishlistButton);

    const addButton = document.createElement('button');
    addButton.type = 'button';
    addButton.className = 'courses-button-1wyg st-font-size-16px st-height-44px';
    addButton.textContent = available ? '加入购物车' : '暂时缺货';
    addButton.disabled = !available;
    addButton.setAttribute('data-product-add', '');
    addButton.setAttribute('data-variant-id', variant ? String(variant.id) : '');
    actions.appendChild(addButton);
    media.appendChild(actions);
    const cardImage = media.querySelector('img');
    media.addEventListener('mouseenter', () => {
      if (cardImage) cardImage.style.transform = 'scale(1.035)';
      overlay.style.opacity = '1';
      actions.style.opacity = '1';
      actions.style.transform = 'translate(-50%, 0)';
    });
    media.addEventListener('mouseleave', () => {
      if (cardImage) cardImage.style.transform = 'none';
      overlay.style.opacity = '0';
      actions.style.opacity = '0';
      actions.style.transform = 'translate(-50%, 16px)';
    });
    article.appendChild(media);

    const content = document.createElement('div');
    content.className = 'courses-div-81gp st-flex-direction-column';
    const heading = document.createElement('h3');
    heading.className = 'courses-h3-1n6v st-font-size-28px';
    heading.textContent = title;
    content.appendChild(heading);

    const description = document.createElement('p');
    description.className = 'courses-p-je4d st-font-size-18px';
    description.textContent = eProductsListingSafeText(product.body_html || '').replace(/<[^>]*>/g, ' ').replace(/\s+/g, ' ').trim();
    content.appendChild(description);

    const priceWrap = document.createElement('div');
    priceWrap.className = 'courses-div-1asg st-margin-top-auto';
    const categoryLine = document.createElement('div');
    categoryLine.className = 'courses-div-o1zj st-font-size-16px';
    categoryLine.textContent = categoryNames[product.__category] || '';
    priceWrap.appendChild(categoryLine);

    const now = document.createElement('strong');
    now.className = 'courses-strong-v1uc hl-price-now st-font-size-24px';
    now.textContent = eProductsListingFormatMoney(price);
    priceWrap.appendChild(now);
    if (comparePrice && comparePrice > price) {
      const was = document.createElement('del');
      was.className = 'courses-del-4giz hl-price-was st-font-size-20px';
      was.textContent = eProductsListingFormatMoney(comparePrice);
      priceWrap.appendChild(was);
    }
    content.appendChild(priceWrap);
    article.appendChild(content);

    article.addEventListener('click', (event) => {
      if (event.target.closest('button, a')) return;
      window.location.href = url;
    });
    viewButton.addEventListener('click', () => { window.location.href = url; });
    addButton.addEventListener('click', (event) => {
      event.stopPropagation();
      if (!variant || !variant.id) return;
      if (typeof window.skAddToCart === 'function') {
        window.skAddToCart(variant.id, 1, addButton);
      } else {
        addButton.textContent = '购物车功能未载入';
      }
    });
    wishlistButton.addEventListener('click', (event) => {
      // Keep the click inside the card; the Hulk app's delegated handler consumes
      // its documented data-wishlist / data-proID / data-varID attributes.
      event.stopPropagation();
    });
    return article;
  }

  function eProductsListingRenderPager(totalItems) {
    const mobile = window.matchMedia('(max-width: 980px)').matches;
    const tablet = window.matchMedia('(max-width: 1240px)').matches;
    const perPage = mobile ? Math.max(totalItems, 1) : (tablet ? 10 : pageSize);
    const totalPages = Math.max(1, Math.ceil(totalItems / perPage));
    state.page = Math.min(Math.max(1, state.page), totalPages);
    const start = (state.page - 1) * perPage;
    const end = Math.min(start + perPage, totalItems);

    pageCurrent.textContent = String(state.page);
    pageTotal.textContent = String(totalPages);
    $$('[data-page-prev]').forEach((button) => { button.disabled = state.page <= 1; });
    $$('[data-page-next]').forEach((button) => { button.disabled = state.page >= totalPages; });
    pager.hidden = mobile || totalPages <= 1;
    pageNumbers.innerHTML = '';

    if (!mobile && totalPages > 1) {
      const maxButtons = Math.min(7, totalPages);
      let first = Math.max(1, state.page - Math.floor(maxButtons / 2));
      first = Math.min(first, Math.max(1, totalPages - maxButtons + 1));
      const last = Math.min(totalPages, first + maxButtons - 1);
      for (let page = first; page <= last; page += 1) {
        const button = document.createElement('button');
        button.type = 'button';
        button.className = 'courses-button-184e hl-page-btn st-font-size-16px st-width-48px st-height-48px';
        button.textContent = String(page);
        button.dataset.pageNumber = String(page);
        if (page === state.page) button.setAttribute('aria-current', 'page');
        pageNumbers.appendChild(button);
      }
    }
    return { perPage, start, end, totalPages };
  }

  function eProductsListingRender() {
    const products = eProductsListingGetFilteredProducts();
    const paging = eProductsListingRenderPager(products.length);
    const visible = products.slice(paging.start, paging.end);
    grid.innerHTML = '';
    visible.forEach((product) => {
      const card = eProductsListingCreateCard(product);
      grid.appendChild(card);
      window.requestAnimationFrame(() => {
        card.style.opacity = '1';
        card.style.transform = 'none';
      });
    });
    countNode.textContent = products.length + ' 件好品';
    emptyPanel.hidden = products.length > 0;
    endOfList.hidden = products.length === 0 || paging.totalPages > 1;
    loadingStatus.hidden = true;
  }

  function eProductsListingSetCategory(category) {
    state.activeCategory = category;
    state.page = 1;
    categoryButtons.forEach((button) => {
      const active = button.dataset.cat === category;
      button.setAttribute('aria-pressed', String(active));
      button.classList.toggle('is-active', active);
      button.style.background = active ? 'var(--hl-pink-hairline)' : 'transparent';
      button.style.color = active ? 'var(--hl-deep-orange)' : 'var(--hl-ink)';
    });
    if (window.innerWidth <= 980) eProductsListingOnCloseCategories();
    eProductsListingRender();
  }

  function eProductsListingSetSort(mode) {
    state.sort = mode;
    state.page = 1;
    sortButtons.forEach((button) => {
      const active = button.dataset.sortkey === mode;
      button.setAttribute('aria-pressed', String(active));
      button.style.background = active ? 'var(--hl-orange)' : '#fff';
      button.style.color = active ? '#fff' : 'var(--hl-ink)';
      button.style.boxShadow = 'inset 0 0 0 1px ' + (active ? 'var(--hl-orange)' : 'var(--hl-pink-hairline)');
    });
    const compact = $('[data-sort-compact]');
    if (compact) compact.value = mode;
    eProductsListingRender();
  }

  function eProductsListingSetPrice(mode) {
    state.price = mode;
    state.page = 1;
    const desktop = $('[data-price-sort]');
    const compact = $('[data-price-compact]');
    if (desktop) desktop.value = mode;
    if (compact) compact.value = mode;
    const toggle = $('[data-price-toggle]');
    if (toggle) {
      toggle.dataset.dir = mode === 'price-desc' ? 'desc' : (mode === 'price-asc' ? 'asc' : '');
      toggle.style.color = mode ? 'var(--hl-deep-orange)' : 'var(--hl-ink)';
    }
    [desktop, compact].forEach((select) => {
      if (!select) return;
      select.style.boxShadow = 'inset 0 0 0 1px ' + (mode ? 'var(--hl-orange)' : 'var(--hl-pink-hairline)');
      select.style.color = mode ? 'var(--hl-deep-orange)' : 'var(--hl-ink)';
    });
    eProductsListingRender();
  }

  function eProductsListingOnSearch(event) {
    state.search = event.target.value || '';
    state.page = 1;
    eProductsListingRender();
  }
  function eProductsListingOnCategoryClick(event) {
    const button = event.target.closest('[data-catnav]');
    if (button) eProductsListingSetCategory(button.dataset.cat);
  }
  function eProductsListingOnSortClick(event) {
    const button = event.target.closest('[data-sort]');
    if (button) eProductsListingSetSort(button.dataset.sortkey);
  }
  function eProductsListingOnPriceClick() {
    eProductsListingSetPrice(state.price === 'price-asc' ? 'price-desc' : 'price-asc');
  }
  function eProductsListingOnPagerClick(event) {
    const pageButton = event.target.closest('[data-page-number]');
    if (pageButton) {
      state.page = Number(pageButton.dataset.pageNumber) || 1;
      eProductsListingRender();
      root.scrollIntoView({ behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth', block: 'start' });
    }
  }
  function eProductsListingOnPrev() { state.page = Math.max(1, state.page - 1); eProductsListingRender(); }
  function eProductsListingOnNext() { state.page += 1; eProductsListingRender(); }
  function eProductsListingOnResize() { eProductsListingRender(); }
  function eProductsListingOnSortCompactChange(event) { eProductsListingSetSort(event.target.value); }
  function eProductsListingOnPriceSelectChange(event) { eProductsListingSetPrice(event.target.value); }
  function eProductsListingOnToggleCategories() {
    const aside = $('[data-filters]');
    const toggle = $('[data-cat-toggle]');
    const open = !aside.hasAttribute('data-open');
    if (open) aside.setAttribute('data-open', '');
    else aside.removeAttribute('data-open');
    toggle.setAttribute('aria-expanded', String(open));
  }
  function eProductsListingOnCloseCategories() {
    const aside = $('[data-filters]');
    const toggle = $('[data-cat-toggle]');
    aside.removeAttribute('data-open');
    toggle.setAttribute('aria-expanded', 'false');
  }
  function eProductsListingOnEscape(event) {
    if (event.key === 'Escape') eProductsListingOnCloseCategories();
  }

  const sortCompact = $('[data-sort-compact]');
  const priceSort = $('[data-price-sort]');
  const priceCompact = $('[data-price-compact]');
  const priceToggle = $('[data-price-toggle]');
  const catToggle = $('[data-cat-toggle]');
  const catClose = $('[data-cat-close]');
  const catScrim = $('[data-cat-scrim]');
  const catList = $('[data-cat-list]');
  const sortChips = $('[data-sort-bar-chips]');

  searchInput.addEventListener('input', eProductsListingOnSearch);
  catList.addEventListener('click', eProductsListingOnCategoryClick);
  sortChips.addEventListener('click', eProductsListingOnSortClick);
  sortCompact.addEventListener('change', eProductsListingOnSortCompactChange);
  priceSort.addEventListener('change', eProductsListingOnPriceSelectChange);
  priceCompact.addEventListener('change', eProductsListingOnPriceSelectChange);
  priceToggle.addEventListener('click', eProductsListingOnPriceClick);
  pager.addEventListener('click', eProductsListingOnPagerClick);
  $$('[data-page-prev]').forEach((button) => button.addEventListener('click', eProductsListingOnPrev));
  $$('[data-page-next]').forEach((button) => button.addEventListener('click', eProductsListingOnNext));
  catToggle.addEventListener('click', eProductsListingOnToggleCategories);
  catClose.addEventListener('click', eProductsListingOnCloseCategories);
  catScrim.addEventListener('click', eProductsListingOnCloseCategories);
  document.addEventListener('keydown', eProductsListingOnEscape);
  window.addEventListener('resize', eProductsListingOnResize);

  eProductsListingLoadProducts();

  const eProductsListingOnSectionUnload = (event) => {
    if (event.detail && event.detail.sectionId === root.dataset.sectionId) {
      root.__eProductsListingCleanup && root.__eProductsListingCleanup();
    }
  };
  root.__eProductsListingCleanup = () => {
    if (abortController) abortController.abort();
    document.removeEventListener('shopify:section:unload', eProductsListingOnSectionUnload);
    searchInput.removeEventListener('input', eProductsListingOnSearch);
    catList.removeEventListener('click', eProductsListingOnCategoryClick);
    sortChips.removeEventListener('click', eProductsListingOnSortClick);
    sortCompact.removeEventListener('change', eProductsListingOnSortCompactChange);
    priceSort.removeEventListener('change', eProductsListingOnPriceSelectChange);
    priceCompact.removeEventListener('change', eProductsListingOnPriceSelectChange);
    priceToggle.removeEventListener('click', eProductsListingOnPriceClick);
    catToggle.removeEventListener('click', eProductsListingOnToggleCategories);
    catClose.removeEventListener('click', eProductsListingOnCloseCategories);
    catScrim.removeEventListener('click', eProductsListingOnCloseCategories);
    document.removeEventListener('keydown', eProductsListingOnEscape);
    pager.removeEventListener('click', eProductsListingOnPagerClick);
    $$('[data-page-prev]').forEach((button) => button.removeEventListener('click', eProductsListingOnPrev));
    $$('[data-page-next]').forEach((button) => button.removeEventListener('click', eProductsListingOnNext));
    window.removeEventListener('resize', eProductsListingOnResize);
    root.dataset.initialized = 'false';
  };
  document.addEventListener('shopify:section:unload', eProductsListingOnSectionUnload);
})();
</script>

