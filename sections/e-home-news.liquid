{%- comment -%}
  Roctec homepage — News section
  Source: Claude standalone homepage export.
  CSS and JS are isolated to #e-home-news.
{%- endcomment -%}
<section id="e-home-news" class="news skpt-{{ section.settings.padding_top }} skpb-{{ section.settings.padding_bottom }}" data-section-id="{{ section.id }}">

  <div class="container">
    <div class="news-head-row">
      <div class="news-header">
        <span class="news-whisker">{{ section.settings.eyebrow | escape }}</span>
        <h2>{{ section.settings.heading | escape }}</h2>
        <p class="news-subtitle">{{ section.settings.subheading | escape }}</p>
      </div>
      {% if section.settings.button_label != blank %}<a class="btn btn-secondary" href="{{ section.settings.button_link | default: routes.root_url }}">{{ section.settings.button_label | escape }}</a>{% endif %}
    </div>
    <div class="news-featured-grid">
      <a class="news-featured-card" href="{{ section.settings.featured_link | default: routes.root_url }}">
        <div class="news-featured-img">
          {% if section.settings.featured_image != blank %}
            {{ section.settings.featured_image | image_url: width: 1200 | image_tag: loading: 'lazy', alt: section.settings.featured_alt, widths: '480, 720, 960, 1200' }}
          {% else %}
            <img src="{{ section.settings.featured_fallback | asset_url }}" alt="{{ section.settings.featured_alt | escape }}" loading="lazy">
          {% endif %}
        </div>
        <div class="news-featured-body">
          <p class="news-date">{{ section.settings.featured_date | escape }}</p>
          <h4>{{ section.settings.featured_title | escape }}</h4>
        </div>
      </a>
      <div class="news-side-stack">
        {% for block in section.blocks %}
          <a class="news-side-card" href="{{ block.settings.link | default: routes.root_url }}" {{ block.shopify_attributes }}>
            <div class="news-side-img">
              {% if block.settings.image != blank %}
                {{ block.settings.image | image_url: width: 640 | image_tag: loading: 'lazy', alt: block.settings.image_alt, widths: '240, 360, 480, 640' }}
              {% else %}
                <img src="{{ block.settings.fallback_asset | asset_url }}" alt="{{ block.settings.image_alt | escape }}" loading="lazy">
              {% endif %}
            </div>
            <div class="news-side-body">
              <p class="news-date">{{ block.settings.date | escape }}</p>
              <h6>{{ block.settings.title | escape }}</h6>
            </div>
          </a>
        {% endfor %}
      </div>
    </div>
  </div>

</section>

