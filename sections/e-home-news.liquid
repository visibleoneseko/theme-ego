<script>
(function() {
  var eHomeSelector = '#e-home-news[data-section-id="{{ section.id }}"]';
  function initEHomeNews() {
    var root = document.querySelector(eHomeSelector);
    if (!root || root.dataset.initialized === 'true') return;
    root.dataset.initialized = 'true';

    var revealTargets = root.querySelectorAll('.about-top, .about-stat-card, .news-head-row, .news-featured-card, .news-side-card, .solutions-head-row, .sol-tile, .rsvc-intro, .rsvc-carousel, .trust-ticker-header, .trust-ticker-logo');
    if ('IntersectionObserver' in window && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      var revealObserver = new IntersectionObserver(function(entries) {
        entries.forEach(function(entry) {
          if (entry.isIntersecting) { entry.target.classList.add('is-shown'); revealObserver.unobserve(entry.target); }
        });
      }, {threshold:0.12});
      revealTargets.forEach(function(el){el.classList.add('reveal-up');revealObserver.observe(el);});
      var oldCleanup = root.__eHomeCleanup;
      root.__eHomeCleanup = function(){revealObserver.disconnect();if(oldCleanup)oldCleanup();};
    } else {
      revealTargets.forEach(function(el){el.classList.add('is-shown');});
    }

  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', initEHomeNews, {once:true});
  else initEHomeNews();
  document.addEventListener('shopify:section:load', function(e) {
    if (e.target && e.target.querySelector && e.target.querySelector('#e-home-news')) {
      var node=e.target.querySelector('#e-home-news'); node.dataset.initialized='false'; initEHomeNews();
    }
  });
  document.addEventListener('shopify:section:unload', function(e) {
    if(e.target && e.target.querySelector) {var node=e.target.querySelector('#e-home-news');if(node && node.__eHomeCleanup)node.__eHomeCleanup();}
  });
})();
</script>


