{%- comment -%}
  e-home-news — "News & Authority" (Roctec homepage)
  Pulls the latest articles from the selected blog:
  1st article = large featured card, next 3 = stacked side cards.
{%- endcomment -%}
{%- liquid
  assign news_blog = section.settings.blog
  assign side_count = section.settings.side_count | default: 3
  assign total = side_count | plus: 1
-%}
<style>
#e-home-news {
  background: #FFFFFF;
  border-top: none;
}
#e-home-news .news-header .news-whisker {
  margin-bottom: 4px;
}
#e-home-news .news-header {
  display: flex;
  flex-direction: column;
  gap: var(--space-2);
}
#e-home-news .news-head-row {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: var(--space-8);
  margin-bottom: var(--head-gap);
}
#e-home-news .news-head-row .section-head {
  margin-bottom: 0;
}
#e-home-news .news-head-row .btn {
  flex-shrink: 0;
}
#e-home-news .news-whisker {
  letter-spacing: 0.14em;
  display: block;
  font-size: var(--text-base);
  font-weight: 600;
  text-transform: uppercase;
  color: var(--color-primary);
  margin-bottom: var(--space-2);
}
#e-home-news .news-header h2 {
  font-size: var(--text-h2);
  line-height: 1.15;
  letter-spacing: -0.02em;
  color: var(--color-text);
}
#e-home-news .news-subtitle {
  font-size: var(--text-lg);
  color: #3A3F3C;
  line-height: 1.6;
}
#e-home-news .news-featured-grid {
  display: grid;
  grid-template-columns: 6fr 5fr;
  padding-bottom: var(--space-8);
  gap: var(--space-8);
  align-items: start;
}
#e-home-news .news-date {
  font-size: var(--text-xs);
  font-weight: 500;
  text-transform: uppercase;
  color: rgba(17, 17, 17, 0.55);
  margin-bottom: var(--space-1);
}
#e-home-news .news-featured-card {
  display: block;
  text-decoration: none;
  color: inherit;
  transition: opacity var(--motion-base) var(--ease-standard);
}
#e-home-news .news-featured-card:hover .news-featured-img img {
  transform: scale(1.04);
}
#e-home-news .news-featured-card:hover h4 {
  color: var(--color-primary);
}
#e-home-news .news-featured-img {
  width: 100%;
  aspect-ratio: 3 / 2;
  overflow: hidden;
  background: #d9d9d9;
  margin-bottom: var(--space-3);
  border-radius: var(--radius-md);
}
#e-home-news .news-featured-img img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform var(--motion-slow) var(--ease-standard);
}
#e-home-news .news-featured-body h4 {
  font-size: var(--text-h4);
  font-weight: 600;
  line-height: 1.35;
  color: var(--color-text);
  margin-top: var(--space-1);
  transition: color var(--motion-base) var(--ease-standard);
}
#e-home-news .news-side-stack {
  display: flex;
  flex-direction: column;
  gap: var(--space-6);
}
#e-home-news .news-side-card {
  display: grid;
  grid-template-columns: 1fr 1.2fr;
  gap: var(--space-4);
  text-decoration: none;
  color: inherit;
  align-items: start;
  transition: opacity var(--motion-base) var(--ease-standard);
}
#e-home-news .news-side-card:hover .news-side-img img {
  transform: scale(1.04);
}
#e-home-news .news-side-card:hover h6 {
  color: var(--color-primary);
}
#e-home-news .news-side-img {
  width: 100%;
  aspect-ratio: 3 / 2;
  overflow: hidden;
  background: #d9d9d9;
  border-radius: var(--radius-md);
}
#e-home-news .news-side-img img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform var(--motion-slow) var(--ease-standard);
}
#e-home-news .news-side-body {
  padding-top: var(--space-2);
}
#e-home-news .news-side-body h6 {
  font-size: var(--text-h5);
  font-weight: 600;
  line-height: 1.45;
  color: var(--color-text);
  transition: color var(--motion-base) var(--ease-standard);
}
@media (max-width: 767px) {
  #e-home-news .news-head-row {
    flex-wrap: wrap;
    gap: var(--space-5);
  }
  #e-home-news .news-head-row .news-header {
    margin-bottom: 0;
  }
  #e-home-news .news-head-row .btn {
    margin-left: 0;
  }
  #e-home-news .news-featured-grid {
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-8);
  }
  #e-home-news .news-featured-body h4 {
    font-size: var(--text-h5);
  }
  #e-home-news .news-side-stack {
    border-top: 1px solid var(--color-border);
    padding-top: var(--space-8);
  }
  #e-home-news .news-side-card {
    grid-template-columns: 120px 1fr;
  }
}
@media (max-width: 400px) {
  #e-home-news .news-side-card {
    grid-template-columns: 100px 1fr;
  }
}
#e-home-news .news-featured-img .placeholder-svg,
#e-home-news .news-side-img .placeholder-svg {
  width: 100%;
  height: 100%;
  fill: rgba(17, 17, 17, 0.25);
}
</style>

<section
  id="e-home-news"
  class="e-home-news news skpt-{{ section.settings.padding_top }} skpb-{{ section.settings.padding_bottom }}"
>
  <div class="container" data-sk-reveal>
    <div class="news-head-row">
      <div class="news-header">
        {%- if section.settings.eyebrow != blank -%}
          <span class="news-whisker">{{ section.settings.eyebrow | escape }}</span>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2>{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.subtitle != blank -%}
          <p class="news-subtitle">{{ section.settings.subtitle | escape }}</p>
        {%- endif -%}
      </div>
      {%- if section.settings.button_label != blank -%}
        {%- assign view_all = section.settings.button_link | default: news_blog.url | default: '#' -%}
        <a class="btn btn-secondary" href="{{ view_all }}">{{ section.settings.button_label | escape }}</a>
      {%- endif -%}
    </div>

    {%- if news_blog != blank and news_blog.articles_count > 0 -%}
      <div class="news-featured-grid">
        {%- for article in news_blog.articles limit: total -%}
          {%- if forloop.first -%}
            <!-- Featured (large) card — left -->
            <a class="news-featured-card" href="{{ article.url }}">
              <div class="news-featured-img">
                {%- if article.image -%}
                  {%- assign img_alt = article.image.alt | default: article.title -%}
                  {{ article.image | image_url: width: 1400 | image_tag: widths: '500, 700, 900, 1100, 1400', sizes: '(max-width: 767px) 100vw, 55vw', loading: 'lazy', alt: img_alt }}
                {%- else -%}
                  {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
                {%- endif -%}
              </div>
              <div class="news-featured-body">
                <p class="news-date">{{ article.published_at | date: '%B %-d, %Y' }}</p>
                <h4>{{ article.title | escape }}</h4>
              </div>
            </a>
            {%- unless forloop.last -%}
              <!-- Stacked smaller cards — right -->
              <div class="news-side-stack">
            {%- endunless -%}
          {%- else -%}
                <a class="news-side-card" href="{{ article.url }}">
                  <div class="news-side-img">
                    {%- if article.image -%}
                      {%- assign img_alt = article.image.alt | default: article.title -%}
                      {{ article.image | image_url: width: 640 | image_tag: widths: '240, 320, 480, 640', sizes: '(max-width: 767px) 120px, 22vw', loading: 'lazy', alt: img_alt }}
                    {%- else -%}
                      {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
                    {%- endif -%}
                  </div>
                  <div class="news-side-body">
                    <p class="news-date">{{ article.published_at | date: '%B %-d, %Y' }}</p>
                    <h6>{{ article.title | escape }}</h6>
                  </div>
                </a>
            {%- if forloop.last -%}
              </div>
            {%- endif -%}
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- else -%}
      {%- comment -%} Editor preview until a blog with articles is selected {%- endcomment -%}
      <div class="news-featured-grid">
        <div class="news-featured-card">
          <div class="news-featured-img">{{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}</div>
          <div class="news-featured-body">
            <p class="news-date">{{ 'now' | date: '%B %-d, %Y' }}</p>
            <h4>Select a blog in the section settings</h4>
          </div>
        </div>
        <div class="news-side-stack">
          {%- for i in (1..side_count) -%}
            <div class="news-side-card">
              <div class="news-side-img">{{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}</div>
              <div class="news-side-body">
                <p class="news-date">{{ 'now' | date: '%B %-d, %Y' }}</p>
                <h6>Article title</h6>
              </div>
            </div>
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Home – News",
  "settings": [
    {
      "type": "select",
      "id": "padding_top",
      "label": "Padding Top",
      "options": [
        { "value": "0", "label": "0" },
        { "value": "xs", "label": "xs" },
        { "value": "sm", "label": "sm" },
        { "value": "md", "label": "md" },
        { "value": "lg", "label": "lg" },
        { "value": "xl", "label": "xl" }
      ],
      "default": "lg"
    },
    {
      "type": "select",
      "id": "padding_bottom",
      "label": "Padding Bottom",
      "options": [
        { "value": "0", "label": "0" },
        { "value": "xs", "label": "xs" },
        { "value": "sm", "label": "sm" },
        { "value": "md", "label": "md" },
        { "value": "lg", "label": "lg" },
        { "value": "xl", "label": "xl" }
      ],
      "default": "lg"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "NEWS & AUTHORITY"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Recent Milestones, Ongoing Recognition"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Industry recognition and new partnerships, updated as Roctec's work continues to grow."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "View All News"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link",
      "info": "Leave empty to link to the selected blog."
    },
    {
      "type": "header",
      "content": "Articles"
    },
    {
      "type": "blog",
      "id": "blog",
      "label": "Blog",
      "info": "Newest article becomes the large card; the next ones fill the side list."
    },
    {
      "type": "range",
      "id": "side_count",
      "label": "Side articles",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 3
    }
  ],
  "presets": [
    {
      "name": "Home – News"
    }
  ]
}
{% endschema %}
