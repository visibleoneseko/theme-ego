{%- style -%}
  /* Shared & Specific Styles */
  .d-account-header {
    background: var(--white-color);
    border-radius: 12px;
    box-shadow: 0 4px 20px rgba(0,0,0,0.05);
  }
  .sk-info-item {
    padding: 12px 0;
  }
  .sk-info-icon {
    width: 24px;
    height: 24px;
    color: var(--gray-color);
    flex-shrink: 0;
  }
  .sk-address-card {
    background: var(--white-color);
    border-radius: 12px;
  }
  .avatar-circle {
    width: 60px;
    height: 60px;
    border-radius: 50%;
    background-color: var(--blue-color);
    color: white;
  }
  .sk-edit-btn {
    border-radius: 25px !important;
    padding: 12px 35px !important;
    font-size: 16px;
    cursor: pointer;
  }
{%- endstyle -%}

<section class="d-account-details-section skpt-lg skpb-lg">
  <div class="container">
    
    <div class="d-account-header skp-sm skmb-md d-flex justify-content-between align-items-center">
      <div class="d-flex align-items-center gap-20">
        <div class="avatar-circle flex-center">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
        </div>
        <div>
          <h2 class="fs-h4 skfwn skmb-0 text-black">{{ customer.name }}</h2>
          <p class="fs-14 text-gray skmb-0">Member since {{ customer.created_at | date: "%B %Y" }}</p>
        </div>
      </div>
      <a href="{{ routes.account_logout_url }}" class="text-red d-flex align-items-center gap-10 skfwb" style="text-decoration: none;">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path><polyline points="16 17 21 12 16 7"></polyline><line x1="21" y1="12" x2="9" y2="12"></line></svg>
        Logout
      </a>
    </div>

    <div class="sk-tabs d-flex gap-40 skmb-md" style="border-bottom: 1px solid #eee;">
      <a href="/account" class="sk-tab-btn fs-16 skfwn text-gray d-flex align-items-center gap-10" style="padding-bottom: 10px; text-decoration: none;">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path><polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline><line x1="12" y1="22.08" x2="12" y2="12"></line></svg>
        Order History
      </a>
      <a href="/account/addresses" class="sk-tab-btn active fs-16 skfwb text-blue d-flex align-items-center gap-10" style="padding-bottom: 10px; border-bottom: 2px solid var(--blue-color); text-decoration: none;">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
        Account Details
      </a>
    </div>

    <div class="sk-address-card skp-xs">
      
      <div class="skmb-md">
        <h3 class="fs-h5 skfwb skmb-sm text-black">{{ section.settings.personal_title }}</h3>
        
        <div class="d-flex flex-column gap-10">
          <div class="sk-info-item d-flex align-items-start gap-20">
            <div class="sk-info-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg></div>
            <div>
              <p class="fs-14 skfwb skmb-0 text-black">Full Name</p>
              <p class="fs-16 skfwn skmb-0 text-gray">{{ customer.name }}</p>
            </div>
          </div>

          <div class="sk-info-item d-flex align-items-start gap-20">
            <div class="sk-info-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg></div>
            <div>
              <p class="fs-14 skfwb skmb-0 text-black">Email Address</p>
              <p class="fs-16 skfwn skmb-0 text-gray">{{ customer.email }}</p>
            </div>
          </div>

          <div class="sk-info-item d-flex align-items-start gap-20">
            <div class="sk-info-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg></div>
            <div>
              <p class="fs-14 skfwb skmb-0 text-black">Phone Number</p>
              <p class="fs-16 skfwn skmb-0 text-gray">{{ customer.phone | default: 'Not provided' }}</p>
            </div>
          </div>
        </div>
      </div>

      <hr style="border: none; border-top: 1px solid #eee; margin: 30px 0;">

      <div class="skmb-md">
        <h3 class="fs-h5 skfwb skmb-sm text-black">{{ section.settings.address_title }}</h3>
        <div class="sk-info-item d-flex align-items-start gap-20">
          <div class="sk-info-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg></div>
          <div>
            {% if customer.default_address %}
              <p class="fs-16 skfwn skmb-0 text-gray">
                {{ customer.default_address.address1 }} {{ customer.default_address.address2 }}<br>
                {{ customer.default_address.city }}, {{ customer.default_address.province_code }} {{ customer.default_address.zip }}
              </p>
            {% else %}
              <p class="fs-16 skfwn skmb-0 text-gray">No default address saved.</p>
            {% endif %}
          </div>
        </div>
      </div>

      <div class="skmt-md">
        <a href="/account/addresses" class="skbtn bg-black text-white sk-edit-btn d-inline-block text-center">
          Edit Account Details
        </a>
      </div>

    </div>

  </div>
</section>

{% schema %}
{
  "name": "d-myaccount-addresses",
  "class": "d-myaccount-addresses",
  "settings": [
    {
      "type": "text",
      "id": "personal_title",
      "label": "Personal Info Heading",
      "default": "Personal Information"
    },
    {
      "type": "text",
      "id": "address_title",
      "label": "Address Heading",
      "default": "Shipping Address"
    }
  ],
  "presets": [
    {
      "name": "d-myaccount-addresses"
    }
  ]
}
{% endschema %}