{%- assign collection = section.settings.main_collection -%}
{%- assign product_limit = section.settings.product_limit -%}

<section class="{{ section.settings.padding_top }} {{ section.settings.padding_bottom }}" id="section-{{ section.id }}">
  <div class="container-lg">
    
    {% if section.settings.heading != blank or collection.title != blank %}
    <div class="row skmb-md">
      <div class="col-12 text-center">
        <h2 class="fs-h2 text-blue skfwb">
          {{ section.settings.heading | default: collection.title }}
        </h2>
      </div>
    </div>
    {% endif %}

    <div class="d-grid gap-20" style="flex-wrap: wrap;">
      {% for product in collection.products limit: product_limit %}
        <div class="col-3 col-md-6 col-sm-12">
          <div class="product-card">
            <div class="hoverhideshow bg-smoke">
              <a href="{{ product.url }}">
                <img src="{{ product.featured_image | image_url: width: 600 }}" 
                     alt="{{ product.title | escape }}" 
                     class="w-100 d-block"
                     loading="lazy">
              </a>

              <button type="button" 
                      class="quick-view-trigger text-white bg-black flex-center" 
                      data-product-handle="{{ product.handle }}">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>
              </button>
            </div>

            <div class="skmt-15">
              <h3 class="fs-h6 text-black skfwn skmb-0">{{ product.title }}</h3>
              <p class="fs-14 text-gray skmt-0 skmb-0">{{ product.vendor }}</p>
                <p class="fs-16 text-blue skfwb">
                  {{ product.price | money }}
                </p>                
                {% comment %} Quick Add Button for Grid {% endcomment %}
                {% if product.available %}
                  <button class="sk-ajax-add skbtn-main skp-xs skmt-0" 
                          data-variant-id="{{ product.first_available_variant.id }}"
                    >
                    Add to Cart
                  </button>
                {% endif %}
            </div>
          </div>
        </div>
      {% endfor %}
    </div>

    {% comment %} Dynamic View All Button {% endcomment %}
    {% if section.settings.show_view_all and collection.products_count > product_limit %}
      <div class="row skmt-lg">
        <div class="col-12 text-center">
          <a href="{{ collection.url }}" class="skbtn text-black skp-15 skfwb">
            View All
          </a>
        </div>
      </div>
    {% endif %}

  </div>
</section>

{% comment %} Quick View Modal {% endcomment %}
<div id="skQuickViewModal" class="skqv-modal hide">
    <div class="skqv-modal-overlay"></div>
    <div class="skqv-modal-content bg-white skp-md">
      <button class="skqv-modal-close text-black fs-h4">&times;</button>
      <div id="skQuickViewData" class="d-flex align-items-center gap-40 flex-wrap">
        {% comment %} AJAX Content Loaded Here {% endcomment %}
      </div>
    </div>
</div>

<style>
/* CSS Styles */
.quick-view-trigger { position: absolute; top: 15px; right: 15px; width: 40px; height: 40px; border-radius: 50%; opacity: 0; border: none; cursor: pointer; transition: var(--transition); z-index: 5; }
.hoverhideshow:hover .quick-view-trigger { opacity: 1; }
.quick-view-trigger:hover { background-color: var(--blue-color); }

.skqv-modal { position: fixed; top: 0; left: 0; width: 100%; height: 100%; z-index: 10000; display: flex; align-items: center; justify-content: center; transition: all 0.3s ease; }
.skqv-modal.hide { opacity: 0; visibility: hidden; pointer-events: none; }
.skqv-modal.show { opacity: 1; visibility: visible; pointer-events: auto; }
.skqv-modal-overlay { position: absolute; width: 100%; height: 100%; background: rgba(0,0,0,0.8); }
.skqv-modal-content { position: relative; width: 95%; max-width: 850px; border-radius: 8px; transform: translateY(30px); transition: transform 0.4s ease; z-index: 10001; } 
.skqv-modal.show .skqv-modal-content { transform: translateY(0); }
.skqv-modal-close { position: absolute; top: 10px; right: 15px; background: none; border: none; cursor: pointer; z-index: 10; font-weight: bold; }

.sk-qty-input { width: 60px; height: 45px; text-align: center; border: 1px solid #ddd; border-radius: 4px; }
.sk-ajax-add.loading { opacity: 0.5; pointer-events: none; }
.product-card img { aspect-ratio: 1 / 1; object-fit: cover; object-position: center;}
@media (max-width: 767px) {
    #skQuickViewData { flex-direction: column; }
    .skqv-modal-content { padding: 20px; }
}
</style>

<script>
// 1. Core Add to Cart Logic
async function addToCart(variantId, qty = 1, buttonElement) {
    if (!variantId) return;
    
    buttonElement.classList.add('loading');
    const originalText = buttonElement.innerText;
    buttonElement.innerText = 'Adding...';

    const formData = { 'items': [{ 'id': variantId, 'quantity': qty }] };

    try {
        const response = await fetch('/cart/add.js', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(formData)
        });

        if (response.ok) {
            buttonElement.innerText = 'Added!';
            buttonElement.classList.replace('bg-blue', 'bg-green');
            
            // Trigger Shopify's native cart drawer if your theme has one
            document.documentElement.dispatchEvent(new CustomEvent('cart:refresh', { bubbles: true }));
            
            setTimeout(() => {
                buttonElement.innerText = originalText;
                buttonElement.classList.replace('bg-green', 'bg-blue');
                buttonElement.classList.remove('loading');
            }, 2000);
        }
    } catch (error) {
        console.error('Error adding to cart:', error);
        buttonElement.innerText = 'Error';
    }
}

// 2. Initialize Quick View and Listeners
function initCollectionFeatures() {
    const modal = document.getElementById('skQuickViewModal');
    const contentArea = document.getElementById('skQuickViewData');
    if (!modal) return;

    // Grid Add to Cart
    document.querySelectorAll('.sk-ajax-add').forEach(btn => {
        btn.addEventListener('click', (e) => {
            e.preventDefault();
            addToCart(btn.dataset.variantId, 1, btn);
        });
    });

    // Quick View Trigger
    document.querySelectorAll('.quick-view-trigger').forEach(button => {
        button.addEventListener('click', async () => {
            const handle = button.getAttribute('data-product-handle');
            contentArea.innerHTML = '<div class="text-center w-100 skp-lg">Loading...</div>';
            modal.classList.remove('hide');
            modal.classList.add('show');

            try {
                const response = await fetch(`/products/${handle}.js`);
                const product = await response.json();
                
                contentArea.innerHTML = `
                  <div class="col-6 col-sm-12">
                    <img src="${product.featured_image}" class="w-100 bg-smoke skp-15" style="border-radius:8px;">
                  </div>
                  <div class="col-6 col-sm-12">
                    <h2 class="fs-h3 text-blue skfwb skmb-0">${product.title}</h2>
                    <p class="fs-14 text-gray skmt-0 skmb-15">${product.vendor}</p>
                    <div class="fs-h4 text-blue skmb-15">${(product.price / 100).toLocaleString('en-US', { style: 'currency', currency: 'USD' })}</div>
                    <div class="fs-h4 text-black skmb-15">
                    ${product.description}
                    </div>
                    <div class="d-flex gap-10 skmb-15">
                        <input type="number" id="modal-qty" class="sk-qty-input d-none" value="1" min="1">
                        <button class="skbtn-main flex-center w-100 skmt-0 modal-add-btn" 
                                data-variant-id="${product.variants[0].id}">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="9" cy="21" r="1"></circle><circle cx="20" cy="21" r="1"></circle>
                <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
              </svg>  <span class="skpl-15">Add to Cart</span>
                        </button>
                    </div>
                    <a href="${product.url}" class="text-black fs-14 text-center d-block" style="text-decoration: none;">View full details > </a>
                  </div>
                `;

                // Listener for Modal Add Button
                contentArea.querySelector('.modal-add-btn').addEventListener('click', (e) => {
                    const qty = document.getElementById('modal-qty').value;
                    addToCart(e.target.dataset.variantId, qty, e.target);
                });

            } catch (err) { contentArea.innerHTML = "Error loading product."; }
        });
    });

    // Close Modal Logic
    const closeMD = () => { modal.classList.add('hide'); modal.classList.remove('show'); };
    modal.querySelector('.skqv-modal-close').addEventListener('click', closeMD);
    modal.querySelector('.skqv-modal-overlay').addEventListener('click', closeMD);
}

document.addEventListener('DOMContentLoaded', initCollectionFeatures);
document.addEventListener('shopify:section:load', initCollectionFeatures);
</script>

{% schema %}
{
  "name": "d-home-collection",
  "settings": [
    { "type": "select", "id": "padding_top", "label": "Padding Top", "options": [ { "value": "skpt-lg", "label": "Large" }, { "value": "skpt-md", "label": "Medium" } ], "default": "skpt-lg" },
    { "type": "select", "id": "padding_bottom", "label": "Padding Bottom", "options": [ { "value": "skpb-lg", "label": "Large" }, { "value": "skpb-md", "label": "Medium" } ], "default": "skpb-lg" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "collection", "id": "main_collection", "label": "Collection" },
    { "type": "range", "id": "product_limit", "min": 4, "max": 12, "step": 1, "label": "Products", "default": 4 },
    { "type": "checkbox", "id": "show_view_all", "label": "Show View All", "default": true }
  ],
  "presets": [{ "name": "d-home-collection" }]
}
{% endschema %}