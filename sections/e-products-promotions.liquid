<script>
(() => {
  const sectionId = 'e-products-promotions';
  const root = document.getElementById(sectionId);
  if (!root || root.dataset.initialized === 'true') return;

  const banner = root.querySelector('[data-banner]');
  if (!banner) return;

  const slides = Array.from(banner.querySelectorAll('[data-banner-slide]'));
  const dots = Array.from(banner.querySelectorAll('[data-banner-dot]'));
  const previous = banner.querySelector('[data-banner-prev]');
  const next = banner.querySelector('[data-banner-next]');
  if (!slides.length) return;

  root.dataset.initialized = 'true';
  let index = 0;
  let timer = null;
  let pointerStart = null;
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const mobile = window.matchMedia('(max-width: 767px)');
  const interval = Math.max(2500, Number(banner.dataset.interval) || 5200);

  const eProductsPromoPaint = () => {
    slides.forEach((slide, i) => {
      const active = i === index;
      slide.style.opacity = active ? '1' : '0';
      slide.setAttribute('aria-hidden', String(!active));
      slide.style.pointerEvents = active ? 'auto' : 'none';
      if (mobile.matches) {
        slide.style.transform = `translate3d(${(i - index) * 100}%,0,0)`;
      } else {
        slide.style.transform = '';
      }
    });
    dots.forEach((dot, i) => {
      const active = i === index;
      dot.style.width = active ? '31px' : '9px';
      dot.style.background = active ? 'var(--hl-bright-orange)' : 'var(--hl-salmon)';
      dot.setAttribute('aria-current', active ? 'true' : 'false');
    });
  };

  const eProductsPromoStop = () => { if (timer) window.clearInterval(timer); timer = null; };
  const eProductsPromoStart = () => {
    eProductsPromoStop();
    if (reduceMotion || banner.dataset.autoplay !== 'true' || slides.length < 2) return;
    timer = window.setInterval(() => { index = (index + 1) % slides.length; eProductsPromoPaint(); }, interval);
  };
  const eProductsPromoGo = (nextIndex) => {
    index = (nextIndex + slides.length) % slides.length;
    eProductsPromoPaint();
    eProductsPromoStart();
  };
  const eProductsPromoOnPrevious = () => eProductsPromoGo(index - 1);
  const eProductsPromoOnNext = () => eProductsPromoGo(index + 1);
  const eProductsPromoOnDot = (event) => {
    const dot = event.target.closest('[data-banner-dot]');
    if (!dot) return;
    eProductsPromoGo(dots.indexOf(dot));
  };
  const eProductsPromoOnEnter = () => eProductsPromoStop();
  const eProductsPromoOnLeave = () => eProductsPromoStart();
  const eProductsPromoOnPointerDown = (event) => { pointerStart = event.clientX; eProductsPromoStop(); };
  const eProductsPromoOnPointerUp = (event) => {
    if (pointerStart === null) return;
    const delta = event.clientX - pointerStart;
    pointerStart = null;
    if (Math.abs(delta) > 45) eProductsPromoGo(index + (delta < 0 ? 1 : -1));
    else eProductsPromoStart();
  };
  const eProductsPromoOnResize = () => eProductsPromoPaint();

  previous && previous.addEventListener('click', eProductsPromoOnPrevious);
  next && next.addEventListener('click', eProductsPromoOnNext);
  banner.addEventListener('click', eProductsPromoOnDot);
  banner.addEventListener('mouseenter', eProductsPromoOnEnter);
  banner.addEventListener('mouseleave', eProductsPromoOnLeave);
  banner.addEventListener('pointerdown', eProductsPromoOnPointerDown, { passive: true });
  banner.addEventListener('pointerup', eProductsPromoOnPointerUp, { passive: true });
  banner.addEventListener('pointercancel', eProductsPromoOnPointerUp, { passive: true });
  mobile.addEventListener ? mobile.addEventListener('change', eProductsPromoOnResize) : mobile.addListener(eProductsPromoOnResize);

  eProductsPromoPaint();
  eProductsPromoStart();

  const eProductsPromoOnSectionUnload = (event) => {
    if (event.detail && event.detail.sectionId === root.dataset.sectionId) {
      root.__eProductsPromoCleanup && root.__eProductsPromoCleanup();
    }
  };
  root.__eProductsPromoCleanup = () => {
    eProductsPromoStop();
    document.removeEventListener('shopify:section:unload', eProductsPromoOnSectionUnload);
    previous && previous.removeEventListener('click', eProductsPromoOnPrevious);
    next && next.removeEventListener('click', eProductsPromoOnNext);
    banner.removeEventListener('click', eProductsPromoOnDot);
    banner.removeEventListener('mouseenter', eProductsPromoOnEnter);
    banner.removeEventListener('mouseleave', eProductsPromoOnLeave);
    banner.removeEventListener('pointerdown', eProductsPromoOnPointerDown);
    banner.removeEventListener('pointerup', eProductsPromoOnPointerUp);
    banner.removeEventListener('pointercancel', eProductsPromoOnPointerUp);
    mobile.removeEventListener ? mobile.removeEventListener('change', eProductsPromoOnResize) : mobile.removeListener(eProductsPromoOnResize);
    root.dataset.initialized = 'false';
  };

  document.addEventListener('shopify:section:unload', eProductsPromoOnSectionUnload);
})();
</script>

