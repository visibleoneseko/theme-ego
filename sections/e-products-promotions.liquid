<section
  id="e-products-promotions"
  class="promotions-section-1vde skpt-{{ section.settings.padding_top }} skpb-{{ section.settings.padding_bottom }}"
  data-screen-label="Promotions"
  data-section-id="{{ section.id }}"
>
  <div class="promotions-div-19n0">
    <div
      class="promotions-div-xclg"
      data-banner
      data-autoplay="{{ section.settings.autoplay }}"
      data-interval="{{ section.settings.autoplay_speed | times: 1000 }}"
      style="touch-action: pan-y;"
    >
      {% if section.settings.eyebrow_tag != blank %}
        <span class="promotions-span-hj0v hl-tag-new st-font-size-17px st-position-absolute st-border-radius-1000px" data-newtag>
          {{ section.settings.eyebrow_tag | escape }}
        </span>
      {% endif %}

      {% for block in section.blocks %}
        <div
          class="{% if forloop.first %}promotions-div-1k97{% else %}promotions-div-10cq{% endif %} st-position-absolute"
          data-banner-slide
          {% unless forloop.first %}style="opacity: 0;"{% endunless %}
          {{ block.shopify_attributes }}
        >
          {% if block.settings.image != blank %}
            <img
              alt="{{ block.settings.image.alt | default: block.settings.eyebrow | escape }}"
              class="promotions-img-pui6 st-position-absolute"
              decoding="async"
              loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
              width="{{ block.settings.image.width }}"
              height="{{ block.settings.image.height }}"
              src="{{ block.settings.image | image_url: width: 1800 }}"
              srcset="
                {{ block.settings.image | image_url: width: 750 }} 750w,
                {{ block.settings.image | image_url: width: 1100 }} 1100w,
                {{ block.settings.image | image_url: width: 1500 }} 1500w,
                {{ block.settings.image | image_url: width: 1800 }} 1800w
              "
              sizes="(max-width: 767px) 100vw, 1560px"
            >
          {% else %}
            {% assign fallback_image = block.settings.fallback_image | default: 'pick-banner-monthly.webp' %}
            <img
              alt="{{ block.settings.eyebrow | escape }}"
              class="promotions-img-pui6 st-position-absolute"
              decoding="async"
              loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
              src="{{ fallback_image | asset_url }}"
              width="1800"
              height="720"
            >
          {% endif %}

          <div class="promotions-div-fpmm st-flex-direction-column">
            {% if block.settings.eyebrow != blank %}
              <p class="promotions-p-17qw st-font-size-16px" data-hero-eyebrow>{{ block.settings.eyebrow | escape }}</p>
            {% endif %}
            <h3 class="promotions-h3-710e st-font-size-44px st-max-width-820px">
              {{ block.settings.heading | escape | newline_to_br }}
            </h3>
            {% if block.settings.description != blank %}
              <p class="promotions-p-ao4e st-font-size-18px">{{ block.settings.description | escape }}</p>
            {% endif %}
            {% if block.settings.button_label != blank %}
              <div class="promotions-div-130p">
                <a class="header-a-12vk hl-pill st-font-size-16px st-height-52px st-border-radius-1000px" href="{{ block.settings.link | default: '#e-products-listing' }}">
                  {{ block.settings.button_label | escape }}
                </a>
              </div>
            {% endif %}
          </div>
        </div>
      {% endfor %}

      {% if section.blocks.size > 1 %}
        <button aria-label="上一张" class="promotions-button-1guj hl-arrow st-width-48px st-position-absolute st-height-48px st-border-radius-1000px" data-banner-prev data-navi type="button">
          <svg aria-hidden="true" class="promotions-svg-1qo9" data-dir="prev" fill="none" height="24" viewBox="0 0 24 24" width="24">
            <path clip-rule="evenodd" d="M8.2929 3.29289C7.9024 3.68342 7.9024 4.31658 8.2929 4.70711L15.5858 12L8.2929 19.2929C7.9024 19.6834 7.9024 20.3166 8.2929 20.7071C8.6834 21.0976 9.3166 21.0976 9.7071 20.7071L17.7071 12.7071C18.0976 12.3166 18.0976 11.6834 17.7071 11.2929L9.7071 3.29289C9.3166 2.90237 8.6834 2.90237 8.2929 3.29289Z" fill="currentColor" fill-rule="evenodd"/>
          </svg>
        </button>
        <button aria-label="下一张" class="promotions-button-1o4m hl-arrow st-width-48px st-position-absolute st-height-48px st-border-radius-1000px" data-banner-next data-navi type="button">
          <svg aria-hidden="true" class="promotions-svg-1qo9" data-dir="next" fill="none" height="24" viewBox="0 0 24 24" width="24">
            <path clip-rule="evenodd" d="M8.2929 3.29289C7.9024 3.68342 7.9024 4.31658 8.2929 4.70711L15.5858 12L8.2929 19.2929C7.9024 19.6834 7.9024 20.3166 8.2929 20.7071C8.6834 21.0976 9.3166 21.0976 9.7071 20.7071L17.7071 12.7071C18.0976 12.3166 18.0976 11.6834 17.7071 11.2929L9.7071 3.29289C9.3166 2.90237 8.6834 2.90237 8.2929 3.29289Z" fill="currentColor" fill-rule="evenodd"/>
          </svg>
        </button>
        <div class="promotions-div-1g1y st-position-absolute" data-banner-dots>
          {% for block in section.blocks %}
            <button
              aria-label="第 {{ forloop.index }} 张"
              class="{% if forloop.first %}promotions-button-1rqj{% else %}promotions-button-l1gz{% endif %} hl-dot"
              data-banner-dot
              type="button"
            ></button>
          {% endfor %}
        </div>
      {% endif %}
    </div>
  </div>
</section>

