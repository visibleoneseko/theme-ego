{% comment %}
  Shopify Liquid Section: Most Popular Products with Quick View
{% endcomment %}

<section class="skpt-lg skpb-lg" id="section-{{ section.id }}">
  <div class="container-lg">
    
    {% if section.settings.heading != blank %}
      <div class="row skmb-md">
        <div class="col-12 text-center">
          <h2 class="fs-h2 text-blue skfwb">{{ section.settings.heading }}</h2>
        </div>
      </div>
    {% endif %}

    <div class="d-grid gap-30">
      {% for block in section.blocks %}
        {% assign product_ref = block.settings.product %}
        
        <div class="col-3 col-md-6 col-sm-12" {{ block.shopify_attributes }}>
          <div class="product-card">
            
            <div class="hoverhideshow bg-smoke skp-15">
              <a href="{{ product_ref.url | default: '#' }}">
                {% if product_ref.featured_image != blank %}
                  <img src="{{ product_ref.featured_image | image_url: width: 600 }}" 
                       alt="{{ product_ref.title | escape }}" 
                       class="w-100 d-block"
                       loading="lazy">
                {% else %}
                  {{ 'product-1' | placeholder_svg_tag: 'w-100 bg-gray' }}
                {% endif %}
              </a>

              {% comment %} Quick View Trigger {% endcomment %}
              {% if product_ref != blank %}
                <button type="button" 
                        class="quick-view-trigger text-white bg-black flex-center" 
                        data-product-handle="{{ product_ref.handle }}"
                        aria-label="Quick View">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>
                </button>
              {% endif %}
            </div>

            <div class="skmt-15">
              <h3 class="fs-h6 text-black skfwn skmb-0">{{ product_ref.title | default: "Product Title" }}</h3>
              <p class="fs-14 text-gray skmt-0 skmb-0">{{ block.settings.sub_text }}</p>

              <div class="skmt-15">
                <span class="fs-16 text-blue skfwb">
                  {{ product_ref.price | default: 540000 | money }}
                </span>
              </div>
            </div>
          </div>
        </div>
      {% endfor %}
    </div>
  </div>

  {% comment %} Modal Structure {% endcomment %}
  <div id="skQuickViewModal" class="sk-modal hide">
    <div class="sk-modal-overlay"></div>
    <div class="sk-modal-content bg-white skp-md">
      <button class="sk-modal-close text-black fs-h4">&times;</button>
      <div id="skQuickViewData" class="d-flex align-items-center gap-40">
        {% comment %} AJAX Content Loaded Here {% endcomment %}
      </div>
    </div>
  </div>
</section>

<style>
.d-home-products .d-grid { grid-template-columns: repeat(4, 1fr); }  
.d-home-products .quick-view-trigger { position: absolute; top: 15px; right: 15px; width: 40px; height: 40px; border-radius: 50%;
opacity: 0; border: none; cursor: pointer; transition: var(--transition); z-index: 5; }
.d-home-products .hoverhideshow:hover .quick-view-trigger { opacity: 1; }
.d-home-products .quick-view-trigger:hover { background-color: var(--blue-color); }

  /* Modal Styling using skcssl.css principles */
.sk-modal { position: fixed; top: 0; left: 0; width: 100%; height: 100%; z-index: 9999; display: flex; align-items: center; 
justify-content: center; }
.sk-modal-overlay { position: absolute; width: 100%; height: 100%; background: rgba(0,0,0,0.7); }
.sk-modal-content { position: relative; width: 90%; max-width: 900px; max-height: 80vh; overflow-y: auto; border-radius: 8px; 
transform: translateY(20px); transition: var(--transition); } 
.sk-modal.show .sk-modal-content { transform: translateY(0); }
.sk-modal-close { position: absolute; top: 15px; right: 20px; background: none; border: none; cursor: pointer; }
@media (max-width: 991px) {
.d-home-products .d-grid { grid-template-columns: repeat(2, 1fr); } #skQuickViewData { flex-direction: column; }
}
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
  const modal = document.getElementById('skQuickViewModal');
  const contentArea = document.getElementById('skQuickViewData');
  const closeBtn = modal.querySelector('.sk-modal-close');
  const overlay = modal.querySelector('.sk-modal-overlay');

  document.querySelectorAll('.quick-view-trigger').forEach(button => {
    button.addEventListener('click', async () => {
      const handle = button.getAttribute('data-product-handle');
      contentArea.innerHTML = '<div class="text-center w-100 skp-lg">Loading...</div>';
      modal.classList.remove('hide');
      modal.classList.add('show');

      try {
        const response = await fetch(`/products/${handle}.js`);
        const product = await response.json();
        
        contentArea.innerHTML = `
          <div class="col-6 col-sm-12">
            <img src="${product.featured_image}" class="w-100 bg-smoke skp-15">
          </div>
          <div class="col-6 col-sm-12">
            <h2 class="fs-h3 text-blue skfwb skmb-15">${product.title}</h2>
            <div class="fs-h5 text-black skmb-15">${(product.price / 100).toLocaleString('en-US', { style: 'currency', currency: 'USD' })}</div>
            <div class="fs-14 text-gray skmb-md">${product.description.substring(0, 200)}...</div>
            <a href="${product.url}" class="skbtn bg-black text-white skp-15 w-100 text-center">View Full Details</a>
          </div>
        `;
      } catch (error) {
        contentArea.innerHTML = '<div class="text-red">Error loading product.</div>';
      }
    });
  });

  const closeModal = () => {
    modal.classList.add('hide');
    modal.classList.remove('show');
  };

  closeBtn.addEventListener('click', closeModal);
  overlay.addEventListener('click', closeModal);
});
</script>

{% schema %}
{
  "name": "d-home-products",
    "class": "d-home-products",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Section Heading",
      "default": "Most Popular"
    }
  ],
  "blocks": [
    {
      "type": "product_block",
      "name": "Product",
      "settings": [
        { "type": "product", "id": "product", "label": "Select Product" },
        { "type": "text", "id": "sub_text", "label": "Compatibility Text", "default": "for Camera System" }
      ]
    }
  ],
  "presets": [
    { "name": "d-home-products", "blocks": [ { "type": "product_block" } ] }
  ]
}
{% endschema %}