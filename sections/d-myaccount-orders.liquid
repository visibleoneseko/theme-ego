{%- style -%}
  .sk-account-header {
    background: var(--white-color);
    border-radius: 12px;
    box-shadow: 0 4px 20px rgba(0,0,0,0.05);
  }
  .sk-order-card {
    background: var(--white-color);
    border: 1px solid #eee;
    border-radius: 10px;
    transition: var(--transition);
  }
  .sk-order-card:hover {
    border-color: var(--blue-color);
  }
  .sk-tab-btn {
    padding-bottom: 10px;
    border-bottom: 2px solid transparent;
    cursor: pointer;
    text-decoration: none;
  }
  .sk-tab-btn.active {
    border-bottom-color: var(--blue-color);
    color: var(--blue-color) !important;
  }
  .sk-status-badge {
    padding: 4px 12px;
    border-radius: 20px;
    font-size: 12px;
    font-weight: 700;
  }
  .avatar-circle {
    width: 60px;
    height: 60px;
    border-radius: 50%;
    background-color: var(--blue-color);
    color: white;
  }
{%- endstyle -%}

<section class="sk-account-section skpt-lg skpb-lg">
  <div class="container">
    
    <div class="sk-account-header skp-sm skmb-md d-flex justify-content-between align-items-center">
      <div class="d-flex align-items-center gap-20">
        <div class="avatar-circle flex-center">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
        </div>
        <div>
          <h2 class="fs-h4 skfwn skmb-0 text-black">{{ customer.name }}</h2>
          <p class="fs-14 text-gray skmb-0">Member since {{ customer.created_at | date: "%B %Y" }}</p>
        </div>
      </div>
      <a href="{{ routes.account_logout_url }}" class="text-red d-flex align-items-center gap-10 skfwb" style="text-decoration: none;">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path><polyline points="16 17 21 12 16 7"></polyline><line x1="21" y1="12" x2="9" y2="12"></line></svg>
        Logout
      </a>
    </div>

    <div class="sk-tabs d-flex gap-40 skmb-sm" style="border-bottom: 1px solid #eee;">
      <a href="/account" class="sk-tab-btn active fs-16 skfwb text-black d-flex align-items-center gap-10">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path><polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline><line x1="12" y1="22.08" x2="12" y2="12"></line></svg>
        Order History
      </a>
      <a href="/account/addresses" class="sk-tab-btn fs-16 skfwn text-gray d-flex align-items-center gap-10">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
        Account Details
      </a>
    </div>

    <div class="sk-orders-container">
      <h3 class="fs-h4 skfwb skmb-xs">{{ section.settings.title }}</h3>

      {% paginate customer.orders by 10 %}
        {% if customer.orders.size > 0 %}
          <div class="d-flex flex-column gap-20">
            {% for order in customer.orders %}
              <div class="sk-order-card skp-xs d-flex justify-content-between align-items-center">
                <div>
                  <h4 class="fs-16 skfwb skmb-0 text-black">{{ order.name }}</h4>
                  <p class="fs-14 text-gray skmb-0">Ordered on {{ order.created_at | date: "%B %d, %Y" }}</p>
                </div>
                
                <div class="text-right">
                  <div class="skmb-15">
                    {% if order.fulfillment_status_label == 'Fulfilled' %}
                      <span class="sk-status-badge bg-green text-white">Delivered</span>
                    {% else %}
                      <span class="sk-status-badge bg-blue text-white">{{ order.fulfillment_status_label }}</span>
                    {% endif %}
                  </div>
                  <p class="fs-h5 skfwb skmb-0 text-black">{{ order.total_price | money }}</p>
                </div>
              </div>
            {% endfor %}
          </div>
          
          {% if paginate.pages > 1 %}
            <div class="skmt-md text-center">
              {{ paginate | default_pagination }}
            </div>
          {% endif %}

        {% else %}
          <div class="skp-lg text-center bg-smoke" style="border-radius: 10px;">
            <p class="fs-16 text-gray">You haven't placed any orders yet.</p>
            <a href="{{ routes.all_products_collection_url }}" class="skbtn bg-blue text-white bd-blue">Start Shopping</a>
          </div>
        {% endif %}
      {% endpaginate %}
    </div>

  </div>
</section>

{% schema %}
{
  "name": "Order Detail Page",
  "tag": "section",
  "class": "section-order-history",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Section Title",
      "default": "Your Orders"
    }
  ],
  "presets": [
    {
      "name": "Order Detail Page"
    }
  ]
}
{% endschema %}