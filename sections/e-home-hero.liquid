<script>
(function() {
  var E_HOME_SECTION_ID = 'e-home-hero';
  var E_HOME_SECTION_SELECTOR = '#' + E_HOME_SECTION_ID;
  function initEHomeHero() {
    var root = document.querySelector(E_HOME_SECTION_SELECTOR + '[data-section-id="{{ section.id }}"]');
    if (!root || root.dataset.initialized === 'true') return;
    root.dataset.initialized = 'true';

    var slides = Array.prototype.slice.call(root.querySelectorAll('.hero-slide'));
    var dots = Array.prototype.slice.call(root.querySelectorAll('.hero-dot'));
    var heading = root.querySelector('h1');
    var subheading = root.querySelector('[data-hero-subheader]');
    var prev = root.querySelector('.hero-prev');
    var next = root.querySelector('.hero-next');
    var current = 0, timer = null, interval = Math.max(3000, Number(root.dataset.interval || 10000));
    if (!slides.length) return;
    function show(index) {
      current = (index + slides.length) % slides.length;
      slides.forEach(function(slide, i) {
        slide.classList.toggle('is-active', i === current);
        slide.setAttribute('aria-hidden', i === current ? 'false' : 'true');
      });
      dots.forEach(function(dot, i) {
        dot.classList.toggle('is-active', i === current);
        dot.setAttribute('aria-selected', i === current ? 'true' : 'false');
      });
      var active = slides[current];
      if (heading && active.dataset.header) heading.innerHTML = active.dataset.header.split('|').map(function(x){return x.replace(/[&<>"]/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c];});}).join('<br>');
      if (subheading) subheading.textContent = active.dataset.subheader || '';
    }
    function stop(){ if(timer){window.clearInterval(timer);timer=null;} }
    function start(){ stop(); if(root.dataset.autoplay !== 'false' && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) timer=window.setInterval(function(){show(current+1);}, interval); }
    dots.forEach(function(dot){dot.addEventListener('click',function(){show(Number(dot.dataset.slideIndex));start();});});
    if(prev) prev.addEventListener('click',function(){show(current-1);start();});
    if(next) next.addEventListener('click',function(){show(current+1);start();});
    root.addEventListener('mouseenter',stop); root.addEventListener('mouseleave',start);
    root.addEventListener('focusin',stop); root.addEventListener('focusout',start);
    root.__eHomeCleanup = stop;
    show(0); start();


    var revealTargets = root.querySelectorAll('.about-top, .about-stat-card, .news-head-row, .news-featured-card, .news-side-card, .solutions-head-row, .sol-tile, .rsvc-intro, .rsvc-carousel, .trust-ticker-header, .trust-ticker-logo');
    if ('IntersectionObserver' in window && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      var revealObserver = new IntersectionObserver(function(entries) {
        entries.forEach(function(entry) {
          if (entry.isIntersecting) { entry.target.classList.add('is-shown'); revealObserver.unobserve(entry.target); }
        });
      }, {threshold:0.12});
      revealTargets.forEach(function(el){el.classList.add('reveal-up');revealObserver.observe(el);});
      var oldCleanup = root.__eHomeCleanup;
      root.__eHomeCleanup = function(){revealObserver.disconnect();if(oldCleanup)oldCleanup();};
    } else {
      revealTargets.forEach(function(el){el.classList.add('is-shown');});
    }

  }
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initEHomeHero, { once: true });
  } else {
    initEHomeHero();
  }
  document.addEventListener('shopify:section:load', function(event) {
    if (event.target && event.target.querySelector && event.target.querySelector(E_HOME_SECTION_SELECTOR)) {
      var el = event.target.querySelector(E_HOME_SECTION_SELECTOR);
      if (el) el.dataset.initialized = 'false';
      initEHomeHero();
    }
  });
  document.addEventListener('shopify:section:unload', function(event) {
    if (event.target && event.target.querySelector) {
      var el = event.target.querySelector(E_HOME_SECTION_SELECTOR);
      if (el) {
        el.dataset.initialized = 'false';
        if (el.__eHomeCleanup) el.__eHomeCleanup();
      }
    }
  });
})();
</script>

{% schema %}
{
  "name": "Home hero",
  "settings": [
    {
      "type": "select",
      "id": "padding_top",
      "label": "Padding top",
      "default": "lg",
      "options": [
        {
          "value": "0",
          "label": "None"
        },
