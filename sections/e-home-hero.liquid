{%- comment -%}
  e-home-hero — Homepage hero carousel (Roctec)
  Crossfade slides + headline swap + timed progress dots.
  Custom vanilla JS (not Owl): the headline lives outside the slides and the
  dots show a timed fill, which Owl does not provide natively.
{%- endcomment -%}
{%- liquid
  assign interval = section.settings.interval | default: 10
  assign slide_count = section.blocks.size
-%}
<style>
#e-home-hero {
  position: relative;
  background: var(--color-surface-inverse);
  color: var(--color-text-inverse);
  overflow: hidden;
  display: flex;
  flex-direction: column;
  min-height: 100vh;
}
#e-home-hero .hero-slides {
  position: absolute;
  inset: 0;
  z-index: 0;
}
#e-home-hero .hero-slide {
  position: absolute;
  inset: 0;
  opacity: 0;
  transition: opacity 1200ms var(--ease-standard);
}
#e-home-hero .hero-slide.is-active {
  opacity: 1;
}
#e-home-hero .hero-slide img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center;
  filter: brightness(0.9) contrast(1.02);
}
#e-home-hero .hero-slide::after {
  content: '';
  position: absolute;
  inset: 0;
  background:
  linear-gradient(180deg,
  rgba(10, 10, 10, 0.12) 0%,
  rgba(10, 10, 10, 0.22) 55%,
  rgba(10, 10, 10, 0.34) 100%),
  rgba(10, 10, 10, 0.05);
}
#e-home-hero .hero-body {
  position: relative;
  z-index: 1;
  flex: 1;
  display: flex;
  align-items: flex-end;
  padding-bottom: 100px;
  padding-top: var(--hero-clear-display);
  padding-inline: var(--space-6);
  width: 100%;
  max-width: var(--e-container);
  margin-inline: auto;
}
#e-home-hero .hero-copy {
  max-width: 760px;
}
#e-home-hero .hero-copy h1 {
  font-size: var(--text-display);
  font-weight: 500;
  line-height: 1;
  margin-bottom: var(--space-6);
  text-wrap: balance;
  min-height: 2.2em;
  transition: opacity 400ms var(--ease-standard);
}
#e-home-hero .hero-copy h1.is-fading {
  opacity: 0;
}
#e-home-hero .hero-controls {
  display: flex;
  align-items: center;
  gap: var(--space-4);
}
#e-home-hero .hero-arrow {
  width: 44px;
  height: 44px;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: transparent;
  border: none;
  color: rgba(255, 255, 255, 0.7);
  cursor: pointer;
  transition: color var(--motion-fast) var(--ease-standard);
}
#e-home-hero .hero-arrow svg {
  width: 22px;
  height: 22px;
}
#e-home-hero .hero-arrow:hover {
  color: #fff;
}
#e-home-hero .hero-progress {
  display: flex;
  align-items: center;
  gap: 4px;
}
#e-home-hero .hero-dot {
  position: relative;
  width: 18px;
  height: 44px;
  background: transparent;
  border: none;
  padding: 0;
  cursor: pointer;
  transition: width var(--motion-base) var(--ease-standard);
}
#e-home-hero .hero-dot.is-active {
  width: 56px;
}
#e-home-hero .hero-dot::after {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  width: 10px;
  height: 10px;
  transform: translate(-50%, -50%);
  border-radius: 50%;
  border: none;
  background: rgba(214, 219, 224, 0.9);
  transition: all var(--motion-base) var(--ease-standard);
}
#e-home-hero .hero-dot:hover::after {
  background: #fff;
}
#e-home-hero .hero-dot.is-active::after {
  left: 0;
  width: 100%;
  height: 7px;
  transform: translateY(-50%);
  border: none;
  border-radius: 3px;
  background: rgba(214, 219, 224, 0.9);
}
#e-home-hero .hero-dot-fill {
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  height: 7px;
  width: 0%;
  background: var(--color-primary);
  border-radius: 3px;
  z-index: 1;
  opacity: 0;
}
#e-home-hero .hero-dot.is-active .hero-dot-fill {
  opacity: 1;
  animation: e-home-hero-dot-fill var(--hero-interval, 10s) linear forwards;
}
#e-home-hero .hero-controls.is-paused .hero-dot.is-active .hero-dot-fill {
  animation-play-state: paused;
}
@media (max-width: 1024px) {
  #e-home-hero {
    min-height: 100vh;
  }
  #e-home-hero .hero-body {
    padding-left: var(--space-6);
  }
  #e-home-hero .hero-copy {
    max-width: min(640px, calc(100vw - 380px));
  }
  #e-home-hero .hero-copy h1 {
    font-size: clamp(3.5rem, 2.2rem + 5.4vw, 5.75rem);
  }
}
@media (max-width: 767px) {
  #e-home-hero .hero-body {
    padding-inline: var(--space-6);
    padding-bottom: var(--space-16);
  }
  #e-home-hero {
    min-height: 100vh;
  }
  #e-home-hero .hero-copy h1 {
    font-size: clamp(3rem, 2rem + 5.2vw, 4.5rem);
  }
}
@media (max-width: 400px) {
  #e-home-hero .hero-body {
    padding-inline: var(--space-5);
  }
}
@media (max-width: 767px) {
  #e-home-hero .hero-copy {
    max-width: 100%;
  }
}
#e-home-hero .hero-slide .placeholder-svg {
  width: 100%;
  height: 100%;
  background: #1f2a24;
  fill: rgba(255, 255, 255, 0.25);
}
#e-home-hero .hero-controls[hidden] { display: none; }
@keyframes e-home-hero-dot-fill {
  from { width: 0%; }
  to { width: 100%; }
}
</style>

<section
  id="e-home-hero"
  class="e-home-hero hero skpt-{{ section.settings.padding_top }} skpb-{{ section.settings.padding_bottom }}"
  role="region"
  aria-roledescription="carousel"
  aria-label="{{ section.settings.aria_label | escape }}"
  data-autoplay="{{ section.settings.autoplay }}"
  data-interval="{{ interval | times: 1000 }}"
  style="--hero-interval: {{ interval }}s;"
>
  <div class="hero-slides" aria-hidden="true">
    {%- for block in section.blocks -%}
      {%- assign header_data = block.settings.heading | strip | escape | newline_to_br | strip_newlines | split: '<br />' | join: '|' -%}
      <div
        class="hero-slide{% if forloop.first %} is-active{% endif %}"
        id="hero-slide-{{ section.id }}-{{ forloop.index0 }}"
        data-slide="{{ forloop.index0 }}"
        data-header="{{ header_data | escape }}"
        {{ block.shopify_attributes }}
      >
        {%- if block.settings.image != blank -%}
          {%- if forloop.first -%}
            {{ block.settings.image | image_url: width: 3000 | image_tag: widths: '750, 1100, 1500, 1920, 2400, 3000', sizes: '100vw', loading: 'eager', fetchpriority: 'high', alt: block.settings.image.alt }}
          {%- else -%}
            {{ block.settings.image | image_url: width: 3000 | image_tag: widths: '750, 1100, 1500, 1920, 2400, 3000', sizes: '100vw', loading: 'lazy', alt: block.settings.image.alt }}
          {%- endif -%}
        {%- else -%}
          {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
        {%- endif -%}
      </div>
    {%- endfor -%}
  </div>

  <div class="container hero-body">
    <div class="hero-copy">
      {%- assign first_slide = section.blocks.first -%}
      <h1 id="hero-header-{{ section.id }}">
        {%- if first_slide -%}{{ first_slide.settings.heading | strip | escape | newline_to_br | replace: '|', '<br>' }}{%- endif -%}
      </h1>
      <div class="hero-controls"{% if slide_count < 2 %} hidden{% endif %}>
        <div class="hero-progress" role="tablist" aria-label="Banner navigation">
          {%- for block in section.blocks -%}
            <button
              class="hero-dot{% if forloop.first %} is-active{% endif %}"
              type="button"
              role="tab"
              aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
              aria-controls="hero-slide-{{ section.id }}-{{ forloop.index0 }}"
              aria-label="Banner {{ forloop.index }} of {{ slide_count }}"
              data-slide-index="{{ forloop.index0 }}"
            ><span class="hero-dot-fill"></span></button>
          {%- endfor -%}
        </div>
        <button class="hero-arrow" data-hero-prev type="button" aria-label="Previous banner">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 5l-7 7 7 7"></path></svg>
        </button>
        <button class="hero-arrow" data-hero-next type="button" aria-label="Next banner">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 5l7 7-7 7"></path></svg>
        </button>
      </div>
    </div>
  </div>
</section>

<script>
(function () {
  'use strict';

  if (!window.eHomeHero) {
    window.eHomeHero = (function () {
      var instances = {};
      var reducedMotion = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      function create(root) {
        var slides = [].slice.call(root.querySelectorAll('.hero-slide'));
        var dots = [].slice.call(root.querySelectorAll('.hero-dot'));
        var header = root.querySelector('.hero-copy h1');
        var controls = root.querySelector('.hero-controls');
        var prevBtn = root.querySelector('[data-hero-prev]');
        var nextBtn = root.querySelector('[data-hero-next]');
        var INTERVAL = parseInt(root.getAttribute('data-interval'), 10) || 10000;
        var playing = !reducedMotion && root.getAttribute('data-autoplay') === 'true';
        var current = 0;
        var timer = null;
        var headerSwapTimeout = null;
        var listeners = [];

        if (!slides.length) return { destroy: function () {}, goTo: function () {}, pause: function () {}, resume: function () {} };

        function on(el, type, fn) {
          if (!el) return;
          el.addEventListener(type, fn);
          listeners.push([el, type, fn]);
        }

        function setHeader(text) {
          if (!header || !text) return;
          var html = text.split('|').join('<br>');
          if (header.innerHTML === html) return;
          header.classList.add('is-fading');
          clearTimeout(headerSwapTimeout);
          headerSwapTimeout = setTimeout(function () {
            header.innerHTML = html; /* data-header is HTML-escaped in Liquid */
            header.classList.remove('is-fading');
          }, reducedMotion ? 0 : 250);
        }

        function restartFill(dot) {
          var fill = dot && dot.querySelector('.hero-dot-fill');
          if (fill) { fill.style.animation = 'none'; void fill.offsetWidth; fill.style.animation = ''; }
        }

        function goTo(i) {
          if (i === current && slides[i].classList.contains('is-active')) return;
          current = i;
          slides.forEach(function (s, idx) { s.classList.toggle('is-active', idx === i); });
          dots.forEach(function (d, idx) {
            d.setAttribute('aria-selected', idx === i ? 'true' : 'false');
            if (idx === i) {
              d.classList.remove('is-active');
              restartFill(d);
              d.classList.add('is-active');
            } else {
              d.classList.remove('is-active');
            }
          });
          setHeader(slides[i].getAttribute('data-header'));
        }

        function stop() {
          if (timer) { clearInterval(timer); timer = null; }
          if (controls) controls.classList.add('is-paused');
        }

        function start() {
          if (reducedMotion || !playing || slides.length < 2) return;
          stop();
          if (controls) controls.classList.remove('is-paused');
          timer = setInterval(function () { goTo((current + 1) % slides.length); }, INTERVAL);
        }

        function step(delta) {
          goTo((current + delta + slides.length) % slides.length);
          if (playing) start();
        }

        dots.forEach(function (d, i) {
          on(d, 'click', function () { goTo(i); if (playing) start(); });
        });
        on(prevBtn, 'click', function () { step(-1); });
        on(nextBtn, 'click', function () { step(1); });
        on(root, 'mouseenter', stop);
        on(root, 'mouseleave', function () { if (playing) start(); });
        on(root, 'focusin', stop);
        on(root, 'focusout', function () {
          if (playing && !root.contains(document.activeElement)) start();
        });

        /* Force-restart the first dot's fill animation on load */
        restartFill(dots[0]);
        if (playing) start();
        else if (controls) controls.classList.add('is-paused');

        return {
          goTo: goTo,
          pause: stop,
          resume: function () { if (playing) start(); },
          destroy: function () {
            stop();
            clearTimeout(headerSwapTimeout);
            listeners.forEach(function (l) { l[0].removeEventListener(l[1], l[2]); });
            listeners = [];
            root.removeAttribute('data-e-init');
          }
        };
      }

      function rootFor(sectionId) {
        var wrap = document.getElementById('shopify-section-' + sectionId);
        return wrap ? wrap.querySelector('.e-home-hero') : null;
      }

      function mount(sectionId) {
        var root = rootFor(sectionId);
        if (!root || root.hasAttribute('data-e-init')) return;
        root.setAttribute('data-e-init', '');
        instances[sectionId] = create(root);
      }

      function unmount(sectionId) {
        if (instances[sectionId]) { instances[sectionId].destroy(); delete instances[sectionId]; }
      }

      /* Theme Editor support */
      document.addEventListener('shopify:section:load', function (e) { mount(e.detail.sectionId); });
      document.addEventListener('shopify:section:unload', function (e) { unmount(e.detail.sectionId); });
      document.addEventListener('shopify:block:select', function (e) {
        var inst = instances[e.detail.sectionId];
        if (!inst) return;
        var slide = e.target.closest ? e.target.closest('.hero-slide') : null;
        if (!slide) return;
        inst.pause();
        inst.goTo(parseInt(slide.getAttribute('data-slide'), 10) || 0);
      });
      document.addEventListener('shopify:block:deselect', function (e) {
        var inst = instances[e.detail.sectionId];
        if (inst) inst.resume();
      });

      return { mount: mount, unmount: unmount };
    })();
  }

  window.eHomeHero.mount('{{ section.id }}');
})();
</script>

{% schema %}
{
  "name": "Home – Hero",
  "settings": [
    {
      "type": "select",
      "id": "padding_top",
      "label": "Padding Top",
      "options": [
        { "value": "0", "label": "0" },
        { "value": "xs", "label": "xs" },
        { "value": "sm", "label": "sm" },
        { "value": "md", "label": "md" },
        { "value": "lg", "label": "lg" },
        { "value": "xl", "label": "xl" }
      ],
      "default": "lg"
    },
    {
      "type": "select",
      "id": "padding_bottom",
      "label": "Padding Bottom",
      "options": [
        { "value": "0", "label": "0" },
        { "value": "xs", "label": "xs" },
        { "value": "sm", "label": "sm" },
        { "value": "md", "label": "md" },
        { "value": "lg", "label": "lg" },
        { "value": "xl", "label": "xl" }
      ],
      "default": "lg"
    },
    {
      "type": "paragraph",
      "content": "The mockup design is full-bleed: set both paddings to 0."
    },
    {
      "type": "text",
      "id": "aria_label",
      "label": "Carousel label (screen readers)",
      "default": "Roctec capability highlights"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Auto-rotate slides",
      "default": true
    },
    {
      "type": "range",
      "id": "interval",
      "label": "Time per slide",
      "min": 4,
      "max": 15,
      "step": 1,
      "unit": "s",
      "default": 10
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Background image",
          "info": "Recommended 2880 × 1800 px or larger."
        },
        {
          "type": "textarea",
          "id": "heading",
          "label": "Heading",
          "info": "Press Enter for a line break.",
          "default": "Precision System\nIntegration"
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Home – Hero",
      "settings": {
        "padding_top": "0",
        "padding_bottom": "0"
      },
      "blocks": [
        { "type": "slide", "settings": { "heading": "Precision System\nIntegration" } },
        { "type": "slide", "settings": { "heading": "Engineered for\nthe Rails" } },
        { "type": "slide", "settings": { "heading": "Built for\nSmart Cities" } }
      ]
    }
  ]
}
{% endschema %}
