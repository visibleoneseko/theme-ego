{%- comment -%}
  Roctec homepage — Hero section
  Source: Claude standalone homepage export.
  CSS and JS are isolated to #e-home-hero.
{%- endcomment -%}
<section id="e-home-hero" class="hero skpt-{{ section.settings.padding_top }} skpb-{{ section.settings.padding_bottom }}" data-section-id="{{ section.id }}" data-autoplay="{{ section.settings.autoplay }}" data-interval="{{ section.settings.interval | times: 1000 }}">

  <div aria-hidden="true" class="hero-slides">
    {% for block in section.blocks %}
      {% assign hero_image = block.settings.image %}
      <div class="hero-slide{% if forloop.first %} is-active{% endif %}" data-header="{{ block.settings.heading | escape }}" data-slide="{{ forloop.index0 }}" data-subheader="{{ block.settings.subheading | escape }}" id="e-home-hero-slide-{{ section.id }}-{{ forloop.index0 }}" {{ block.shopify_attributes }}>
        {% if hero_image != blank %}
          <img src="{{ hero_image | image_url: width: 2200 }}" alt="{{ block.settings.image_alt | default: hero_image.alt | escape }}" width="{{ hero_image.width }}" height="{{ hero_image.height }}" loading="{% if forloop.first %}eager{% else %}lazy{% endif %}">
        {% else %}
          <img src="{{ block.settings.fallback_asset | asset_url }}" alt="{{ block.settings.image_alt | escape }}" loading="{% if forloop.first %}eager{% else %}lazy{% endif %}">
        {% endif %}
      </div>
    {% endfor %}
  </div>
  <div class="container hero-body">
    <div class="hero-copy">
      <h1>{{ section.settings.heading | escape | newline_to_br }}</h1>
      <p class="hero-subheader" data-hero-subheader>{{ section.settings.subheading | escape }}</p>
      {% if section.settings.button_label != blank %}
        <div class="hero-actions"><a class="btn btn-secondary" href="{{ section.settings.button_link | default: routes.root_url }}">{{ section.settings.button_label | escape }}</a></div>
      {% endif %}
      <div class="hero-controls">
        <div aria-label="Banner navigation" class="hero-progress" role="tablist">
          {% for block in section.blocks %}
            <button aria-controls="e-home-hero-slide-{{ section.id }}-{{ forloop.index0 }}" aria-label="Banner {{ forloop.index }} of {{ section.blocks.size }}" aria-selected="{% if forloop.first %}true{% else %}false{% endif %}" class="hero-dot{% if forloop.first %} is-active{% endif %}" data-slide-index="{{ forloop.index0 }}" role="tab" type="button"><span class="hero-dot-fill"></span></button>
          {% endfor %}
        </div>
        <button class="hero-arrow hero-prev" type="button" aria-label="Previous banner"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 18l-6-6 6-6"/></svg></button>
        <button class="hero-arrow hero-next" type="button" aria-label="Next banner"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 18l6-6-6-6"/></svg></button>
      </div>
    </div>
  </div>

</section>

<style>
#e-home-hero {
--color-primary: #249E6B;
--color-primary-hover: #2E7D4E;
--color-action: #2E7D4E;
--color-action-hover: #25663F;
--color-success: #2E7D4E;
--color-warning: #F4A261;
--color-error: #E63946;
--color-info: #457B9D;
--color-text: #111111;
--color-text-strong: #1B1B1B;
--color-text-secondary: #4A4A4A;
--color-text-muted: #6E6E6E;
--color-text-placeholder: #8C8C8C;
--color-surface-subtle: #F1F1F1;
--color-surface-subtle-hover: #E7E7E7;
--color-focus-ring: rgba(46, 125, 78, 0.12);
--color-border-strong: #C9C9C9;
--color-surface: #FFFFFF;
--color-surface-muted: #F7F7F7;
--color-border: #E4E4E4;
--color-surface-brand: #124F35;
--color-surface-brand-light: #16603F;
--color-surface-brand-mid: var(--color-surface-brand);
--color-surface-brand-dark: #0C3826;
--color-surface-inverse: #0D120F;
--color-surface-inverse-raised: #131A16;
--color-border-inverse: rgba(255, 255, 255, 0.1);
--color-border-accent: #249E6B;
--color-text-inverse: #FFFFFF;
--color-text-inverse-muted: rgba(255, 255, 255, 0.62);
--font-en: "Roboto", Arial, sans-serif;
--font-base: "Roboto", Arial, sans-serif;
--font-weight-regular: 400;
--font-weight-medium: 500;
--font-weight-semibold: 600;
--font-weight-bold: 700;
--text-display: clamp(4rem, 2.5rem + 5.6vw, 7.25rem);
--text-h1: 3.25rem;
--text-h2: 2.5rem;
--text-h3: 1.75rem;
--text-h4: 1.5rem;
--text-h5: 1.25rem;
--text-h6: 1.0625rem;
--text-lg: 1.25rem;
--text-base: 1.125rem;
--text-sm: 1rem;
--text-xs: 0.875rem;
--text-eyebrow-sm: 0.75rem;
--space-1: 4px;
--space-2: 8px;
--space-3: 12px;
--space-4: 16px;
--space-5: 20px;
--space-6: 24px;
--space-7: 28px;
--space-8: 32px;
--space-10: 40px;
--space-12: 48px;
--space-16: 64px;
--space-24: 96px;
--head-gap: 40px;
--head-gap-lg: 64px;
--section-pad: 96px;
--section-pad-mobile: 64px;
--hero-clear-display: calc(var(--header-height) + var(--space-24) + var(--space-6));
--hero-clear-page: calc(var(--header-height) + var(--space-24) + var(--space-8));
--hero-clear-tight: calc(var(--header-height) + var(--space-16));
--container: 1280px;
--radius-sm: 4px;
--radius-md: 8px;
--radius-lg: 16px;
--radius-xl: 24px;
--radius-pill: 999px;
--touch-target: 44px;
--header-height: 104px;
--shadow-sm: 0 1px 3px rgba(17, 17, 17, 0.06);
--shadow-md: 0 4px 12px rgba(17, 17, 17, 0.08);
--motion-fast: 320ms;
--motion-base: 320ms;
--motion-medium: 320ms;
--motion-slow: 320ms;
--ease-standard: ease-out;
}
#e-home-hero .container {
max-width: var(--container);
  margin-inline: auto;
  padding-inline: var(--space-6);
}

#e-home-hero .btn {
display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: var(--space-2);
  min-height: var(--touch-target);
  padding: 0 var(--space-6);
  border-radius: var(--radius-sm);
  font-size: var(--text-base);
  font-weight: 700;
  border: 1px solid transparent;
  white-space: nowrap;
  position: relative;
  overflow: hidden;
  isolation: isolate;
  transition:
    background var(--motion-base) var(--ease-standard),
    border-color var(--motion-base) var(--ease-standard),
    color var(--motion-base) var(--ease-standard),
    box-shadow var(--motion-base) var(--ease-standard);
}

#e-home-hero .btn::before {
content: "";
  position: absolute;
  inset: 0;
  z-index: -1;
  background: currentColor;
  transform: scaleX(0);
  transform-origin: left center;
  transition: transform 300ms ease-out;
}

#e-home-hero .btn:hover::before {
transform: scaleX(1);
}

#e-home-hero .btn:hover {
color: inherit;
}

#e-home-hero .btn:active::before {
transition-duration: 80ms;
}

@media (prefers-reduced-motion: reduce) {
#e-home-hero .btn::before {
transition: none;
}
}

#e-home-hero .btn-secondary {
background: transparent;
  color: var(--color-action);
  border-color: var(--color-action);
  border-radius: var(--radius-pill);
}

#e-home-hero .btn-secondary::before {
background: var(--color-primary);
}

#e-home-hero .btn-secondary:hover {
color: #fff;
  border-color: var(--color-primary);
}

#e-home-hero .btn[disabled] {
opacity: 0.4; cursor: not-allowed;
}

#e-home-hero .btn[disabled]:hover::before {
transform: scaleX(0);
}

#e-home-hero .mobile-drawer .btn {
margin-top: var(--space-8); align-self: flex-start; width: auto; display: none;
}

#e-home-hero {
position: relative;
  background: var(--color-surface-inverse);
  color: var(--color-text-inverse);
  overflow: hidden;
  display: flex;
  flex-direction: column;
  min-height: 100vh;
}

#e-home-hero .hero-slides {
position: absolute; inset: 0; z-index: 0;
}

#e-home-hero .hero-slide {
position: absolute;
  inset: 0;
  opacity: 0;
  transition: opacity 1200ms var(--ease-standard);
}

#e-home-hero .hero-slide.is-active {
opacity: 1;
}

#e-home-hero .hero-slide svg {
width: 100%; height: 100%;
}

#e-home-hero .hero-slide img {
width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center;
  filter: brightness(0.9) contrast(1.02);
}

#e-home-hero .hero-slide::after {
content: "";
  position: absolute;
  inset: 0;
  background:
    linear-gradient(180deg,
      rgba(10, 10, 10, 0.12) 0%,
      rgba(10, 10, 10, 0.22) 55%,
      rgba(10, 10, 10, 0.34) 100%),
    rgba(10, 10, 10, 0.05);
}

@keyframes e-home-hero-hero-scan {
  0%, 100% { transform: translateY(0); opacity: 0.35; }
  50% { transform: translateY(148px); opacity: 1; }
}

@keyframes e-home-hero-hero-radar {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

#e-home-hero .hero-body {
position: relative;
  z-index: 1;
  flex: 1;
  display: flex;
  align-items: flex-end;
  padding-bottom: 100px;
  padding-top: var(--hero-clear-display);
  padding-inline: var(--space-6);
  width: 100%;
  max-width: var(--container);
  margin-inline: auto;
}

#e-home-hero .hero-copy {
max-width: 760px;
}

#e-home-hero .hero-copy h1 {
font-size: var(--text-display);
  font-weight: 500;
  line-height: 1;
  margin-bottom: var(--space-6);
  text-wrap: balance;
  min-height: 2.2em;
  transition: opacity 400ms var(--ease-standard);
}

#e-home-hero .hero-copy h1.is-fading {
opacity: 0;
}

#e-home-hero .hero-copy h1 em {
font-style: normal;
  color: #fff;
}

#e-home-hero .hero-subheader {
font-size: var(--text-lg);
  font-weight: 400;
  color: rgba(255, 255, 255, 0.88);
  max-width: 46ch;
  margin-bottom: var(--space-8);
  min-height: 3.2em;
  transition: opacity 400ms var(--ease-standard);
}

#e-home-hero .hero-subheader.is-fading {
opacity: 0;
}

#e-home-hero .hero-actions {
display: flex;
  flex-wrap: wrap;
  gap: var(--space-4);
  margin-bottom: var(--space-12);
}

#e-home-hero .hero-controls {
display: flex; align-items: center; gap: var(--space-4);
}

#e-home-hero .hero-arrow {
width: 44px;
  height: 44px;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: transparent;
  border: none;
  color: rgba(255, 255, 255, 0.7);
