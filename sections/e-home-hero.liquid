#e-home-hero .hero-dot::after {
content: "";
  position: absolute;
  top: 50%; left: 50%;
  width: 10px;
  height: 10px;
  transform: translate(-50%, -50%);
  border-radius: 50%;
  border: none;
  background: rgba(214, 219, 224, 0.9);
  transition: all var(--motion-base) var(--ease-standard);
}

#e-home-hero .hero-dot:hover::after {
background: #fff;
}

#e-home-hero .hero-dot.is-active::after {
left: 0;
  width: 100%;
  height: 7px;
  transform: translateY(-50%);
