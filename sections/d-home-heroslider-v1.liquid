<style>
  /* Section Specific Styles */
  .sk-hero-slider-wrapper {
    position: relative;
    width: 100%;
    overflow: hidden;
  }
  
  .sk-hero-slider .item {
    display: block;
    text-decoration: none;
    position: relative;
  }

  .photographer-credit {
    position: absolute;
    bottom: 20px;
    right: 4%; /* Matches container-lg padding logic */
    z-index: 10;
    pointer-events: none;
    text-shadow: 1px 1px 3px rgba(0,0,0,0.5);
  }

  /* Owl Fade Transition Override */
  .owl-carousel.owl-fade .owl-item {
    -webkit-transition: opacity {{ section.settings.speed }}ms ease-in-out;
    -moz-transition: opacity {{ section.settings.speed }}ms ease-in-out;
    -ms-transition: opacity {{ section.settings.speed }}ms ease-in-out;
    -o-transition: opacity {{ section.settings.speed }}ms ease-in-out;
    transition: opacity {{ section.settings.speed }}ms ease-in-out;
  }
.skblock {
    background-size: cover !important;
    background-position: center !important;
    background-repeat: no-repeat !important;
    width: 100%;
    height: 85vh;
    /* 
    max-height: 35vh;
    min-height: 205px; 
    aspect-ratio: var(--bannar-aspect-ratio);
    */
}
</style>
<section class="sk-hero-slider-wrapper" id="section-{{ section.id }}">
  <div class="owl-carousel owl-theme sk-hero-slider"
    data-timeout="{{ section.settings.autoplay_timeout }}" 
    data-speed="{{ section.settings.speed }}"
  >
    {% for block in section.blocks %}
      {%- if block.settings.image != blank -%}
        <a href="{{ block.settings.link }}" 
           class="skblock item d-flex align-items-end" 
           {{ block.shopify_attributes }}
           style="background-image: url('{{ block.settings.image | image_url: width: 2000 }}');">
          
          <div class="container-lg h-100 d-flex align-items-end justify-content-end skpb-sm">
            {% if block.settings.photographer != blank %}
              <div class="photographer-credit text-white fs-14 skfwn">
                Shot by <span class="skfwb">{{ block.settings.photographer | escape }}</span>
              </div>
            {% endif %}
          </div>
        </a>
      {%- endif -%}
    {% endfor %}
  </div>
</section>
{% schema %}
{
  "name": "d-home-heroslider",
  "tag": "section",
  "class": "d-home-heroslider",
  "settings": [
    {
      "type": "header",
      "content": "Slider Settings"
    },
    {
      "type": "range",
      "id": "autoplay_timeout",
      "min": 3000,
      "max": 8000,
      "step": 500,
      "unit": "ms",
      "label": "Auto-play Speed (Delay)",
      "default": 6000
    },
    {
      "type": "range",
      "id": "speed",
      "min": 500,
      "max": 2000,
      "step": 100,
      "unit": "ms",
      "label": "Transition Duration",
      "default": 1000
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Slider Image"
        },
        {
          "type": "text",
          "id": "photographer",
          "label": "Photographer Name",
          "default": "Florian Fischer"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Slide Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "d-home-heroslider",
      "blocks": [
        { "type": "slide" },
        { "type": "slide" }
      ]
    }
  ]
}
{% endschema %}