<section class="sk-product-features skpt-lg skpb-lg">
  <div class="container-lg">
    <div class="d-flex gap-40 align-items-center">
      
      {% comment %} --- Left Column: Key Features List --- {% endcomment %}
      <div class="col-4">
        <div class="features-content">
          <h2 class="fs-h3 skfwb text-blue skmb-sm">{{ section.settings.title }}</h2>
          <ul class="sk-feature-list skp-0 skm-0" style="list-style: none;">
            {%- for block in section.blocks -%}
              {%- if block.type == 'feature_item' -%}
                <li class="d-flex align-items-start skmb-15">
                  <span class="text-blue skmr-15" style="margin-top: 5px;">
                    <svg width="10" height="10" viewBox="0 0 10 10" fill="currentColor">
                      <circle cx="5" cy="5" r="3"/>
                    </svg>
                  </span>
                  <span class="fs-16 text-black sklh-n">{{ block.settings.feature_text }}</span>
                </li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        </div>
      </div>

      {% comment %} --- Right Column: Masonry Image Collage --- {% endcomment %}
      <div class="col-8">
        <div class="d-grid gap-20" style="grid-template-columns: repeat(2, 1fr); grid-auto-rows: minmax(150px, auto);">
          
          {%- assign image_blocks = section.blocks | where: "type", "gallery_image" -%}
          
          {%- for block in image_blocks -%}
            {%- capture grid_style -%}
              {% if forloop.index == 1 %} grid-column: span 1; grid-row: span 1; 
              {% elsif forloop.index == 2 %} grid-column: span 1; grid-row: span 2;
              {% elsif forloop.index == 3 %} grid-column: span 1; grid-row: span 2;
              {% else %} grid-column: span 1; grid-row: span 1;
              {% endif %}
            {%- endcapture -%}

            <div class="gallery-item bg-smoke" style="{{ grid_style }} border-radius: 15px; overflow: hidden;">
              <figure class="hover01 h-100">
                <img src="{{ block.settings.image | image_url: width: 800 }}" 
                     alt="{{ block.settings.image.alt | escape }}" 
                     class="w-100 h-100" 
                     style="object-fit: cover;">
              </figure>
            </div>
          {%- endfor -%}
          
        </div>
      </div>

    </div>
  </div>
</section>

<style>
.d-product-metadata .sk-feature-list li:last-child { margin-bottom: 0; }
.d-product-metadata .gallery-item { transition: var(--transition); }
  @media (max-width: 991px) {
.d-product-metadata .sk-product-features .d-flex { flex-direction: column; }
.d-product-metadata .sk-product-features .col-4, .sk-product-features .col-8 { max-width: 100%; flex: 1 1 100%; }
}
</style>

{% schema %}
{
  "name": "d-product-metadata",
  "class": "d-product-metadata",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Key Features"
    }
  ],
  "blocks": [
    {
      "type": "feature_item",
      "name": "Feature Point",
      "settings": [
        {
          "type": "text",
          "id": "feature_text",
          "label": "Feature Detail",
          "default": "7K FF Back-Illuminated CMOS Sensor"
        }
      ]
    },
    {
      "type": "gallery_image",
      "name": "Gallery Image",
      "limit": 4,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "d-product-metadata",
      "class": "d-product-metadata",
      "blocks": [
        { "type": "feature_item" },
        { "type": "feature_item" },
        { "type": "gallery_image" },
        { "type": "gallery_image" },
        { "type": "gallery_image" },
        { "type": "gallery_image" }
      ]
    }
  ]
}
{% endschema %}