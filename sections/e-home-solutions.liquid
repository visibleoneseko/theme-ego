{%- comment -%}
  e-home-solutions — "Systems Engineered for Scale" (Roctec homepage)
  Desktop: 3-column grid. ≤1024px: native scroll-snap carousel with
  prev/next buttons (mockup behaviour, kept as vanilla JS — no Owl).
{%- endcomment -%}
<style>
#e-home-solutions {
  background: #F7F7F7;
}
#e-home-solutions .solutions-whisker {
  letter-spacing: 0.14em;
  display: block;
  font-size: var(--text-base);
  font-weight: 600;
  text-transform: uppercase;
  color: var(--color-primary);
  margin-bottom: var(--space-2);
}
#e-home-solutions .solutions-head-row {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: var(--space-8);
}
#e-home-solutions .solutions-head-row {
  margin-bottom: var(--head-gap);
}
#e-home-solutions .solutions-head-row .section-head {
  margin-bottom: 0;
}
#e-home-solutions .section-head h2 {
  color: var(--color-text);
}
#e-home-solutions .section-head p {
  color: #3A3F3C;
}
#e-home-solutions .solutions-head-row .btn {
  flex-shrink: 0;
  margin-bottom: 0;
}
#e-home-solutions .sol-cluster-wrap {
  position: relative;
}
#e-home-solutions .sol-cluster {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: var(--space-4);
  align-items: stretch;
}
#e-home-solutions .sol-tile {
  position: relative;
  display: flex;
  flex-direction: column;
  border-radius: var(--radius-lg);
  border: 1px solid var(--color-border);
  background: #ffffff;
  color: var(--color-text);
  overflow: hidden;
  transition: transform var(--motion-base) var(--ease-standard),
  box-shadow var(--motion-base) var(--ease-standard);
}
#e-home-solutions .sol-tile:hover {
  transform: translateY(-4px);
  color: var(--color-text);
}
#e-home-solutions .sol-tile-media {
  padding: var(--space-2);
}
#e-home-solutions .sol-tile-body {
  display: flex;
  flex-direction: column;
  flex: 1;
  padding: var(--space-3) var(--space-6) var(--space-6);
}
#e-home-solutions .sol-tile-img {
  height: 260px;
  border-radius: var(--radius-md);
  overflow: hidden;
}
#e-home-solutions .sol-tile-img img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform var(--motion-slow) var(--ease-standard);
}
#e-home-solutions .sol-tile:hover .sol-tile-img img {
  transform: scale(1.04);
}
#e-home-solutions .sol-tile-eyebrow {
  letter-spacing: 0.14em;
  font-size: var(--text-base);
  font-weight: 600;
  text-transform: uppercase;
  color: #6B7280;
  margin-bottom: var(--space-2);
}
#e-home-solutions .sol-tile h3 {
  font-size: var(--text-h5);
  font-weight: 600;
  line-height: 1.3;
  color: var(--color-text);
  margin-top: 0;
  margin-bottom: var(--space-3);
  padding-bottom: var(--space-3);
  border-bottom: 1px solid rgba(13, 18, 15, 0.10);
}
#e-home-solutions .sol-tile p {
  font-size: var(--text-base);
  line-height: 1.55;
  color: #3A3F3C;
  margin-top: var(--space-2);
}
#e-home-solutions .sol-tile-cta {
  display: inline-flex;
  align-items: center;
  gap: var(--space-2);
  margin-top: auto;
  padding-top: var(--space-4);
  font-size: var(--text-base);
  font-weight: 600;
  color: var(--color-primary);
}
#e-home-solutions .sol-tile-cta svg {
  width: 18px;
  height: 18px;
  transition: transform var(--motion-base) var(--ease-standard);
}
#e-home-solutions .sol-tile:hover .sol-tile-cta {
  gap: var(--space-3);
}
#e-home-solutions .sol-tile:hover .sol-tile-cta svg {
  transform: translateX(5px);
}
#e-home-solutions .sol-tile:focus-visible {
  outline-color: var(--color-border);
}
@media (max-width: 900px) {
  #e-home-solutions .sol-cluster {
    grid-template-columns: minmax(0, 1fr);
  }
}
#e-home-solutions .sol-cluster-nav {
  display: none;
}
#e-home-solutions .sol-cluster-btn {
  width: var(--touch-target);
  height: var(--touch-target);
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: transparent;
  border: 1px solid var(--color-border);
  color: var(--color-text);
  transition: border-color var(--motion-base) var(--ease-standard),
  color var(--motion-base) var(--ease-standard),
  opacity var(--motion-base) var(--ease-standard);
}
#e-home-solutions .sol-cluster-btn:hover {
  border-color: var(--color-primary);
  color: var(--color-primary);
}
#e-home-solutions .sol-cluster-btn svg {
  width: 20px;
  height: 20px;
}
#e-home-solutions .sol-cluster-btn[disabled] {
  opacity: 0.3;
  cursor: not-allowed;
  border-color: var(--color-border);
  color: var(--color-text);
}
@media (max-width: 1024px) {
  #e-home-solutions .sol-cluster {
    grid-template-columns: none;
    display: flex;
    gap: var(--space-4);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    -ms-overflow-style: none;
    padding-top: var(--space-3);
    padding-bottom: var(--space-2);
  }
  #e-home-solutions .sol-cluster::-webkit-scrollbar {
    display: none;
  }
  #e-home-solutions .sol-cluster .sol-tile {
    flex: 0 0 78%;
    scroll-snap-align: start;
  }
  #e-home-solutions .sol-tile-body {
    flex-direction: column;
  }
  #e-home-solutions .sol-cluster-nav {
    display: flex;
    gap: var(--space-3);
    margin-top: var(--space-8);
    justify-content: center;
  }
}
@media (max-width: 767px) {
  #e-home-solutions .sol-cluster .sol-tile {
    flex: 0 0 86%;
  }
}
#e-home-solutions .section-head .solutions-whisker {
  margin-bottom: 4px;
}
#e-home-solutions .sol-tile-eyebrow {
  font-size: var(--text-eyebrow-sm);
}
@media (max-width: 767px) {
  #e-home-solutions .solutions-head-row {
    flex-wrap: wrap;
    gap: var(--space-5);
  }
  #e-home-solutions .solutions-head-row .section-head {
    margin-bottom: 0;
  }
  #e-home-solutions .solutions-head-row .btn {
    margin-left: 0;
    margin-bottom: 0;
  }
  #e-home-solutions .sol-cluster-wrap {
    margin-top: var(--space-8);
  }
}
#e-home-solutions .sol-tile-img .placeholder-svg {
  width: 100%;
  height: 100%;
  background: #e9ecea;
  fill: rgba(17, 17, 17, 0.25);
}
#e-home-solutions .sol-tile p + p { margin-top: 0; }
</style>

<section
  id="e-home-solutions"
  class="e-home-solutions solutions skpt-{{ section.settings.padding_top }} skpb-{{ section.settings.padding_bottom }}"
>
  <div class="container" data-sk-reveal>
    <div class="solutions-head-row">
      <div class="section-head">
        {%- if section.settings.eyebrow != blank -%}
          <span class="solutions-whisker">{{ section.settings.eyebrow | escape }}</span>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2>{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.subheading != blank -%}
          <p>{{ section.settings.subheading | escape }}</p>
        {%- endif -%}
      </div>
      {%- if section.settings.button_label != blank -%}
        <a class="btn btn-secondary" href="{{ section.settings.button_link | default: '#' }}">{{ section.settings.button_label | escape }}</a>
      {%- endif -%}
    </div>

    <div class="sol-cluster-wrap">
      <div class="sol-cluster">
        {%- for block in section.blocks -%}
          <a class="sol-tile" href="{{ block.settings.link | default: '#' }}" {{ block.shopify_attributes }}>
            <div class="sol-tile-media">
              <div class="sol-tile-img">
                {%- if block.settings.image != blank -%}
                  {%- assign img_alt = block.settings.image.alt | default: block.settings.title -%}
                  {{ block.settings.image | image_url: width: 1000 | image_tag: widths: '400, 600, 800, 1000', sizes: '(max-width: 767px) 86vw, (max-width: 1024px) 78vw, 410px', loading: 'lazy', alt: img_alt }}
                {%- else -%}
                  {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
                {%- endif -%}
              </div>
            </div>
            <div class="sol-tile-body">
              {%- if block.settings.eyebrow != blank -%}
                <span class="sol-tile-eyebrow">{{ block.settings.eyebrow | escape }}</span>
              {%- endif -%}
              {%- if block.settings.title != blank -%}
                <h3>{{ block.settings.title | escape }}</h3>
              {%- endif -%}
              {{ block.settings.details }}
              {%- if section.settings.tile_cta_label != blank -%}
                <span class="sol-tile-cta">{{ section.settings.tile_cta_label | escape }}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 5l7 7-7 7"></path></svg>
                </span>
              {%- endif -%}
            </div>
          </a>
        {%- endfor -%}
      </div>
      <div class="sol-cluster-nav" aria-hidden="false">
        <button class="sol-cluster-btn prev" type="button" aria-label="Previous solution">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5M11 5l-7 7 7 7"></path></svg>
        </button>
        <button class="sol-cluster-btn next" type="button" aria-label="Next solution">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 5l7 7-7 7"></path></svg>
        </button>
      </div>
    </div>
  </div>
</section>

<script>
(function () {
  'use strict';

  if (!window.eHomeSolutions) {
    window.eHomeSolutions = (function () {
      var instances = {};

      function create(root) {
        var track = root.querySelector('.sol-cluster');
        var prev = root.querySelector('.sol-cluster-btn.prev');
        var next = root.querySelector('.sol-cluster-btn.next');
        var listeners = [];
        if (!track || !prev || !next) return { destroy: function () {}, show: function () {} };

        function on(el, type, fn, opts) {
          el.addEventListener(type, fn, opts);
          listeners.push([el, type, fn, opts]);
        }

        function cardWidth() {
          var card = track.querySelector('.sol-tile');
          if (!card) return 0;
          var gap = parseFloat(getComputedStyle(track).gap) || 0;
          return card.offsetWidth + gap;
        }

        function update() {
          prev.disabled = track.scrollLeft <= 1;
          next.disabled = track.scrollLeft + track.offsetWidth >= track.scrollWidth - 1;
        }

        on(prev, 'click', function () { track.scrollBy({ left: -cardWidth(), behavior: 'smooth' }); });
        on(next, 'click', function () { track.scrollBy({ left: cardWidth(), behavior: 'smooth' }); });
        on(track, 'scroll', update, { passive: true });
        on(window, 'resize', update);
        update();

        return {
          show: function (tile) {
            if (track.scrollWidth <= track.offsetWidth) return; /* desktop grid */
            track.scrollTo({ left: tile.offsetLeft - track.offsetLeft, behavior: 'smooth' });
          },
          destroy: function () {
            listeners.forEach(function (l) { l[0].removeEventListener(l[1], l[2], l[3]); });
            listeners = [];
            root.removeAttribute('data-e-init');
          }
        };
      }

      function mount(sectionId) {
        var wrap = document.getElementById('shopify-section-' + sectionId);
        var root = wrap ? wrap.querySelector('.e-home-solutions') : null;
        if (!root || root.hasAttribute('data-e-init')) return;
        root.setAttribute('data-e-init', '');
        instances[sectionId] = create(root);
      }

      function unmount(sectionId) {
        if (instances[sectionId]) { instances[sectionId].destroy(); delete instances[sectionId]; }
      }

      document.addEventListener('shopify:section:load', function (e) { mount(e.detail.sectionId); });
      document.addEventListener('shopify:section:unload', function (e) { unmount(e.detail.sectionId); });
      document.addEventListener('shopify:block:select', function (e) {
        var inst = instances[e.detail.sectionId];
        var tile = e.target.closest ? e.target.closest('.sol-tile') : null;
        if (inst && tile) inst.show(tile);
      });

      return { mount: mount, unmount: unmount };
    })();
  }

  window.eHomeSolutions.mount('{{ section.id }}');
})();
</script>

