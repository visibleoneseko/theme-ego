{%- comment -%}
  Roctec homepage — Solutions section
  Source: Claude standalone homepage export.
  CSS and JS are isolated to #e-home-solutions.
{%- endcomment -%}
<section id="e-home-solutions" class="solutions skpt-{{ section.settings.padding_top }} skpb-{{ section.settings.padding_bottom }}" data-section-id="{{ section.id }}">

  <div class="container">
    <div class="solutions-head-row">
      <div class="section-head">
        <span class="solutions-whisker">{{ section.settings.eyebrow | escape }}</span>
        <h2>{{ section.settings.heading | escape }}</h2>
        <p>{{ section.settings.subheading | escape }}</p>
      </div>
      {% if section.settings.button_label != blank %}<a class="btn btn-secondary" href="{{ section.settings.button_link | default: routes.root_url }}">{{ section.settings.button_label | escape }}</a>{% endif %}
    </div>
    <div class="sol-cluster-wrap">
      <div class="sol-cluster">
        {% for block in section.blocks %}
          <a class="sol-tile" href="{{ block.settings.link | default: routes.root_url }}" {{ block.shopify_attributes }}>
            <div class="sol-tile-media"><div class="sol-tile-img">
              {% if block.settings.image != blank %}
                {{ block.settings.image | image_url: width: 900 | image_tag: loading: 'lazy', alt: block.settings.image_alt, widths: '360, 540, 720, 900' }}
              {% else %}
                <img src="{{ block.settings.fallback_asset | asset_url }}" alt="{{ block.settings.image_alt | escape }}" loading="lazy">
              {% endif %}
            </div></div>
            <div class="sol-tile-body">
              <span class="sol-tile-eyebrow">{{ block.settings.eyebrow | escape }}</span>
              <h3>{{ block.settings.title | escape }}</h3>
              <p><strong>Deployed in:</strong> {{ block.settings.deployed_in | escape }}<br><strong>Scale:</strong> {{ block.settings.scale | escape }}</p>
              <span class="sol-tile-cta">{{ block.settings.cta_label | escape }} <svg fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 5l7 7-7 7"/></svg></span>
            </div>
          </a>
        {% endfor %}
      </div>
    </div>
  </div>

</section>

