{%- comment -%}
  Roctec homepage — Partners section
  Source: Claude standalone homepage export.
  CSS and JS are isolated to #e-home-partners.
{%- endcomment -%}
<section id="e-home-partners" class="trust-ticker skpt-{{ section.settings.padding_top }} skpb-{{ section.settings.padding_bottom }}" data-section-id="{{ section.id }}">

  <div class="trust-ticker-inner">
    <div class="trust-ticker-header"><p class="trust-ticker-eyebrow">{{ section.settings.heading | escape }}</p></div>
    <div class="trust-ticker-carousel">
      <div class="trust-ticker-track">
        {% for block in section.blocks %}
          <div aria-label="{{ block.settings.name | escape }}" class="trust-ticker-logo" {{ block.shopify_attributes }}>
            {% if block.settings.image != blank %}
              {{ block.settings.image | image_url: width: 420 | image_tag: loading: 'lazy', alt: block.settings.name, widths: '120, 180, 240, 360, 420' }}
            {% else %}
              <img src="{{ block.settings.fallback_asset | asset_url }}" alt="{{ block.settings.name | escape }}" loading="lazy">
            {% endif %}
          </div>
        {% endfor %}
        {% for block in section.blocks %}
          <div aria-label="{{ block.settings.name | escape }}" class="trust-ticker-logo" aria-hidden="true">
            {% if block.settings.image != blank %}
              {{ block.settings.image | image_url: width: 420 | image_tag: loading: 'lazy', alt: '', widths: '120, 180, 240, 360, 420' }}
            {% else %}
              <img src="{{ block.settings.fallback_asset | asset_url }}" alt="" loading="lazy">
            {% endif %}
          </div>
        {% endfor %}
      </div>
    </div>
  </div>

</section>

<style>
#e-home-partners {
