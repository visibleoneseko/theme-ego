}
@keyframes e-home-partners-hero-scan {
  0%, 100% { transform: translateY(0); opacity: 0.35; }
  50% { transform: translateY(148px); opacity: 1; }
}

@keyframes e-home-partners-hero-radar {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

@keyframes e-home-partners-dot-fill {
  from { width: 0%; }
  to { width: 100%; }
}

@keyframes e-home-partners-scroll-bob {
  0%, 100% { cy: 10; opacity: 1; }
  50% { cy: 28; opacity: 0.3; }
}

#e-home-partners {
border-bottom: none;
  padding-block: 58px;
  background: #F7F7F7;
  overflow: hidden;
}

#e-home-partners .trust-ticker-inner {
display: flex;
  flex-direction: column;
  align-items: center;
  padding-block: 0;
  gap: var(--space-7);
}

#e-home-partners .trust-ticker-header {
width: 100%;
  max-width: 1280px;
  padding-inline: var(--space-12);
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
}

#e-home-partners .trust-ticker-eyebrow {
letter-spacing: 0.18em;
  font-size: var(--text-xs);
  font-weight: 600;
  text-transform: uppercase;
  color: var(--color-text-muted);
  white-space: nowrap;
  margin: 0;
}

#e-home-partners .trust-ticker-carousel {
width: 100%;
  overflow: hidden;
  mask-image: linear-gradient(90deg, transparent 0%, #000 8%, #000 92%, transparent 100%);
  -webkit-mask-image: linear-gradient(90deg, transparent 0%, #000 8%, #000 92%, transparent 100%);
}

#e-home-partners .trust-ticker-track {
display: flex;
  align-items: center;
  gap: 0;
  width: max-content;
  animation: e-home-partners-ticker-scroll 60s linear infinite;
}

#e-home-partners .trust-ticker-track:hover {
animation-play-state: paused;
}

#e-home-partners .trust-ticker-logo {
flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 96px;
  padding: 0 var(--space-8);
  opacity: 1;
}

#e-home-partners .trust-ticker-logo img {
height: 80px;
  width: auto;
  max-width: 180px;
  object-fit: contain;
  display: block;
  opacity: 1;
  transition: transform var(--motion-base) var(--ease-standard);
}

#e-home-partners .trust-ticker-logo:hover img {
transform: scale(1.06);
}

@keyframes e-home-partners-ticker-scroll {
  0% { transform: translateX(0); }
  100% { transform: translateX(-50%); }
}

@media (max-width: 767px) {
#e-home-partners {
padding-block: 32px;
}
#e-home-partners .trust-ticker-logo {
padding-inline: var(--space-5); height: 72px;
}
#e-home-partners .trust-ticker-inner {
padding-block: 0; gap: var(--space-6);
}
#e-home-partners .trust-ticker-header {
padding-inline: var(--space-6);
}
}

#e-home-partners img { display:block; max-width:100%; }
#e-home-partners .container { width:min(100% - 48px, 1280px); margin-inline:auto; }


#e-home-partners .reveal-up {
  opacity: 0;
  transform: translateY(40px);
  transition: opacity 500ms var(--ease-standard), transform 500ms var(--ease-standard);
}
#e-home-partners .reveal-up.is-shown {
  opacity: 1;
  transform: none;
}
</style>
<script>
(function() {
  var eHomeSelector = '#e-home-partners[data-section-id="{{ section.id }}"]';
  function initEHomePartners() {
    var root = document.querySelector(eHomeSelector);
    if (!root || root.dataset.initialized === 'true') return;
    root.dataset.initialized = 'true';

    var revealTargets = root.querySelectorAll('.about-top, .about-stat-card, .news-head-row, .news-featured-card, .news-side-card, .solutions-head-row, .sol-tile, .rsvc-intro, .rsvc-carousel, .trust-ticker-header, .trust-ticker-logo');
    if ('IntersectionObserver' in window && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      var revealObserver = new IntersectionObserver(function(entries) {
        entries.forEach(function(entry) {
          if (entry.isIntersecting) { entry.target.classList.add('is-shown'); revealObserver.unobserve(entry.target); }
        });
      }, {threshold:0.12});
      revealTargets.forEach(function(el){el.classList.add('reveal-up');revealObserver.observe(el);});
      var oldCleanup = root.__eHomeCleanup;
      root.__eHomeCleanup = function(){revealObserver.disconnect();if(oldCleanup)oldCleanup();};
    } else {
      revealTargets.forEach(function(el){el.classList.add('is-shown');});
    }

  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', initEHomePartners, {once:true});
  else initEHomePartners();
  document.addEventListener('shopify:section:load', function(e) {
    if (e.target && e.target.querySelector && e.target.querySelector('#e-home-partners')) {
      var node=e.target.querySelector('#e-home-partners'); node.dataset.initialized='false'; initEHomePartners();
    }
  });
  document.addEventListener('shopify:section:unload', function(e) {
    if(e.target && e.target.querySelector) {var node=e.target.querySelector('#e-home-partners');if(node && node.__eHomeCleanup)node.__eHomeCleanup();}
  });
})();
</script>


