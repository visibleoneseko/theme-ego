{%- comment -%}
  e-home-partners — "Our Partners" logo ticker (Roctec homepage)
  Pure CSS marquee: the logo set is printed twice and the track slides -50%
  for a seamless loop. The second set is hidden from screen readers.
  Not an Owl carousel by design (continuous strip, no slides).
{%- endcomment -%}
<style>
#e-home-partners {
  border-bottom: none;
  background: #F7F7F7;
  overflow: hidden;
}
#e-home-partners .trust-ticker-inner {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-block: 0;
  gap: var(--space-7);
}
#e-home-partners .trust-ticker-header {
  width: 100%;
  max-width: 1280px;
  padding-inline: var(--space-12);
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
}
#e-home-partners .trust-ticker-eyebrow {
  letter-spacing: 0.18em;
  font-size: var(--text-xs);
  font-weight: 600;
  text-transform: uppercase;
  color: var(--color-text-muted);
  white-space: nowrap;
  margin: 0;
}
#e-home-partners .trust-ticker-carousel {
  width: 100%;
  overflow: hidden;
  mask-image: linear-gradient(90deg, transparent 0%, #000 8%, #000 92%, transparent 100%);
  -webkit-mask-image: linear-gradient(90deg, transparent 0%, #000 8%, #000 92%, transparent 100%);
}
#e-home-partners .trust-ticker-track {
  display: flex;
  align-items: center;
  gap: 0;
  width: max-content;
  animation: e-home-partners-ticker var(--ticker-speed, 60s) linear infinite;
}
#e-home-partners .trust-ticker-track:hover {
  animation-play-state: paused;
}
#e-home-partners .trust-ticker-logo {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 96px;
  padding: 0 var(--space-8);
  opacity: 1;
}
#e-home-partners .trust-ticker-logo img {
  height: 80px;
  width: auto;
  max-width: 180px;
  object-fit: contain;
  display: block;
  opacity: 1;
  transition: transform var(--motion-base) var(--ease-standard);
}
#e-home-partners .trust-ticker-logo:hover img {
  transform: scale(1.06);
}
@media (max-width: 767px) {
  #e-home-partners .trust-ticker-logo {
    padding-inline: var(--space-5);
    height: 72px;
  }
  #e-home-partners .trust-ticker-inner {
    padding-block: 0;
    gap: var(--space-6);
  }
  #e-home-partners .trust-ticker-header {
    padding-inline: var(--space-6);
  }
}
@keyframes e-home-partners-ticker {
  0% { transform: translateX(0); }
  100% { transform: translateX(-50%); }
}
#e-home-partners .trust-ticker-logo .placeholder-svg {
  height: 80px;
  width: 140px;
  fill: rgba(17, 17, 17, 0.25);
}
</style>

<section
  id="e-home-partners"
  class="e-home-partners trust-ticker skpt-{{ section.settings.padding_top }} skpb-{{ section.settings.padding_bottom }}"
  aria-label="{{ section.settings.aria_label | escape }}"
  style="--ticker-speed: {{ section.settings.speed }}s;"
>
  <div class="trust-ticker-inner" data-sk-reveal>
    {%- if section.settings.eyebrow != blank -%}
      <div class="trust-ticker-header">
        <p class="trust-ticker-eyebrow">{{ section.settings.eyebrow | escape }}</p>
      </div>
    {%- endif -%}
    <div class="trust-ticker-carousel">
      <div class="trust-ticker-track">
        {%- for block in section.blocks -%}
          <div class="trust-ticker-logo" aria-label="{{ block.settings.name | escape }}" {{ block.shopify_attributes }}>
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: height: 160 | image_tag: loading: 'lazy', alt: block.settings.name }}
            {%- else -%}
              {{ 'logo' | placeholder_svg_tag: 'placeholder-svg' }}
            {%- endif -%}
          </div>
        {%- endfor -%}
        <!-- duplicate set for seamless loop -->
        {%- for block in section.blocks -%}
          <div class="trust-ticker-logo" aria-hidden="true">
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: height: 160 | image_tag: loading: 'lazy', alt: '' }}
            {%- else -%}
              {{ 'logo' | placeholder_svg_tag: 'placeholder-svg' }}
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Home – Partners",
  "settings": [
    {
      "type": "select",
      "id": "padding_top",
      "label": "Padding Top",
      "options": [
        { "value": "0", "label": "0" },
        { "value": "xs", "label": "xs" },
        { "value": "sm", "label": "sm" },
        { "value": "md", "label": "md" },
        { "value": "lg", "label": "lg" },
        { "value": "xl", "label": "xl" }
      ],
      "default": "lg"
    },
    {
      "type": "select",
      "id": "padding_bottom",
      "label": "Padding Bottom",
      "options": [
        { "value": "0", "label": "0" },
        { "value": "xs", "label": "xs" },
        { "value": "sm", "label": "sm" },
        { "value": "md", "label": "md" },
        { "value": "lg", "label": "lg" },
        { "value": "xl", "label": "xl" }
      ],
      "default": "lg"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Our Partners"
    },
    {
      "type": "text",
      "id": "aria_label",
      "label": "Section label (screen readers)",
      "default": "Business partners"
    },
    {
      "type": "range",
      "id": "speed",
      "label": "Time for one full loop",
      "min": 20,
      "max": 120,
      "step": 5,
      "unit": "s",
      "default": 60,
      "info": "Higher = slower. Hovering pauses the strip."
    }
  ],
  "blocks": [
    {
      "type": "logo",
      "name": "Partner logo",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Logo",
          "info": "Transparent PNG/SVG, about 160 px high."
        },
        {
          "type": "text",
          "id": "name",
          "label": "Partner name",
          "info": "Used as the image alt text.",
          "default": "Partner"
        }
      ]
    }
  ],
  "max_blocks": 40,
  "presets": [
    {
      "name": "Home – Partners",
      "blocks": [
        { "type": "logo", "settings": { "name": "Fortinet" } },
        { "type": "logo", "settings": { "name": "Aruba" } },
        { "type": "logo", "settings": { "name": "H3C" } },
        { "type": "logo", "settings": { "name": "Keewin" } },
        { "type": "logo", "settings": { "name": "Dahua Technology" } },
        { "type": "logo", "settings": { "name": "RSTC" } }
      ]
    }
  ]
}
{% endschema %}
