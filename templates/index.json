    "about": {
      "type": "e-home-about",
      "settings": {
        "padding_top": "xl",
        "padding_bottom": "xl",
        "heading": "Four Decades of Engineering Excellence",
        "text": "<p>Founded in 1987, Roctec Technology Limited (鷹達科技有限公司) is a well-established system integrator and solution developer experienced in large-scale data communications, multimedia display and network integration projects across Hong Kong, Thailand, Singapore and other Asian countries.</p>",
        "button_label": "Our Full Story",
        "button_link": "/pages/about-us"
      },
      "blocks": {
        "stat_1": {
          "type": "stat_counter",
          "settings": {
            "number": 38,
            "suffix": "+",
            "label": "Years of Project Heritage"
          }
        },
        "stat_2": {
          "type": "stat_counter",
          "settings": {
            "number": 120,
            "suffix": "+",
            "label": "Infrastructure Projects"
          }
        },
        "stat_3": {
          "type": "stat_pair",
          "settings": {
            "number_1": 24,
            "separator": "/",
            "number_2": 7,
            "label": "Operations Support"
          }
        },
        "stat_4": {
          "type": "stat_text",
          "settings": {
            "text": "ISO",
            "label": "Quality Aligned"
          }
        }
      },
      "block_order": [
        "stat_1",
        "stat_2",
        "stat_3",
        "stat_4"
      ]
    },
    "news": {
      "type": "e-home-news",
      "settings": {
        "padding_top": "xl",
        "padding_bottom": "xl",
        "eyebrow": "NEWS & AUTHORITY",
        "heading": "Recent Milestones, Ongoing Recognition",
        "subtitle": "Industry recognition and new partnerships, updated as Roctec's work continues to grow.",
        "button_label": "View All News",
        "button_link": "/blogs/news",
        "blog": "news",
        "side_count": 3
      }
    },
    "solutions": {
      "type": "e-home-solutions",
      "settings": {
        "padding_top": "xl",
        "padding_bottom": "xl",
        "eyebrow": "ROCTEC SOLUTIONS",
        "heading": "Systems Engineered for Scale",
        "subheading": "Mission-critical platforms for HK networks.",
        "button_label": "View All Solutions",
        "button_link": "/pages/solutions",
        "tile_cta_label": "Learn more"
      },
      "blocks": {
        "tile_1": {
          "type": "tile",
          "settings": {
            "eyebrow": "NETWORK SECURITY",
            "title": "Network Security Infrastructure & Connectivity Gateways",
            "details": "<p><strong>Deployed in:</strong> Lingnan University, Hong Kong</p><p><strong>Scale:</strong> Campus-wide wireless &amp; firewall infrastructure</p>",
            "link": "/pages/solutions"
          }
        },
        "tile_2": {
          "type": "tile",
          "settings": {
            "eyebrow": "PASSENGER SYSTEMS",
            "title": "Passenger Information Display System (PIDS)",
            "details": "<p><strong>Deployed in:</strong> Hong Kong &amp; Singapore</p><p><strong>Scale:</strong> 1,000+ units across MTR &amp; LRT networks</p>",
            "link": "/pages/solutions"
          }
        },
        "tile_3": {
          "type": "tile",
          "settings": {
            "eyebrow": "RAIL SIMULATION",
            "title": "AI-Aided Driving Simulation System",
            "details": "<p><strong>Deployed in:</strong> Hong Kong</p><p><strong>Scale:</strong> All 10 HK train types simulated</p>",
            "link": "/pages/solutions"
          }
        }
      },
      "block_order": [
        "tile_1",
        "tile_2",
        "tile_3"
      ]
    },
    "services": {
      "type": "e-home-services",
      "settings": {
        "padding_top": "xl",
        "padding_bottom": "xl",
        "eyebrow": "Services",
        "heading": "Full-Lifecycle Engineering Services",
        "text": "End-to-end design, deployment, and security for mission-critical infrastructure.",
        "button_label": "Explore Our Services",
        "button_link": "/pages/services"
      },
      "blocks": {
        "service_1": {
          "type": "service",
          "settings": {
            "title": "System Design & Consultancy",
            "text": "Architecting resilient network and security systems, evaluating infrastructure configuration to optimize performance across every deployment."
          }
        },
        "service_2": {
          "type": "service",
          "settings": {
            "title": "Implementation & Deployment",
            "text": "Turnkey installation and network deployment customized to each client's needs, delivered on schedule by our engineering team."
          }
        },
        "service_3": {
          "type": "service",
          "settings": {
            "title": "24/7 Operations Support",
            "text": "Local technical team available around the clock, providing rapid-response monitoring that keeps mission-critical infrastructure online and performing."
          }
        },
        "service_4": {
          "type": "service",
          "settings": {
            "title": "Managed Infrastructure Security",
            "text": "Continuous firewall protection and connection health assessments that safeguard data networks end to end, mitigating risk daily."
          }
        }
      },
      "block_order": [
        "service_1",
        "service_2",
        "service_3",
